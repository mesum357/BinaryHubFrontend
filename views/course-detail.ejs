<%
  pageTitle = course.name;
  pageDescription = course.shortDescription || course.introduction || (course.name + ' course at Binary Hub');
  activeNav = 'courses';
  extraCss = '<link rel="stylesheet" href="/css/pages.css">';
%>
<%- include('partials/head') %>
<%- include('partials/nav') %>

<main>
  <header class="bh-page-hero">
    <div class="bh-container">
      <p class="bh-eyebrow"><a href="/courses" style="color:inherit;text-decoration:none;">Courses</a> / <%= course.name %></p>
      <h1><%= course.name %></h1>
      <p class="bh-lead">Duration: <%= course.duration || 'Flexible' %> · Fee: PKR <%= course.feeAmount != null ? course.feeAmount : 5000 %></p>
    </div>
  </header>

  <section class="bh-section" style="padding-top:0;">
    <div class="bh-container">
      <% if (typeof successMsg !== 'undefined' && successMsg && successMsg.length) { %>
      <div class="bh-flash bh-flash-ok"><%= successMsg[0] %></div>
      <% } %>
      <% if (typeof errorMsg !== 'undefined' && errorMsg && errorMsg.length) { %>
      <div class="bh-flash bh-flash-err"><%= errorMsg[0] %></div>
      <% } %>

      <div class="detail-layout">
        <div>
          <% if (course.image) { %>
          <div class="page-card" style="margin-bottom:1.5rem;">
            <div class="page-card-media" style="aspect-ratio:21/9;">
              <img src="<%= course.image %>" alt="<%= course.name %>">
            </div>
          </div>
          <% } %>
          <div class="detail-panel bh-reveal" style="margin-bottom:1.25rem;">
            <h2>About this course</h2>
            <p style="color:var(--bh-ink-soft);line-height:1.7;"><%= course.introduction || course.shortDescription || '' %></p>
          </div>
          <% (course.outline || []).forEach(function(m) { %>
          <div class="detail-panel bh-reveal" style="margin-bottom:1rem;">
            <h2><%= m.title %></h2>
            <% if (m.items && m.items.length) { %>
            <ul class="module-list">
              <% m.items.forEach(function(it) { %><li><%= it %></li><% }); %>
            </ul>
            <% } %>
          </div>
          <% }); %>
        </div>
        <aside class="detail-panel bh-reveal">
          <h2>At a glance</h2>
          <ul class="detail-list">
            <li><span>Duration</span><span><%= course.duration || 'Flexible' %></span></li>
            <li><span>Fee</span><span>PKR <%= course.feeAmount != null ? course.feeAmount : 5000 %></span></li>
            <% if (course.category) { %><li><span>Category</span><span><%= course.category %></span></li><% } %>
          </ul>
          <div style="margin-top:1.5rem;">
            <a href="/courses" class="bh-btn bh-btn-primary" style="width:100%;justify-content:center;">Browse courses</a>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <%- include('partials/footer') %>
</main>
<%- include('partials/scripts') %>
