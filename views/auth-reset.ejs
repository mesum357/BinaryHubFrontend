<%- include('partials/auth-layout-start') %>
<div class="auth-shell">
    <div class="auth-card">
        <h1>New password</h1>
        <p class="auth-lead">Choose a strong password for your Binary Hub account.</p>
        <% if (typeof errorMsg !== 'undefined' && errorMsg && errorMsg.length) { %>
        <div class="auth-flash err"><%= errorMsg[0] %></div>
        <% } %>
        <form class="auth-form" method="post" action="/auth/reset-password">
            <input type="hidden" name="token" value="<%= resetToken %>">
            <label for="password">New password</label>
            <input type="password" id="password" name="password" required autocomplete="new-password" minlength="8" placeholder="At least 8 characters">
            <label for="passwordConfirm">Confirm new password</label>
            <input type="password" id="passwordConfirm" name="passwordConfirm" required autocomplete="new-password" minlength="8">
            <button type="submit" class="btn-primary">Update password</button>
        </form>
        <p class="auth-footer"><a href="/auth/login">Sign in</a></p>
    </div>
</div>
<%- include('partials/auth-layout-end') %>
