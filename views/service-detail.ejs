                <div class="cta-bar">
                    <p>Ready to scope a project or train your team on this stack?</p>
                    <div class="btn-row">
                        <a href="/courses" class="btn btn-primary"><i class="fas fa-graduation-cap"></i> View related courses</a>
                        <a href="/services" class="btn btn-ghost"><i class="fas fa-arrow-left"></i> All services</a>
                    </div>
                </div>
            </div>
        </section>
    </div>

    <footer>
        <div class="container-wide">
            <div class="footer-grid">
                <div class="footer-col">
                    <a href="/"><img src="/images/logo-binary.png" alt="" style="height:48px;margin-bottom:12px;"></a>
                    <p style="color:#9ca3af;font-size:0.9rem;">Binary Hub — digital skills and creative services.</p>
                </div>
                <div class="footer-col">
                    <h4>Explore</h4>
                    <ul>
                        <li><a href="/services">Services</a></li>
                        <li><a href="/courses">Courses</a></li>
                        <li><a href="/internships">Internships</a></li>
                    </ul>
                </div>
                <div class="footer-col">
                    <h4>Company</h4>
                    <ul>
                        <li><a href="/team">Our Team</a></li>
                        <li><a href="/our-mission">Our Mission</a></li>
                        <li><a href="/impact">Our Impact</a></li>
                        <li><a href="/branches">Our Branches</a></li>
                        <li><a href="/events">Events</a></li>
                        <li><a href="/visits">Visits</a></li>
                    </ul>
                </div>
