        <a href="/services" class="btn btn-primary" style="color:white;">Back to services</a>
    </div>

    <div id="content-root">
        <header class="detail-hero">
            <div class="container detail-hero-inner">
                <div class="breadcrumb"><a href="/services">Services</a> &nbsp;/&nbsp; <span id="bc-title">—</span></div>
                <div class="detail-icon-wrap" id="hero-icon"><i class="fas fa-layer-group"></i></div>
