<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Service | Binary Hub</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@300;400;500;600;700&family=Space+Grotesk:wght@500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --orange: #ee702b;
            --blue: #005696;
            --dark: #0a1628;
            --white: #ffffff;
            --gray-light: #f5f7fa;
            --gray-text: #6b7280;
            --gradient: linear-gradient(135deg, #ee702b, #005696);
        }
        * { margin: 0; padding: 0; box-sizing: border-box; outline: none; cursor: none; }
        html { scroll-behavior: smooth; }
        body { font-family: 'Inter', sans-serif; background: var(--white); color: var(--dark); overflow-x: hidden; }
        h1, h2, h3, .bebas { font-family: 'Bebas Neue', cursive; }
        .noise-overlay {
            position: fixed; inset: 0; pointer-events: none; z-index: 9999; opacity: 0.03;
            background: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
        }
        #cursor-glow {
            position: fixed; width: 300px; height: 300px;
            background: radial-gradient(circle, rgba(238,112,43,0.12) 0%, transparent 70%);
            border-radius: 50%; pointer-events: none; z-index: 9998; transform: translate(-50%, -50%);
        }
        #cursor-dot {
            position: fixed; width: 8px; height: 8px; background: var(--orange); border-radius: 50%;
            pointer-events: none; z-index: 10005; transform: translate(-50%, -50%);
        }
        #scroll-progress { position: fixed; top: 0; left: 0; height: 3px; background: var(--gradient); z-index: 10001; width: 0%; }
        .container { max-width: 900px; margin: 0 auto; padding: 0 25px; }
        .container-wide { max-width: 1100px; margin: 0 auto; padding: 0 25px; }
        .gradient-text {
            background: var(--gradient); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
        }

        nav {
            position: fixed; top: 0; width: 100%; padding: 20px 10%; display: flex; justify-content: space-between; align-items: center;
            z-index: 10000; transition: 0.5s;
        }
        nav.scrolled { background: rgba(5, 11, 22, 0.9); backdrop-filter: blur(20px); padding: 15px 10%; border-bottom: 1px solid rgba(255,255,255,0.05); }
        .logo { display: flex; align-items: center; height: 50px; }
        .logo img { height: 100%; width: auto; }
        nav.scrolled .logo { height: 40px; }
        .nav-links { display: flex; gap: 28px; list-style: none; }
        .nav-links a {
            text-decoration: none; color: white; font-weight: 600; font-size: 0.88rem; text-transform: uppercase;
            letter-spacing: 1px; position: relative; padding-bottom: 4px;
        }
        nav.scrolled .nav-links a { opacity: 0.88; }
        .nav-links a:hover { opacity: 1; }
        .nav-links a::after {
            content: ''; position: absolute; bottom: 0; left: 0; width: 0; height: 2px; background: var(--orange); transition: 0.3s;
        }
        .nav-links a:hover::after { width: 100%; }
        .dropdown { position: relative; }
        .dropdown-menu {
            position: absolute; top: 38px; left: 0; background: rgba(255,255,255,0.97); min-width: 200px; border-radius: 12px;
            padding: 12px 0; box-shadow: 0 12px 40px rgba(0,0,0,0.12); opacity: 0; visibility: hidden; transform: translateY(12px); transition: 0.35s;
        }
        .dropdown:hover .dropdown-menu { opacity: 1; visibility: visible; transform: translateY(0); }
        .dropdown-menu a { display: block; padding: 10px 20px; font-size: 0.85rem; color: #0a1628 !important; }
        .dropdown-menu a::after { display: none; }
        .dropdown-menu a:hover { background: var(--gray-light); color: var(--orange) !important; }
        .mobile-toggle { display: none; color: white; font-size: 1.5rem; z-index: 10002; }

        .detail-hero {
            min-height: 52vh; background: #050b16; padding: 130px 0 70px; position: relative; overflow: hidden;
        }
        .detail-hero::before {
            content: ''; position: absolute; inset: 0;
            background: radial-gradient(ellipse 70% 60% at 30% 20%, rgba(238,112,43,0.2), transparent),
                radial-gradient(ellipse 50% 50% at 80% 80%, rgba(0,86,150,0.25), transparent);
        }
        .detail-hero-inner { position: relative; z-index: 2; text-align: center; max-width: 800px; margin: 0 auto; }
        .breadcrumb {
            font-size: 0.75rem; letter-spacing: 2px; text-transform: uppercase; color: #94a3b8; margin-bottom: 16px;
        }
        .breadcrumb a { color: var(--orange); text-decoration: none; }
        .breadcrumb a:hover { text-decoration: underline; }
        .detail-hero h1 { font-size: clamp(2.8rem, 6vw, 4.5rem); color: white; line-height: 1; margin-bottom: 16px; }
        .detail-tagline { color: #cbd5e1; font-size: 1.15rem; max-width: 560px; margin: 0 auto; }
        .detail-icon-wrap {
            width: 88px; height: 88px; margin: 0 auto 24px; border-radius: 24px;
            background: linear-gradient(145deg, rgba(238,112,43,0.25), rgba(0,86,150,0.2));
            border: 1px solid rgba(255,255,255,0.12); display: flex; align-items: center; justify-content: center;
            font-size: 2rem; color: var(--orange);
        }

        .intro-block { padding: 80px 0 40px; }
        .intro-block h2 { font-size: 2.2rem; margin-bottom: 20px; color: var(--dark); }
        .intro-block p { color: var(--gray-text); font-size: 1.05rem; margin-bottom: 16px; line-height: 1.75; }

        .outline-section { padding: 20px 0 100px; }
        .outline-section h2 { font-size: 2.5rem; margin-bottom: 8px; text-align: center; }
        .outline-sub { text-align: center; color: var(--gray-text); margin-bottom: 48px; font-size: 1rem; }

        .module {
            background: var(--white); border: 1px solid #e5e7eb; border-radius: 20px; margin-bottom: 16px; overflow: hidden;
            transition: box-shadow 0.3s, border-color 0.3s;
        }
        .module:hover { box-shadow: 0 16px 48px rgba(0,86,150,0.08); border-color: rgba(238,112,43,0.35); }
        .module-head {
            display: flex; align-items: center; gap: 16px; padding: 22px 24px; cursor: pointer;
            background: linear-gradient(90deg, rgba(245,247,250,0.8), rgba(255,255,255,0.95));
        }
        .module-num {
            font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: 0.85rem;
            color: var(--orange); min-width: 36px; height: 36px; border-radius: 10px;
            background: rgba(238,112,43,0.12); display: flex; align-items: center; justify-content: center;
        }
        .module-head h3 { flex: 1; font-size: 1.25rem; letter-spacing: 0.5px; text-align: left; font-family: 'Space Grotesk', sans-serif; font-weight: 600; }
        .module-toggle { color: var(--gray-text); transition: transform 0.35s; }
        .module.open .module-toggle { transform: rotate(180deg); color: var(--orange); }
        .module-body { max-height: 0; overflow: hidden; transition: max-height 0.45s ease; }
        .module.open .module-body { max-height: 800px; }
        .module-list { padding: 0 24px 24px 88px; list-style: none; }
        .module-list li {
            position: relative; padding: 10px 0 10px 22px; color: #4b5563; font-size: 0.95rem; border-bottom: 1px solid #f3f4f6;
        }
        .module-list li:last-child { border-bottom: none; }
        .module-list li::before {
            content: ''; position: absolute; left: 0; top: 18px; width: 8px; height: 8px; border-radius: 50%;
            background: var(--gradient);
        }

        .cta-bar {
            margin: 60px auto 0; max-width: 700px; padding: 32px 36px; border-radius: 24px;
            background: linear-gradient(135deg, #0a1628, #0f2847); color: white; text-align: center;
            box-shadow: 0 24px 60px rgba(0,0,0,0.15);
        }
        .cta-bar p { margin-bottom: 20px; opacity: 0.9; }
        .btn-row { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; }
        .btn {
            display: inline-flex; align-items: center; gap: 8px; padding: 14px 28px; border-radius: 999px;
            font-weight: 600; font-size: 0.9rem; text-decoration: none; transition: 0.3s;
        }
        .btn-primary { background: var(--orange); color: white; }
        .btn-primary:hover { filter: brightness(1.08); transform: translateY(-2px); }
        .btn-ghost { border: 1px solid rgba(255,255,255,0.3); color: white; }
        .btn-ghost:hover { background: rgba(255,255,255,0.08); }

        #not-found { display: none; padding: 140px 24px 80px; text-align: center; }
        #not-found.visible { display: block; }
        #content-root { display: none; }
        #content-root.visible { display: block; }

        footer {
            background: var(--dark); color: var(--white); padding: 60px 0 24px;
        }
        .footer-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 32px; margin-bottom: 40px; }
        .footer-col h4 { font-family: 'Space Grotesk', sans-serif; color: var(--orange); margin-bottom: 16px; font-size: 1rem; }
        .footer-col ul { list-style: none; }
        .footer-col a { color: #9ca3af; text-decoration: none; font-size: 0.9rem; }
        .footer-col a:hover { color: white; }
        .footer-bottom { border-top: 1px solid rgba(255,255,255,0.06); padding-top: 24px; font-size: 0.8rem; color: #6b7280; display: flex; justify-content: space-between; flex-wrap: wrap; gap: 10px; }
        @media (max-width: 900px) { .footer-grid { grid-template-columns: repeat(2, 1fr); } }
        @media (max-width: 768px) {
            .nav-links { display: none; position: fixed; top: 0; right: 0; width: 85%; max-width: 300px; height: 100vh;
                background: #050b16; flex-direction: column; padding: 96px 24px; gap: 0; }
            .nav-links.active { display: flex; }
            .nav-links li { padding: 14px 0; border-bottom: 1px solid rgba(255,255,255,0.06); width: 100%; }
            .dropdown-menu { position: static; opacity: 1; visibility: visible; transform: none; box-shadow: none; background: transparent; padding-left: 12px; }
            .dropdown-menu a { color: #cbd5e1 !important; }
            .mobile-toggle { display: block; }
            .module-list { padding-left: 24px; }
        }

        #loader {
            position: fixed; inset: 0; background: #050b16; z-index: 10002; display: flex; align-items: center; justify-content: center;
            transition: opacity 0.8s;
        }
        .loader-logo { width: 180px; animation: pop 0.9s ease forwards; }
        .loader-logo img { width: 100%; }
        @keyframes pop { from { opacity: 0; transform: scale(0.85); } to { opacity: 1; transform: scale(1); } }
    </style>
</head>
<body>
    <div class="noise-overlay"></div>
    <div id="cursor-glow"></div>
    <div id="cursor-dot"></div>
    <div id="scroll-progress"></div>
    <div id="loader"><div class="loader-logo"><img src="/images/logo-binary.png" alt=""></div></div>

    <nav id="navbar">
        <a href="/" class="logo"><img src="/images/logo-binary.png" alt="Binary Hub"></a>
        <ul class="nav-links">
            <li><a href="/">Home</a></li>
            <li class="dropdown">
                <a href="/our-mission">About Us <i class="fas fa-chevron-down" style="font-size:0.55rem;margin-left:4px;"></i></a>
