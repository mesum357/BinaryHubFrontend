<%
  var svc = typeof service !== 'undefined' && service ? service : null;
  pageTitle = svc && svc.name ? svc.name : 'Service';
  pageDescription = svc && svc.shortDescription ? svc.shortDescription : 'Binary Hub service details.';
  activeNav = 'services';
  extraCss = '<link rel="stylesheet" href="/css/pages.css">';
%>
<%- include('partials/head') %>
<%- include('partials/nav') %>

<main>
  <% if (svc) { %>
  <header class="bh-page-hero">
    <div class="bh-container">
      <p class="bh-eyebrow"><a href="/services" style="color:inherit;text-decoration:none;">Services</a> / <%= svc.name %></p>
      <h1><%= svc.name %></h1>
      <p class="bh-lead"><%= svc.shortDescription || 'Explore how Binary Hub delivers this service.' %></p>
    </div>
  </header>

  <section class="bh-section" style="padding-top:0;">
    <div class="bh-container detail-layout">
      <div class="bh-reveal">
        <% if (svc.image) { %>
        <div class="page-card" style="margin-bottom:1.5rem;">
          <div class="page-card-media">
            <img src="<%= svc.image %>" alt="<%= svc.name %>" loading="lazy">
          </div>
        </div>
        <% } %>
        <div class="detail-panel" style="margin-bottom:1.25rem;">
          <h2>Introduction</h2>
          <div style="color:var(--bh-ink-soft);line-height:1.7;white-space:pre-wrap;"><%= svc.introduction || svc.shortDescription || 'Contact Binary Hub to scope this engagement.' %></div>
        </div>

        <% var modules = svc.outline || []; %>
        <% if (modules.length) { %>
        <h2 style="font-size:1.35rem;margin-bottom:1rem;">Outline</h2>
        <% modules.forEach(function(m, i) { %>
        <div class="detail-panel bh-reveal" style="margin-bottom:0.85rem;">
          <h3 style="font-size:1rem;margin-bottom:0.75rem;"><span style="color:var(--bh-accent);margin-right:0.5rem;"><%= String(i + 1).padStart(2, '0') %></span><%= m.title %></h3>
          <% if (m.items && m.items.length) { %>
          <ul class="module-list">
            <% m.items.forEach(function(item) { %><li><%= item %></li><% }); %>
          </ul>
          <% } %>
        </div>
        <% }); %>
        <% } %>
      </div>

      <aside class="detail-panel bh-reveal">
        <h2>Next step</h2>
        <p style="color:var(--bh-ink-soft);font-size:0.95rem;margin-bottom:1.25rem;">Ready to scope a project or train your team on this stack?</p>
        <a href="/courses" class="bh-btn bh-btn-primary" style="width:100%;justify-content:center;margin-bottom:0.65rem;">View courses</a>
        <a href="/services" class="bh-btn bh-btn-secondary" style="width:100%;justify-content:center;">All services</a>
      </aside>
    </div>
  </section>
  <% } else { %>
  <div id="not-found" style="display:none;">
    <header class="bh-page-hero">
      <div class="bh-container" style="text-align:center;max-width:36rem;margin-inline:auto;">
        <h1 style="max-width:none;">Service not found</h1>
        <p class="bh-lead" style="margin-inline:auto;">The link may be incomplete. Choose a service from the catalog.</p>
        <a href="/services" class="bh-btn bh-btn-primary" style="margin-top:1.5rem;">Back to services</a>
      </div>
    </header>
  </div>

  <div id="content-root" style="display:none;">
    <header class="bh-page-hero">
      <div class="bh-container">
        <p class="bh-eyebrow"><a href="/services" style="color:inherit;text-decoration:none;">Services</a> / <span id="bc-title">...</span></p>
        <div style="width:3.5rem;height:3.5rem;border-radius:12px;background:var(--bh-accent-soft);color:var(--bh-accent);display:flex;align-items:center;justify-content:center;font-size:1.35rem;margin-bottom:1rem;" id="hero-icon"><i class="fas fa-layer-group"></i></div>
        <h1 id="hero-title">...</h1>
        <p class="bh-lead" id="hero-tagline">...</p>
      </div>
    </header>
    <section class="bh-section" style="padding-top:0;">
      <div class="bh-container">
        <div class="detail-layout">
          <div>
            <div class="detail-panel" id="intro-html" style="margin-bottom:1.25rem;"></div>
            <h2 style="font-size:1.35rem;margin-bottom:1rem;">Outline</h2>
            <div id="modules-root"></div>
          </div>
          <aside class="detail-panel">
            <h2>Next steps</h2>
            <p style="color:var(--bh-ink-soft);font-size:0.92rem;margin-bottom:1.25rem;">Ready to scope a project or train your team?</p>
            <a href="/courses" class="bh-btn bh-btn-primary" style="width:100%;justify-content:center;margin-bottom:0.65rem;">View related courses</a>
            <a href="/services" class="bh-btn bh-btn-secondary" style="width:100%;justify-content:center;">All services</a>
          </aside>
        </div>
      </div>
    </section>
  </div>
  <% } %>

  <%- include('partials/footer') %>
</main>

<% if (!svc) { %>
<%
  extraJs = `
<script>
(function () {
  var SERVICES = {
    'web-dev': {
      title: 'Web Development',
      icon: 'fa-laptop-code',
      tagline: 'Modern, scalable web products from first sketch to production deployment.',
      intro: '<h2 style="font-size:1.15rem;margin-bottom:0.75rem;">Introduction</h2><p style="color:var(--bh-ink-soft);line-height:1.7;">Full-lifecycle web product delivery: discovery, frontend, backend, and launch.</p>',
      modules: [
        { title: 'Foundations & architecture', items: ['Requirements and constraints', 'Stack selection', 'Information architecture', 'Security baseline'] },
        { title: 'Frontend engineering', items: ['Component-driven UI', 'State and data fetching', 'Accessibility and performance', 'SEO essentials'] },
        { title: 'Backend & data', items: ['API design', 'Auth and roles', 'Data modeling', 'Jobs and integrations'] },
        { title: 'Quality & launch', items: ['Tests and staging', 'Monitoring', 'Release process', 'Handover docs'] }
      ]
    },
    'ai': {
      title: 'Artificial Intelligence',
      icon: 'fa-brain',
      tagline: 'Practical AI from prompt systems to models wired into your product.',
      intro: '<h2 style="font-size:1.15rem;margin-bottom:0.75rem;">Introduction</h2><p style="color:var(--bh-ink-soft);line-height:1.7;">Responsible AI adoption: use cases, guardrails, and production integrations.</p>',
      modules: [
        { title: 'Use-case design', items: ['Problem framing', 'Data and privacy', 'Human-in-the-loop', 'Risk assessment'] },
        { title: 'Model & tooling', items: ['Prompts and structured outputs', 'RAG quality', 'Fine-tuning trade-offs', 'Cost controls'] },
        { title: 'Integration', items: ['API contracts', 'Streaming UX', 'Caching and fallbacks', 'Observability'] },
        { title: 'Operations', items: ['Safety filters', 'Versioning', 'Feedback loops', 'Maintainer docs'] }
      ]
    },
    'uiux': {
      title: 'UI / UX Design',
      icon: 'fa-bezier-curve',
      tagline: 'Human-centered interfaces: research, systems, and delivery.',
      intro: '<h2 style="font-size:1.15rem;margin-bottom:0.75rem;">Introduction</h2><p style="color:var(--bh-ink-soft);line-height:1.7;">Research-led UI with design systems developers can ship reliably.</p>',
      modules: [
        { title: 'Discovery', items: ['Interviews and goals', 'Heuristic review', 'Personas', 'UX metrics'] },
        { title: 'Structure & flow', items: ['Site maps', 'Task flows', 'Wireframes', 'Usability plans'] },
        { title: 'Visual design', items: ['Brand systems', 'Component libraries', 'Responsive layouts', 'Motion notes'] },
        { title: 'Handoff', items: ['Specs and tokens', 'A11y annotations', 'Build QA', 'Iteration'] }
      ]
    },
    'graphic-design': {
      title: 'Graphic Designing',
      icon: 'fa-palette',
      tagline: 'Identity, campaigns, and print-ready artwork.',
      intro: '<h2 style="font-size:1.15rem;margin-bottom:0.75rem;">Introduction</h2><p style="color:var(--bh-ink-soft);line-height:1.7;">Brand-aligned graphics for campaigns, print, and digital channels.</p>',
      modules: [
        { title: 'Brand core', items: ['Logo lockups', 'Color and type', 'Voice alignment', 'Export standards'] },
        { title: 'Campaign creatives', items: ['Social templates', 'Banners and ads', 'Email headers', 'Event posters'] },
        { title: 'Print & production', items: ['Bleed and CMYK', 'Large-format', 'Proofing', 'File archive'] },
        { title: 'Workflow', items: ['Briefs', 'Revisions', 'Source organization', 'Brand toolkit'] }
      ]
    },
    'video-editing': {
      title: 'Video Editing',
      icon: 'fa-film',
      tagline: 'Editing, motion, color, and sound for stories that hold attention.',
      intro: '<h2 style="font-size:1.15rem;margin-bottom:0.75rem;">Introduction</h2><p style="color:var(--bh-ink-soft);line-height:1.7;">From rough cut to platform-ready masters with captions and grade.</p>',
      modules: [
        { title: 'Story & assembly', items: ['Rough cut', 'B-roll', 'Music direction', 'Pacing'] },
        { title: 'Picture finish', items: ['Color grade', 'Titles', 'Motion graphics', 'Stabilization'] },
        { title: 'Audio', items: ['Dialogue cleanup', 'SFX balance', 'Loudness targets', 'Captions'] },
        { title: 'Delivery', items: ['Master exports', 'Platform crops', 'Ad cutdowns', 'Archive'] }
      ]
    },
    'bookkeeping': {
      title: 'Bookkeeping',
      icon: 'fa-file-invoice-dollar',
      tagline: 'Accurate books, clear reports, and reconciliations you can trust.',
      intro: '<h2 style="font-size:1.15rem;margin-bottom:0.75rem;">Introduction</h2><p style="color:var(--bh-ink-soft);line-height:1.7;">Orderly financial records and reporting for growing teams.</p>',
      modules: [
        { title: 'Setup', items: ['Chart of accounts', 'Opening balances', 'Categorization rules', 'User roles'] },
        { title: 'Monthly rhythm', items: ['Expense capture', 'Reconciliations', 'AP/AR hygiene', 'Fixed assets'] },
        { title: 'Reporting', items: ['P&L and balance sheet', 'Budget vs actual', 'Dashboards', 'Schedules'] },
        { title: 'Governance', items: ['Retention', 'Month-end close', 'Audit files', 'Advisor coordination'] }
      ]
    }
  };

  function getId() {
    var q = new URLSearchParams(window.location.search).get('id') || '';
    if (q) return q;
    var parts = window.location.pathname.split('/').filter(Boolean);
    return parts[parts.length - 1] || '';
  }

  function render() {
    var data = SERVICES[getId()];
    var root = document.getElementById('content-root');
    var nf = document.getElementById('not-found');
    if (!data) {
      document.title = 'Service not found | Binary Hub';
      nf.style.display = 'block';
      root.style.display = 'none';
      return;
    }
    document.title = data.title + ' | Binary Hub';
    nf.style.display = 'none';
    root.style.display = 'block';
    document.getElementById('bc-title').textContent = data.title;
    document.getElementById('hero-title').textContent = data.title;
    document.getElementById('hero-tagline').textContent = data.tagline;
    document.getElementById('hero-icon').innerHTML = '<i class="fas ' + data.icon + '"></i>';
    document.getElementById('intro-html').innerHTML = data.intro;
    document.getElementById('modules-root').innerHTML = data.modules.map(function (m, i) {
      return '<div class="detail-panel" style="margin-bottom:0.85rem;"><h3 style="font-size:1rem;margin-bottom:0.75rem;"><span style="color:var(--bh-accent);margin-right:0.5rem;">' + String(i + 1).padStart(2, '0') + '</span>' + m.title + '</h3><ul class="module-list">' + m.items.map(function (li) { return '<li>' + li + '</li>'; }).join('') + '</ul></div>';
    }).join('');
  }
  render();
})();
</script>
`;
%>
<% } %>
<%- include('partials/scripts') %>
