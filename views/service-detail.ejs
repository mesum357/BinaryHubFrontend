            </div>
            <div class="footer-bottom">
                <span>&copy; 2026 Binary Hub</span>
                <span>Services detail</span>
            </div>
        </div>
    </footer>

    <script>
        const SERVICES = {
            'web-dev': {
                title: 'Web Development',
                icon: 'fa-laptop-code',
                tagline: 'Modern, scalable web products — from first sketch to production deployment.',
                intro: `<h2 class="bebas">Introduction</h2>
                    <p>Our web development service covers the full lifecycle of a digital product: discovery, UX alignment, frontend implementation, backend APIs, databases, DevOps, and ongoing performance tuning.</p>
                    <p>Whether you need a marketing site, a SaaS dashboard, or an e-commerce flow, we align engineering choices with your growth roadmap and maintainability needs.</p>`,
                modules: [
                    { title: 'Foundations & architecture', items: ['Requirements, user journeys, and technical constraints', 'Stack selection (framework, hosting, CI/CD)', 'Information architecture and URL strategy', 'Security baseline (HTTPS, headers, secrets)'] },
                    { title: 'Frontend engineering', items: ['Component-driven UI and responsive layouts', 'State management and data fetching patterns', 'Accessibility (a11y) and performance budgets', 'SEO essentials for content-heavy pages'] },
                    { title: 'Backend & data', items: ['REST/GraphQL API design', 'Authentication, roles, and session handling', 'Relational and document data modeling', 'Background jobs, queues, and integrations'] },
                    { title: 'Quality & launch', items: ['Automated tests and staging environments', 'Monitoring, logging, and error tracking', 'Release process and rollback strategy', 'Handover documentation and training'] }
                ]
            },
            'ai': {
                title: 'Artificial Intelligence',
                icon: 'fa-brain',
                tagline: 'Practical AI — from prompt systems to custom models wired into your product.',
                intro: `<h2 class="bebas">Introduction</h2>
                    <p>We help teams adopt AI responsibly: clarifying use cases, selecting models, designing guardrails, and integrating LLM and classical ML components into existing software.</p>
                    <p>Engagements range from workflow automation and retrieval-augmented assistants to evaluation pipelines and monitoring for production AI features.</p>`,
                modules: [
                    { title: 'Use-case design', items: ['Problem framing and success metrics', 'Data inventory and privacy boundaries', 'Human-in-the-loop workflows', 'Risk assessment and policy alignment'] },
                    { title: 'Model & tooling', items: ['Baseline prompts and structured outputs', 'RAG: chunking, embeddings, and retrieval quality', 'Fine-tuning vs prompt engineering trade-offs', 'Vendor APIs and cost controls'] },
                    { title: 'Integration', items: ['API contracts between app and model layer', 'Streaming UX and latency budgets', 'Caching, fallbacks, and rate limits', 'Observability: traces, eval sets, regression tests'] },
                    { title: 'Operations', items: ['Content safety filters and escalation paths', 'Versioning prompts and model configs', 'Continuous improvement from user feedback', 'Documentation for maintainers'] }
                ]
            },
            'uiux': {
                title: 'UI / UX Design',
                icon: 'fa-bezier-curve',
                tagline: 'Human-centered interfaces — research, systems, and pixel-perfect delivery.',
                intro: `<h2 class="bebas">Introduction</h2>
                    <p>We combine user research with a strong visual language so products feel intuitive and on-brand. Deliverables include flows, wireframes, high-fidelity UI, and a design system your developers can implement reliably.</p>
                    <p>We collaborate closely with engineering to preserve interaction details, motion, and accessibility across breakpoints.</p>`,
                modules: [
                    { title: 'Discovery', items: ['Stakeholder interviews and goals', 'Competitive and heuristic review', 'Personas and scenario mapping', 'Success metrics for UX'] },
                    { title: 'Structure & flow', items: ['Site maps and navigation models', 'Task flows and edge cases', 'Low-fidelity wireframes', 'Usability test plans'] },
                    { title: 'Visual design', items: ['Brand-aligned color, type, and imagery', 'Component libraries in Figma', 'Responsive layouts and grid systems', 'Micro-interactions and motion notes'] },
                    { title: 'Handoff', items: ['Specs, redlines, and tokens', 'Accessibility annotations', 'QA support during build', 'Iteration from analytics and feedback'] }
                ]
            },
            'graphic-design': {
                title: 'Graphic Designing',
                icon: 'fa-palette',
                tagline: 'Identity, campaigns, and print-ready artwork with a cohesive visual story.',
                intro: `<h2 class="bebas">Introduction</h2>
                    <p>From logo systems to social campaigns, we craft graphics that communicate clearly and look sharp on every medium. We balance creativity with brand guidelines so your assets stay consistent.</p>
                    <p>Deliverables can include vector packs, presentation decks, packaging concepts, and large-format layouts.</p>`,
                modules: [
                    { title: 'Brand core', items: ['Logo concepts and lockups', 'Color palettes and typography pairs', 'Brand voice alignment with visuals', 'Asset export standards'] },
                    { title: 'Campaign creatives', items: ['Social post templates and carousels', 'Web banners and ad sets', 'Email headers and newsletter graphics', 'Event posters and standees'] },
                    { title: 'Print & production', items: ['Bleed, margins, and CMYK prep', 'Large-format and merchandise mockups', 'Proofing rounds and vendor liaison', 'Archiving master files'] },
                    { title: 'Workflow', items: ['Creative briefs and mood boards', 'Revision structure and timelines', 'Source file organization', 'Brand toolkit documentation'] }
                ]
            },
            'video-editing': {
                title: 'Video Editing',
                icon: 'fa-film',
                tagline: 'Editing, motion, color, and sound — stories that hold attention.',
                intro: `<h2 class="bebas">Introduction</h2>
                    <p>We take raw footage and shape it into compelling narratives: pacing, structure, titles, motion graphics, color grading, and clean audio. Ideal for promos, explainers, event highlights, and course content.</p>
                    <p>Outputs are tuned for each platform — aspect ratios, safe zones, captions, and loudness standards.</p>`,
                modules: [
                    { title: 'Story & assembly', items: ['Rough cut and narrative arc', 'B-roll selection and coverage', 'Music direction and licensing notes', 'Pacing and retention edits'] },
                    { title: 'Picture finish', items: ['Color correction and stylistic grade', 'Titles, lower thirds, and brand packs', 'Motion graphics and simple VFX', 'Frame cleanup and stabilization'] },
                    { title: 'Audio', items: ['Dialogue cleanup and leveling', 'Music balance and SFX design', 'Platform loudness targets', 'Captions and subtitles'] },
                    { title: 'Delivery', items: ['Master exports and proxy workflows', 'Platform-specific crops (9:16, 1:1, 16:9)', 'Versioning for ads and cutdowns', 'Archive and project organization'] }
                ]
            },
            'bookkeeping': {
                title: 'Bookkeeping',
                icon: 'fa-file-invoice-dollar',
                tagline: 'Accurate books, clear reports, and reconciliations you can trust.',
                intro: `<h2 class="bebas">Introduction</h2>
                    <p>We maintain orderly financial records for small teams and growing businesses: chart of accounts, daily entries, bank reconciliations, and periodic reports that support decisions and compliance.</p>
                    <p>We work with your tools — spreadsheets or cloud accounting — and document processes so handoffs stay smooth.</p>`,
                modules: [
                    { title: 'Setup', items: ['Chart of accounts tailored to your entity', 'Opening balances and historical import', 'Categorization rules and vendor defaults', 'User roles and approval flows'] },
                    { title: 'Monthly rhythm', items: ['Sales and expense capture', 'Bank and card reconciliations', 'Accounts payable/receivable hygiene', 'Fixed assets and depreciation basics'] },
                    { title: 'Reporting', items: ['P&amp;L, balance sheet, cash flow views', 'Budget vs actual snapshots', 'Dashboards for leadership', 'Supporting schedules for advisors'] },
                    { title: 'Governance', items: ['Document retention practices', 'Month-end close checklist', 'Audit-ready file structure', 'Coordination with tax and legal partners'] }
                ]
            }
        };

        const SERVER_SERVICE = <% if (typeof service !== 'undefined' && service) { %><%- JSON.stringify(service) %><% } else { %>null<% } %>;

        function getId() {
            const p = new URLSearchParams(window.location.search);
            return p.get('id') || '';
        }

        function render() {
            let data = null;
            if (SERVER_SERVICE && SERVER_SERVICE.name) {
                data = {
                    title: SERVER_SERVICE.name,
                    icon: 'fa-layer-group',
                    tagline: SERVER_SERVICE.shortDescription || '',
                    intro: (SERVER_SERVICE.introduction || '') ? `<div class="server-intro">${SERVER_SERVICE.introduction}</div>` : '<h2 class="bebas">Introduction</h2>',
                    modules: (SERVER_SERVICE.outline || []).map(function (o) {
                        return { title: o.title, items: o.items || [] };
                    })
                };
            }
            if (!data) {
            const id = getId();
            data = SERVICES[id];
            }
            const root = document.getElementById('content-root');
            const nf = document.getElementById('not-found');
            if (!data) {
                document.title = 'Service not found | Binary Hub';
                nf.classList.add('visible');
                root.classList.remove('visible');
                return;
            }
            document.title = data.title + ' | Binary Hub Services';
            nf.classList.remove('visible');
            root.classList.add('visible');

            document.getElementById('bc-title').textContent = data.title;
            document.getElementById('hero-title').innerHTML = data.title.replace(' / ', '<br>');
            document.getElementById('hero-tagline').textContent = data.tagline;
            const ic = document.getElementById('hero-icon');
            ic.innerHTML = '<i class="fas ' + data.icon + '"></i>';
            document.getElementById('intro-html').innerHTML = data.intro;

            const mr = document.getElementById('modules-root');
            mr.innerHTML = data.modules.map((m, i) => `
                <div class="module ${i === 0 ? 'open' : ''}">
                    <div class="module-head" role="button" tabindex="0">
                        <span class="module-num">${String(i + 1).padStart(2, '0')}</span>
                        <h3>${m.title}</h3>
                        <i class="fas fa-chevron-down module-toggle"></i>
                    </div>
                    <div class="module-body">
                        <ul class="module-list">
                            ${m.items.map(li => `<li>${li}</li>`).join('')}
                        </ul>
                    </div>
                </div>
            `).join('');

            mr.querySelectorAll('.module-head').forEach(head => {
                head.addEventListener('click', () => head.parentElement.classList.toggle('open'));
                head.addEventListener('keydown', (e) => {
                    if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); head.parentElement.classList.toggle('open'); }
                });
            });
        }

        window.addEventListener('load', () => {
            render();
            setTimeout(() => {
                const loader = document.getElementById('loader');
                if (loader) { loader.style.opacity = '0'; setTimeout(() => { loader.style.display = 'none'; }, 600); }
            }, 400);
        });

        const cursorGlow = document.getElementById('cursor-glow');
        const cursorDot = document.getElementById('cursor-dot');
        document.addEventListener('mousemove', (e) => {
            cursorGlow.style.left = e.clientX + 'px';
            cursorGlow.style.top = e.clientY + 'px';
            cursorDot.style.left = e.clientX + 'px';
            cursorDot.style.top = e.clientY + 'px';
        });
        document.querySelectorAll('a, button, .module-head').forEach(el => {
            el.addEventListener('mouseenter', () => {
                cursorGlow.style.width = '380px';
                cursorGlow.style.height = '380px';
                cursorDot.style.transform = 'translate(-50%,-50%) scale(2)';
            });
            el.addEventListener('mouseleave', () => {
                cursorGlow.style.width = '300px';
                cursorGlow.style.height = '300px';
                cursorDot.style.transform = 'translate(-50%,-50%) scale(1)';
            });
        });

        const navbar = document.getElementById('navbar');
        const scrollProgress = document.getElementById('scroll-progress');
        window.addEventListener('scroll', () => {
            const winScroll = document.body.scrollTop || document.documentElement.scrollTop;
            const h = document.documentElement.scrollHeight - document.documentElement.clientHeight;
            scrollProgress.style.width = (winScroll / h) * 100 + '%';
            if (winScroll > 40) navbar.classList.add('scrolled');
            else navbar.classList.remove('scrolled');
        });

        const mobileToggle = document.getElementById('mobileToggle');
        const navLinks = document.querySelector('.nav-links');
        if (mobileToggle) {
            mobileToggle.addEventListener('click', (e) => {
                e.stopPropagation();
                navLinks.classList.toggle('active');
                const icon = mobileToggle.querySelector('i');
                if (navLinks.classList.contains('active')) icon.classList.replace('fa-bars', 'fa-times');
                else icon.classList.replace('fa-times', 'fa-bars');
            });
        }
    </script>
</body>
</html>
