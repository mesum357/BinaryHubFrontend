<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Visits | Binary Hub Gallery</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@300;400;500;600;700&family=Space+Grotesk:wght@500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --orange: #ee702b;
            --blue: #005696;
            --dark: #0a1628;
            --white: #ffffff;
            --gray-light: #f5f7fa;
            --gray-text: #6b7280;
            --gradient: linear-gradient(135deg, #ee702b, #005696);
        }
        * { margin: 0; padding: 0; box-sizing: border-box; outline: none; cursor: none; }
        html { scroll-behavior: smooth; }
        body { font-family: 'Inter', sans-serif; background: #0a0f18; color: var(--dark); overflow-x: hidden; line-height: 1.65; }
        h1, h2, h3, .bebas { font-family: 'Bebas Neue', cursive; }
        .noise-overlay {
            position: fixed; inset: 0; pointer-events: none; z-index: 9999; opacity: 0.04;
            background: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
        }
        #cursor-glow {
            position: fixed; width: 300px; height: 300px;
            background: radial-gradient(circle, rgba(238,112,43,0.14) 0%, transparent 65%);
            border-radius: 50%; pointer-events: none; z-index: 9998; transform: translate(-50%, -50%);
        }
        #cursor-dot {
            position: fixed; width: 8px; height: 8px; background: var(--orange); border-radius: 50%;
            pointer-events: none; z-index: 10005; transform: translate(-50%, -50%);
        }
        #scroll-progress { position: fixed; top: 0; left: 0; height: 3px; background: var(--gradient); z-index: 10001; width: 0%; }
        .container { max-width: 1100px; margin: 0 auto; padding: 0 25px; }
        .gradient-text {
            background: var(--gradient); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
        }

        nav {
            position: fixed; top: 0; width: 100%; padding: 20px 10%; display: flex; justify-content: space-between; align-items: center;
            z-index: 10000; transition: 0.5s;
        }
        nav.scrolled { background: rgba(5, 11, 22, 0.92); backdrop-filter: blur(20px); padding: 15px 10%; border-bottom: 1px solid rgba(255,255,255,0.06); }
        .logo { display: flex; align-items: center; height: 50px; }
        .logo img { height: 100%; width: auto; }
        nav.scrolled .logo { height: 40px; }
        .nav-links { display: flex; gap: 28px; list-style: none; }
        .nav-links li { position: relative; }
        .nav-links a {
            text-decoration: none; color: white; font-weight: 600; font-size: 0.88rem; text-transform: uppercase;
            letter-spacing: 1px; padding-bottom: 4px;
        }
        .nav-links a::after {
            content: ''; position: absolute; bottom: -2px; left: 0; width: 0; height: 2px; background: var(--orange); transition: 0.3s;
        }
        .nav-links a:hover::after, .nav-links a.active::after { width: 100%; }
        .dropdown { position: relative; }
        .dropdown-menu {
            position: absolute; top: 38px; left: 0; background: rgba(255,255,255,0.97); min-width: 210px; border-radius: 12px;
            padding: 12px 0; box-shadow: 0 14px 44px rgba(0,0,0,0.12); opacity: 0; visibility: hidden; transform: translateY(12px); transition: 0.35s;
        }
        .dropdown:hover .dropdown-menu { opacity: 1; visibility: visible; transform: translateY(0); }
        .dropdown-menu a { display: block; padding: 10px 20px; font-size: 0.85rem; color: #0a1628 !important; }
        .dropdown-menu a::after { display: none; }
        .dropdown-menu a:hover { background: var(--gray-light); color: var(--orange) !important; }
        .mobile-toggle { display: none; color: white; font-size: 1.5rem; z-index: 10002; }

        .visit-hero {
            min-height: 85vh; position: relative; display: flex; align-items: flex-end; padding: 140px 24px 80px;
            background: url('https://images.unsplash.com/photo-1488646953014-85cb44e25828?q=80&w=2035&auto=format&fit=crop') center/cover no-repeat;
        }
        .visit-hero::before {
            content: ''; position: absolute; inset: 0;
            background: linear-gradient(to top, #0a0f18 0%, rgba(10,15,24,0.85) 45%, rgba(5,11,22,0.55) 100%);
        }
        .visit-hero .inner { position: relative; z-index: 2; max-width: 1200px; margin: 0 auto; width: 100%; }
        .visit-hero h1 { font-size: clamp(3rem, 9vw, 6rem); color: white; line-height: 0.95; margin-bottom: 16px; }
        .visit-hero p { color: #cbd5e1; font-size: 1.1rem; max-width: 520px; }

        .visits-body { background: #f8fafc; padding: 90px 0 110px; margin-top: -40px; border-radius: 40px 40px 0 0; position: relative; z-index: 3; }
        .section-head { text-align: center; margin-bottom: 56px; }
        .section-head .eyebrow { color: var(--orange); font-weight: 700; letter-spacing: 4px; font-size: 0.75rem; text-transform: uppercase; }
        .section-head h2 { font-size: clamp(2rem, 4vw, 3.2rem); color: var(--dark); margin: 12px 0; }
        .section-head p { color: var(--gray-text); max-width: 560px; margin: 0 auto; }

        .visit-card {
            background: white; border-radius: 28px; overflow: hidden; margin-bottom: 56px;
            box-shadow: 0 24px 60px rgba(15,23,42,0.08); border: 1px solid rgba(0,0,0,0.04);
            display: grid; grid-template-columns: 1fr 1fr; min-height: 380px;
        }
        .visit-card:nth-child(even) .visit-gallery { order: 2; }
        .visit-card:nth-child(even) .visit-writeup { order: 1; }
        .visit-gallery {
            display: grid; grid-template-columns: 1fr 1fr; grid-template-rows: 1fr 1fr; gap: 8px; padding: 8px; background: #0f172a;
        }
        .visit-gallery .g1 { grid-row: span 2; border-radius: 20px; overflow: hidden; }
        .visit-gallery .g2, .visit-gallery .g3 { border-radius: 16px; overflow: hidden; }
        .visit-gallery img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.7s ease; }
        .visit-card:hover .visit-gallery img { transform: scale(1.04); }
        .visit-writeup { padding: 44px 40px; display: flex; flex-direction: column; justify-content: center; }
        .visit-writeup .loc {
            display: inline-flex; align-items: center; gap: 8px; font-size: 0.8rem; font-weight: 700; text-transform: uppercase;
            letter-spacing: 2px; color: var(--blue); margin-bottom: 14px;
        }
        .visit-writeup h3 { font-size: clamp(1.6rem, 2.5vw, 2.2rem); margin-bottom: 16px; color: var(--dark); }
        .visit-writeup p { color: var(--gray-text); font-size: 1.02rem; line-height: 1.75; }

        footer {
            background: var(--dark); color: white; padding: 70px 0 28px;
        }
        .footer-grid { max-width: 1200px; margin: 0 auto; padding: 0 25px; display: grid; grid-template-columns: repeat(4, 1fr); gap: 36px; margin-bottom: 44px; }
        .footer-col h4 { color: var(--orange); font-family: 'Space Grotesk', sans-serif; margin-bottom: 16px; font-size: 1rem; }
        .footer-col ul { list-style: none; }
        .footer-col a { color: #9ca3af; text-decoration: none; font-size: 0.9rem; }
        .footer-col a:hover { color: white; }
        .footer-bottom { max-width: 1200px; margin: 0 auto; padding: 22px 25px 0; border-top: 1px solid rgba(255,255,255,0.06);
            display: flex; justify-content: space-between; flex-wrap: wrap; gap: 10px; font-size: 0.8rem; color: #6b7280;
        }
        #loader { position: fixed; inset: 0; background: #050b16; z-index: 10002; display: flex; align-items: center; justify-content: center; transition: opacity 0.7s; }
        .loader-logo { width: 190px; opacity: 0; animation: lp 0.9s ease forwards; }
        .loader-logo img { width: 100%; }
        @keyframes lp { to { opacity: 1; } }
        #backToTop {
            position: fixed; bottom: 28px; right: 28px; width: 48px; height: 48px; border-radius: 50%;
            background: var(--gradient); color: white; display: flex; align-items: center; justify-content: center;
            cursor: pointer; opacity: 0; visibility: hidden; transition: 0.3s; z-index: 999;
        }
        #backToTop.visible { opacity: 1; visibility: visible; }

        @media (max-width: 900px) {
            .visit-card, .visit-card:nth-child(even) { grid-template-columns: 1fr; }
            .visit-card:nth-child(even) .visit-gallery, .visit-card:nth-child(even) .visit-writeup { order: unset; }
            .visit-gallery { min-height: 280px; }
            .footer-grid { grid-template-columns: repeat(2, 1fr); }
        }
        @media (max-width: 768px) {
            .nav-links { display: none; position: fixed; top: 0; right: 0; width: 86%; max-width: 320px; height: 100vh;
                background: #050b16; flex-direction: column; padding: 96px 26px; gap: 0; }
            .nav-links.active { display: flex; }
            .nav-links li { width: 100%; padding: 14px 0; border-bottom: 1px solid rgba(255,255,255,0.06); }
            .dropdown-menu { position: static; opacity: 1; visibility: visible; transform: none; box-shadow: none; background: transparent; padding: 8px 0 0 12px; }
            .dropdown-menu a { color: #cbd5e1 !important; }
            .mobile-toggle { display: block; }
        }
    </style>
</head>
<body>
    <div class="noise-overlay"></div>
    <div id="cursor-glow"></div>
    <div id="cursor-dot"></div>
    <div id="scroll-progress"></div>
    <div id="loader"><div class="loader-logo"><img src="/images/logo binary.png" alt=""></div></div>

    <nav id="navbar">
        <a href="/" class="logo"><img src="/images/logo binary.png" alt="Binary Hub"></a>
        <ul class="nav-links">
            <li><a href="/">Home</a></li>
            <li class="dropdown">
                <a href="/our-mission">About Us <i class="fas fa-chevron-down" style="font-size:0.6rem;margin-left:5px;"></i></a>
                <div class="dropdown-menu">
                    <a href="/team">Our Team</a>
                    <a href="/our-mission">Our Mission</a>
                    <a href="/impact">Our Impact</a>
                    <a href="/branches">Our Branches</a>
                </div>
            </li>
            <li><a href="/courses">Courses</a></li>
            <li class="dropdown">
                <a href="/events" class="active">Gallery <i class="fas fa-chevron-down" style="font-size:0.6rem;margin-left:5px;"></i></a>
                <div class="dropdown-menu">
                    <a href="/events">Events</a>
                    <a href="/visits">Visits</a>
                </div>
            </li>
            <li><a href="/services">Services</a></li>
            <li><a href="/internships">Internships</a></li>
        </ul>
        <div class="mobile-toggle" id="mobileToggle"><i class="fas fa-bars"></i></div>
    </nav>

    <header class="visit-hero">
        <div class="inner">
            <p style="color:var(--orange);font-weight:700;letter-spacing:4px;font-size:0.75rem;text-transform:uppercase;margin-bottom:12px;">Field notes</p>
            <h1 class="bebas">VISITS &amp;<br><span class="gradient-text" style="-webkit-text-fill-color:transparent;">VOYAGES</span></h1>
            <p>Industry tours, partner labs, schools, and community sites — every trip widens how our learners see technology in the real world.</p>
        </div>
    </header>

    <section class="visits-body">
        <div class="container">
            <div class="section-head">
                <span class="eyebrow">Journeys</span>
                <h2 class="bebas">Where we’ve been</h2>
                <p>Curated stories from recent excursions — each with context, photos, and what students took away.</p>
            </div>

            <% const defImg = 'https://images.unsplash.com/photo-1581092160562-40aa08d78832?q=80&w=2070&auto=format&fit=crop'; %>
            <% if (typeof visits !== 'undefined' && visits && visits.length) { visits.forEach(function(v) { const imgs = v.images || []; %>
            <article class="visit-card">
                <div class="visit-gallery">
                    <div class="g1"><img src="<%= imgs[0] || defImg %>" alt=""></div>
                    <div class="g2"><img src="<%= imgs[1] || defImg %>" alt=""></div>
                    <div class="g3"><img src="<%= imgs[2] || defImg %>" alt=""></div>
                </div>
                <div class="visit-writeup">
                    <span class="loc"><i class="fas fa-location-dot"></i> Visit</span>
                    <h3 class="bebas"><%= v.name %></h3>
                    <p><%= v.description || '' %></p>
                </div>
            </article>
            <% }); } else { %>
            <article class="visit-card">
                <div class="visit-gallery">
                    <div class="g1"><img src="<%= defImg %>" alt=""></div>
                    <div class="g2"><img src="<%= defImg %>" alt=""></div>
                    <div class="g3"><img src="<%= defImg %>" alt=""></div>
                </div>
                <div class="visit-writeup">
                    <span class="loc"><i class="fas fa-location-dot"></i> Innovation District</span>
                    <h3 class="bebas">Tech Park immersion day</h3>
                    <p>Students shadowed DevOps and QA squads and toured partner facilities.</p>
                </div>
            </article>
            <% } %>
        </div>
    </section>

    <footer>
        <div class="footer-grid">
            <div class="footer-col">
                <a href="/"><img src="/images/logo binary.png" alt="" style="height:52px;margin-bottom:12px;"></a>
                <p style="color:#9ca3af;font-size:0.9rem;">Learning beyond the classroom walls.</p>
            </div>
            <div class="footer-col">
                <h4>Gallery</h4>
                <ul>
                    <li><a href="/events">Events</a></li>
                    <li><a href="/visits">Visits</a></li>
                </ul>
            </div>
            <div class="footer-col">
                <h4>About</h4>
                <ul>
                    <li><a href="/our-mission">Our Mission</a></li>
                    <li><a href="/impact">Our Impact</a></li>
                    <li><a href="/branches">Our Branches</a></li>
                </ul>
            </div>
            <div class="footer-col">
                <h4>Contact</h4>
                <ul>
                    <li style="color:#9ca3af;">info@binaryhub.pk</li>
                    <li style="color:#9ca3af;">+92 300 1234567</li>
                </ul>
            </div>
        </div>
        <div class="footer-bottom">
            <span>&copy; 2026 Binary Hub</span>
            <span>Visits</span>
        </div>
    </footer>
    <div id="backToTop"><i class="fa-solid fa-arrow-up"></i></div>

    <script>
        window.addEventListener('load', () => {
            setTimeout(() => {
                const l = document.getElementById('loader');
                if (l) { l.style.opacity = '0'; setTimeout(() => { l.style.display = 'none'; }, 600); }
            }, 450);
        });
        const cg = document.getElementById('cursor-glow'), cd = document.getElementById('cursor-dot');
        document.addEventListener('mousemove', (e) => {
            cg.style.left = e.clientX + 'px'; cg.style.top = e.clientY + 'px';
            cd.style.left = e.clientX + 'px'; cd.style.top = e.clientY + 'px';
        });
        document.querySelectorAll('a, button').forEach(el => {
            el.addEventListener('mouseenter', () => { cg.style.width = '400px'; cg.style.height = '400px'; cd.style.transform = 'translate(-50%,-50%) scale(2)'; });
            el.addEventListener('mouseleave', () => { cg.style.width = '300px'; cg.style.height = '300px'; cd.style.transform = 'translate(-50%,-50%) scale(1)'; });
        });
        const navbar = document.getElementById('navbar'), sp = document.getElementById('scroll-progress'), btt = document.getElementById('backToTop');
        window.addEventListener('scroll', () => {
            const ws = document.body.scrollTop || document.documentElement.scrollTop;
            const h = document.documentElement.scrollHeight - document.documentElement.clientHeight;
            sp.style.width = (ws / h) * 100 + '%';
            if (ws > 50) navbar.classList.add('scrolled'); else navbar.classList.remove('scrolled');
            if (ws > 300) btt.classList.add('visible'); else btt.classList.remove('visible');
        });
        btt.onclick = () => window.scrollTo({ top: 0, behavior: 'smooth' });
        const mt = document.getElementById('mobileToggle'), nl = document.querySelector('.nav-links');
        if (mt) mt.addEventListener('click', (e) => {
            e.stopPropagation();
            nl.classList.toggle('active');
            const i = mt.querySelector('i');
            if (nl.classList.contains('active')) i.classList.replace('fa-bars', 'fa-times');
            else i.classList.replace('fa-times', 'fa-bars');
        });
        document.querySelectorAll('.dropdown > a').forEach(t => {
            t.addEventListener('click', (e) => { if (window.innerWidth <= 768) { e.preventDefault(); t.parentElement.classList.toggle('open'); } });
        });
    </script>
</body>
</html>
