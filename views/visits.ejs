<%
  pageTitle = 'Visits';
  pageDescription = 'Campus and field visits from Binary Hub: schools, partners, and community outreach.';
  activeNav = '';
  extraCss = '<link rel="stylesheet" href="/css/pages.css">';
%>
<%- include('partials/head') %>
<%- include('partials/nav') %>

<main>
  <header class="bh-page-hero">
    <div class="bh-container">
      <h1>Field notes from our visits.</h1>
      <p class="bh-lead">Snapshots from campus tours, partner sites, and outreach across the community.</p>
    </div>
  </header>

  <section class="bh-section" style="padding-top:0;">
    <div class="bh-container">
      <div class="page-grid">
        <% if (typeof visits !== 'undefined' && visits && visits.length) { visits.forEach(function(v, idx) { const imgs = v.images || []; %>
        <article class="page-card bh-reveal">
          <div class="page-card-media">
            <% if (imgs[0]) { %>
            <img src="<%= imgs[0] %>" alt="<%= v.name %>" loading="lazy">
            <% } else { %>
            <img src="https://picsum.photos/seed/visit-<%= idx %>/640/400" alt="<%= v.name %>" loading="lazy">
            <% } %>
          </div>
          <div class="page-card-body">
            <h3><%= v.name %></h3>
            <p><%= v.description || '' %></p>
            <% if (imgs[1] || imgs[2]) { %>
            <div style="display:flex;gap:0.5rem;margin-top:0.5rem;">
              <% if (imgs[1]) { %><img src="<%= imgs[1] %>" alt="" style="width:48px;height:48px;object-fit:cover;border-radius:8px;" loading="lazy"><% } %>
              <% if (imgs[2]) { %><img src="<%= imgs[2] %>" alt="" style="width:48px;height:48px;object-fit:cover;border-radius:8px;" loading="lazy"><% } %>
            </div>
            <% } %>
          </div>
        </article>
        <% }); } else { %>
        <div class="page-empty">No visits published yet. Check back soon.</div>
        <% } %>
      </div>
    </div>
  </section>

  <%- include('partials/footer') %>
</main>
<%- include('partials/scripts') %>
