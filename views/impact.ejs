<%
  pageTitle = 'Our Impact';
  pageDescription = 'How Binary Hub invests in youth, women, tourism, and vocational skills across Pakistan.';
  activeNav = '';
  extraCss = '<link rel="stylesheet" href="/css/pages.css">';
%>
<%- include('partials/head') %>
<%- include('partials/nav') %>

<main>
  <header class="bh-page-hero">
    <div class="bh-container">
      <h1>Outcomes you can trace.</h1>
      <p class="bh-lead">Four pillars show how Binary Hub invests in people, place, and the wider economy.</p>
    </div>
  </header>

  <section class="bh-section" style="padding-top:0;">
    <div class="bh-container">
      <div class="page-grid">
        <a href="/impact/youth-empowerment" class="page-card bh-reveal">
          <div class="page-card-media">
            <img src="https://picsum.photos/seed/youth-empowerment/640/400" alt="Youth empowerment" loading="lazy">
          </div>
          <div class="page-card-body">
            <div class="page-chip page-chip-accent" style="align-self:flex-start;"><i class="fas fa-rocket" style="margin-right:0.35rem;"></i> Youth</div>
            <h3>Youth Empowerment</h3>
            <p>Scholarships, bootcamps, and peer networks that help teens see a future in tech.</p>
          </div>
        </a>
        <a href="/impact/women-empowerment" class="page-card bh-reveal">
          <div class="page-card-media">
            <img src="https://picsum.photos/seed/women-empowerment/640/400" alt="Women empowerment" loading="lazy">
          </div>
          <div class="page-card-body">
            <div class="page-chip page-chip-accent" style="align-self:flex-start;"><i class="fas fa-venus" style="margin-right:0.35rem;"></i> Women</div>
            <h3>Women Empowerment</h3>
            <p>Dedicated cohorts, mentorship circles, and hiring alliances that close the gender gap.</p>
          </div>
        </a>
        <a href="/impact/tourist-promotion" class="page-card bh-reveal">
          <div class="page-card-media">
            <img src="https://picsum.photos/seed/tourist-promotion/640/400" alt="Tourist promotion" loading="lazy">
          </div>
          <div class="page-card-body">
            <div class="page-chip page-chip-accent" style="align-self:flex-start;"><i class="fas fa-mountain-sun" style="margin-right:0.35rem;"></i> Tourism</div>
            <h3>Tourist Promotion</h3>
            <p>Digital storytelling and design sprints that spotlight culture and responsible travel.</p>
          </div>
        </a>
        <a href="/impact/vocational-center" class="page-card bh-reveal">
          <div class="page-card-media">
            <img src="https://picsum.photos/seed/vocational-center/640/400" alt="Vocational center" loading="lazy">
          </div>
          <div class="page-card-body">
            <div class="page-chip page-chip-accent" style="align-self:flex-start;"><i class="fas fa-screwdriver-wrench" style="margin-right:0.35rem;"></i> Trades</div>
            <h3>Vocational Center</h3>
            <p>Hands-on trades, equipment labs, and certifications aligned with local employer demand.</p>
          </div>
        </a>
      </div>
    </div>
  </section>

  <%- include('partials/footer') %>
</main>
<%- include('partials/scripts') %>
