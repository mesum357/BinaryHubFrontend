<%- include('partials/auth-layout-start') %>
<div class="auth-shell account-wide">
    <div class="auth-card account-card">
        <h1>Recent purchases</h1>
        <p class="auth-lead">Course payment requests linked to your account.</p>
        <% if (!payments || !payments.length) { %>
        <p style="color:var(--auth-muted);margin-top:8px;">No payment history yet. Enroll in a course while signed in to see it here.</p>
        <% } else { %>
        <% payments.forEach(function(p) { %>
        <div class="purchase-row">
            <div>
                <strong style="color:var(--auth-text);"><%= p.courseName || 'Course' %></strong>
                <% if (p.course && p.course.slug) { %>
                <div><a href="/courses/<%= p.course.slug %>" style="color:var(--auth-orange);font-size:0.85rem;text-decoration:none;">View course</a></div>
                <% } %>
                <div style="color:var(--auth-muted);font-size:0.8rem;margin-top:6px;">PKR <%= p.amount != null ? p.amount : '—' %> · <%= p.transactionId || '—' %></div>
            </div>
            <span class="purchase-status <%= p.status %>"><%= p.status %></span>
        </div>
        <% }); %>
        <% } %>
        <p class="auth-footer" style="margin-top:28px;"><a href="/account/settings">Settings</a> · <a href="/">Home</a></p>
    </div>
</div>
<%- include('partials/auth-layout-end') %>
