<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Our Courses | Binary Hub - Empowering the Next Generation</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@300;400;500;600&family=Space+Grotesk:wght@500;700&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --orange: #ee702b;
            --blue: #005696;
            --dark: #0a1628;
            --white: #ffffff;
            --gray-light: #f5f7fa;
            --gray-text: #6b7280;
            --radius-card: 24px;
            --shadow-card: 0 20px 60px rgba(0,0,0,0.12);
            --transition: all 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
            --gradient-primary: linear-gradient(135deg, #ee702b, #005696);
            --gradient-secondary: linear-gradient(135deg, #005696, #ee702b);
            --dark-bg: #050b16;
        }

        /* Global Reset */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            outline: none;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--white);
            color: var(--dark);
            overflow-x: hidden;
            line-height: 1.6;
        }

        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: var(--gray-light);
        }
        ::-webkit-scrollbar-thumb {
            background: var(--orange);
            border-radius: 10px;
        }

        h1, h2, h3, .bebas { font-family: 'Bebas Neue', cursive; }
        .space-grotesk { font-family: 'Space Grotesk', sans-serif; }

        /* Grain Texture */
        .noise-overlay {
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            pointer-events: none;
            z-index: 9999;
            opacity: 0.03;
            background: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
        }

        .container {
            max-width: 1300px;
            margin: 0 auto;
            padding: 0 25px;
        }

        .gradient-text {
            background: var(--gradient-primary);
            background-clip: text;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        /* Navigation Consistency with Homepage */
        nav {
            position: fixed;
            top: 0; width: 100%;
            padding: 20px 10%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            z-index: 10000;
            transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
        }

        nav.scrolled {
            background: rgba(5, 11, 22, 0.85); /* Dark background matching homepage */
            backdrop-filter: blur(20px);
            padding: 15px 10%;
            border-bottom: 1px solid rgba(255,255,255,0.05);
        }

        .logo {
            display: flex;
            align-items: center;
            height: 50px;
            transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .logo img {
            height: 100%;
            width: auto;
            object-fit: contain;
        }

        nav.scrolled .logo {
            height: 40px;
        }

        .nav-links {
            display: flex;
            gap: 30px;
            list-style: none;
        }

        .nav-links li { position: relative; }

        .nav-links a {
            text-decoration: none;
            color: white; /* Default state as on homepage */
            font-weight: 600;
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            padding-bottom: 5px;
            transition: color 0.3s;
        }

        nav.scrolled .nav-links a {
            color: white;
            opacity: 0.8;
        }

        nav.scrolled .nav-links a:hover {
            opacity: 1;
        }

        .nav-links a::after {
            content: '';
            position: absolute;
            bottom: -2px; left: 0;
            width: 0%; height: 2px;
            background: var(--orange);
            transition: 0.3s ease;
        }

        .nav-links a:hover::after, .nav-links a.active::after {
            width: 100%;
        }

        .mobile-toggle {
            display: none;
            font-size: 1.5rem;
            cursor: pointer;
            color: white;
            z-index: 10001;
            transition: color 0.3s;
        }

        /* Dropdowns */
        .dropdown { position: relative; }
        .dropdown-menu {
            position: absolute;
            top: 40px;
            left: 0;
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(16px);
            min-width: 200px;
            border-radius: 12px;
            padding: 15px 0;
            box-shadow: 0 10px 40px rgba(0,0,0,0.1);
            opacity: 0;
            visibility: hidden;
            transform: translateY(20px);
            transition: var(--transition);
        }
        .dropdown:hover .dropdown-menu {
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
        }
        .dropdown-menu a {
            display: block;
            padding: 10px 20px;
            font-size: 0.85rem;
            color: #0a1628 !important;
            opacity: 1 !important;
        }
        .dropdown-menu a::after { display: none; }
        nav.scrolled .dropdown-menu a {
            color: #0a1628 !important;
            opacity: 1 !important;
        }
        .dropdown-menu a:hover {
            background: var(--gray-light);
            color: var(--orange) !important;
        }

        /* Hero Section */
        .hero {
            min-height: 85vh;
            background: var(--dark);
            display: flex;
            align-items: center;
            position: relative;
            overflow: hidden;
            padding-top: 100px;
        }

        .hero-orbs {
            position: absolute;
            inset: 0;
            z-index: 1;
        }

        .orb {
            position: absolute;
            border-radius: 50%;
            filter: blur(80px);
            animation: float 15s infinite ease-in-out;
        }
        .orb-orange { width: 400px; height: 400px; background: var(--orange); opacity: 0.15; top: -100px; left: -100px; }
        .orb-blue { width: 500px; height: 500px; background: var(--blue); opacity: 0.12; bottom: -100px; right: -100px; animation-delay: -5s; }

        @keyframes float {
            0%, 100% { transform: translate(0, 0) scale(1); }
            50% { transform: translate(40px, 30px) scale(1.1); }
        }

        .hero-grid {
            display: grid;
            grid-template-columns: 1.2fr 0.8fr;
            align-items: center;
            position: relative;
            z-index: 2;
        }

        .hero-badge {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            padding: 8px 18px;
            border-radius: 50px;
            border: 1px solid rgba(238, 112, 43, 0.4);
            color: var(--white);
            font-size: 0.8rem;
            letter-spacing: 2px;
            text-transform: uppercase;
            margin-bottom: 25px;
            opacity: 0;
            transform: translateX(-30px);
            animation: fadeLeft 0.8s forwards 0.3s;
        }

        .pulse-dot {
            width: 8px;
            height: 8px;
            background: var(--orange);
            border-radius: 50%;
            animation: pulse 2s infinite;
        }

        @keyframes pulse {
            0% { transform: scale(1); box-shadow: 0 0 0 0 rgba(238, 112, 43, 0.7); }
            70% { transform: scale(1.2); box-shadow: 0 0 0 10px rgba(238, 112, 43, 0); }
            100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(238, 112, 43, 0); }
        }

        .hero-title {
            font-size: 6rem;
            line-height: 0.9;
            color: var(--white);
            margin-bottom: 20px;
        }

        .reveal-word {
            display: block;
            clip-path: inset(0 100% 0 0);
            animation: wordReveal 1s cubic-bezier(0.77, 0, 0.175, 1) forwards;
        }
        .reveal-word:nth-child(1) { animation-delay: 0.5s; }
        .reveal-word:nth-child(2) { animation-delay: 0.7s; }
        .reveal-word:nth-child(3) { animation-delay: 0.9s; }

        @keyframes wordReveal {
            to { clip-path: inset(0 0 0 0); }
        }

        .hero-subtext {
            color: var(--gray-text);
            font-size: 1.15rem;
            max-width: 550px;
            margin-bottom: 40px;
            opacity: 0;
            animation: fadeUp 1s forwards 1.1s;
        }

        .stats-strip {
            display: none;
         
        }

        .stat-item {
            display: flex;
            flex-direction: column;
        }
        .stat-num { font-family: 'Space Grotesk'; font-weight: 700; color: var(--orange); font-size: 1.5rem; }
        .stat-label { font-size: 0.85rem; color: var(--gray-text); text-transform: uppercase; }

        .hero-ctas {
            display: none;
            gap: 20px;
            opacity: 0;
            animation: popUp 0.8s forwards 1.5s;
        }

        .btn {
            padding: 16px 36px;
            border-radius: 50px;
            font-family: 'Space Grotesk';
            font-weight: 700;
            text-decoration: none;
            transition: var(--transition);
            display: inline-block;
            cursor: pointer;
            border: none;
        }

        .btn-primary {
            background: var(--gradient-primary);
            color: var(--white);
            box-shadow: 0 10px 25px rgba(238, 112, 43, 0.3);
        }
        .btn-primary:hover { transform: scale(1.05); box-shadow: 0 15px 35px rgba(238, 112, 43, 0.45); }

        .btn-secondary {
            border: 2px solid transparent;
            background: linear-gradient(var(--dark), var(--dark)) padding-box, var(--gradient-primary) border-box;
            color: var(--white);
        }
        .btn-secondary:hover { background: var(--gradient-primary); }

        /* Orbit display */
        .orbit-container {
            position: relative;
            width: 450px;
            height: 450px;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .center-hub {
            width: 150px;
            height: 150px;
            background: radial-gradient(circle, var(--blue), var(--orange));
            border-radius: 50%;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            color: var(--white);
            position: relative;
            z-index: 5;
            text-align: center;
        }

        .hub-ring {
            position: absolute;
            width: 100%;
            height: 100%;
            border: 2px solid var(--orange);
            border-radius: 50%;
            animation: ringGrow 3s infinite;
        }

        @keyframes ringGrow {
            0% { transform: scale(1); opacity: 1; }
            100% { transform: scale(1.5); opacity: 0; }
        }

        .orbit {
            position: absolute;
            width: 350px;
            height: 350px;
            border: 1px dashed rgba(255,255,255,0.1);
            border-radius: 50%;
            animation: rotateOrbit 30s linear infinite;
        }

        .orbit-item {
            position: absolute;
            width: 65px;
            height: 65px;
            background: var(--white);
            border-radius: 18px;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 1.5rem;
            box-shadow: 0 10px 20px rgba(0,0,0,0.2);
            animation: counterRotate 30s linear infinite;
        }

        @keyframes rotateOrbit { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
        @keyframes counterRotate { from { transform: rotate(0deg); } to { transform: rotate(-360deg); } }

        /* Wave Divider */
        .wave-divider {
            display: none !important;
            position: absolute;
            bottom: -2px;
            width: 100%;
            fill: var(--white);
        }

        /* Why Choose Strip */
        .why-choose {
            background: var(--dark);
            padding: 40px 0;
            color: var(--white);
        }

        .why-grid {
            display: none;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
        }

        .why-item {
            display: flex;
            align-items: center;
            gap: 15px;
            opacity: 0;
            transform: translateY(20px);
        }

        .why-icon {
            width: 50px;
            height: 50px;
            background: rgba(238, 112, 43, 0.15);
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
            color: var(--orange);
            font-size: 1.2rem;
            flex-shrink: 0;
        }

        .why-text h4 { font-family: 'Space Grotesk'; font-size: 0.95rem; margin-bottom: 2px; }
        .why-text p { font-size: 0.75rem; color: var(--gray-text); }

        /* Filter Bar */
        .filter-section {
            position: sticky;
            top: 75px;
            background: var(--white);
            z-index: 1000;
            padding: 20px 0;
            border-bottom: 1px solid rgba(0,0,0,0.05);
            box-shadow: 0 10px 30px rgba(0,0,0,0.02);
        }

        .filter-container {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .tabs {
            display: flex;
            gap: 10px;
            overflow-x: auto;
            scrollbar-width: none;
            padding-right: 20px;
        }
        .tabs::-webkit-scrollbar { display: none; }

        .tab {
            padding: 10px 24px;
            border-radius: 50px;
            background: transparent;
            color: var(--gray-text);
            font-weight: 600;
            font-size: 0.9rem;
            cursor: pointer;
            white-space: nowrap;
            transition: var(--transition);
            border: 1px solid transparent;
        }

        .tab.active {
            background: var(--orange);
            color: var(--white);
            box-shadow: 0 5px 15px rgba(238, 112, 43, 0.2);
        }

        .search-box {
            position: relative;
            width: 250px;
        }

        .search-box input {
            width: 100%;
            padding: 12px 20px 12px 45px;
            border-radius: 50px;
            border: 1px solid #e5e7eb;
            font-size: 0.9rem;
            transition: 0.3s;
        }
        .search-box i {
            position: absolute;
            left: 20px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--gray-text);
        }

        /* Course Grid */
        .courses-grid-section {
            padding: 100px 0;
            background: var(--gray-light);
            background-image: radial-gradient(#e5e7eb 1px, transparent 1px);
            background-size: 30px 30px;
        }

        .section-header {
            text-align: center;
            margin-bottom: 60px;
        }

        .eyebrow-orange {
            color: var(--orange);
            text-transform: uppercase;
            letter-spacing: 3px;
            font-weight: 700;
            font-size: 0.85rem;
            margin-bottom: 10px;
            display: block;
        }

        .section-title { font-size: 4rem; margin-bottom: 10px; }
        .gradient-line {
            width: 80px;
            height: 4px;
            background: var(--gradient-primary);
            margin: 0 auto 20px;
            border-radius: 10px;
        }

        .grid-container {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 32px;
        }

        .grid-container-bottom {
            margin-top: 32px;
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 32px;
            max-width: 860px;
            margin-left: auto;
            margin-right: auto;
        }

        /* Course Card */
        .course-card {
            background: var(--white);
            border-radius: var(--radius-card);
            overflow: hidden;
            box-shadow: var(--shadow-card);
            transition: var(--transition);
            position: relative;
            display: flex;
            flex-direction: column;
            opacity: 0;
            transform: translateY(40px);
        }

        .course-card:hover {
            transform: translateY(-12px);
            box-shadow: 0 30px 80px rgba(0,0,0,0.18);
        }

        .card-banner {
            height: 220px;
            position: relative;
            overflow: hidden;
        }

        .card-banner img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: 0.8s ease;
        }
        .course-card:hover .card-banner img { transform: scale(1.1); }

        .banner-overlay {
            position: absolute;
            inset: 0;
            background: linear-gradient(to bottom, transparent 40%, rgba(10, 22, 40, 0.8) 100%);
        }

        .duration-badge {
            position: absolute;
            bottom: 15px;
            left: 15px;
            background: rgba(255,255,255,0.2);
            backdrop-filter: blur(10px);
            color: var(--white);
            padding: 5px 12px;
            border-radius: 50px;
            font-size: 0.75rem;
            font-weight: 500;
        }

        .category-tag {
            position: absolute;
            top: 15px;
            right: 15px;
            background: var(--orange);
            color: var(--white);
            padding: 5px 15px;
            border-radius: 50px;
            font-size: 0.7rem;
            font-weight: 700;
            text-transform: uppercase;
        }

        .card-ribbon {
            position: absolute;
            top: 18px;
            left: -32px;
            background: var(--orange);
            color: var(--white);
            width: 130px;
            text-align: center;
            transform: rotate(-45deg);
            font-size: 0.65rem;
            font-weight: 800;
            letter-spacing: 1px;
            padding: 5px 0;
            z-index: 5;
            box-shadow: 0 4px 10px rgba(0,0,0,0.1);
        }

        .card-body {
            padding: 28px;
            flex-grow: 1;
        }

        .icon-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }

        .card-icon {
            width: 55px;
            height: 55px;
            border-radius: 15px;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 1.5rem;
            color: var(--white);
        }

        .rating { color: var(--orange); font-size: 0.8rem; font-weight: 700; }

        .card-title { font-size: 1.35rem; margin-bottom: 12px; color: var(--dark); }
        .card-desc {
            font-size: 0.9rem;
            color: var(--gray-text);
            margin-bottom: 20px;
            display: -webkit-box;
            -webkit-line-clamp: 3;
            line-clamp: 3;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .skill-tags { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 20px; }
        .skill-tag {
            border: 1px solid rgba(0, 86, 150, 0.2);
            padding: 4px 10px;
            border-radius: 6px;
            font-size: 0.7rem;
            color: var(--blue);
            font-weight: 600;
        }

        .card-divider { border: none; border-top: 1px dashed #e5e7eb; margin-bottom: 20px; }

        .price-row {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            margin-bottom: 25px;
        }

        .price-col span { display: block; font-size: 0.75rem; color: var(--gray-text); }
        .price-now { font-size: 1.6rem; font-weight: 700; color: var(--orange); font-family: 'Space Grotesk'; }
        .price-old { text-decoration: line-through; color: #9ca3af; font-size: 0.9rem; margin-left: 5px; }

        .btn-enroll {
            width: 100%;
            background: var(--gradient-primary);
            color: var(--white);
            padding: 15px;
            border-radius: 14px;
            font-weight: 700;
            border: none;
            font-family: 'Space Grotesk';
            cursor: pointer;
            transition: var(--transition);
        }
        .btn-enroll:hover { box-shadow: 0 10px 25px rgba(238, 112, 43, 0.4); transform: scale(1.02); }

        /* CTA Banner */
        .cta-banner {
            padding: 80px 0;
            background: var(--gradient-secondary);
            color: var(--white);
            position: relative;
            overflow: hidden;
        }
        .cta-content { display: flex; justify-content: space-between; align-items: center; position: relative; z-index: 2; }
        .cta-text h2 { font-size: 3rem; margin-bottom: 10px; }
        .cta-text p { font-size: 1.1rem; opacity: 0.9; }
        .cta-btns { display: flex; gap: 15px; }

        /* Enrollment Modal */
        .modal-overlay {
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.75);
            backdrop-filter: blur(8px);
            z-index: 20000;
            display: flex;
            justify-content: center;
            align-items: center;
            opacity: 0;
            visibility: hidden;
            transition: 0.3s;
        }

        .modal-overlay.active { opacity: 1; visibility: visible; }

        .modal-container {
            width: 95vw;
            max-width: 1000px;
            max-height: 90vh;
            background: var(--white);
            border-radius: 28px;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            transform: translateY(60px);
            opacity: 0;
            transition: 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }

        .modal-overlay.active .modal-container { transform: translateY(0); opacity: 1; }

        .modal-header {
            background: var(--dark);
            padding: 30px 40px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            color: var(--white);
        }

        .modal-header-left span { color: var(--orange); text-transform: uppercase; font-size: 0.75rem; font-weight: 700; letter-spacing: 2px; }
        .modal-header-left h3 { font-size: 1.8rem; }

        .close-modal {
            width: 40px;
            height: 40px;
            background: rgba(255,255,255,0.1);
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
            cursor: pointer;
            transition: 0.3s;
        }
        .close-modal:hover { background: var(--orange); }

        .modal-body {
            display: flex;
            align-items: stretch;
            overflow-y: auto;
            flex: 1;
        }

        /* Payment Panel (Left) */
        .payment-panel {
            width: 38%;
            height: 100%;
            background: linear-gradient(160deg, #0a1628 0%, #005696 100%);
            background-attachment: local;
            background-size: cover;
            padding: 40px 30px;
            color: var(--white);
            display: flex;
            flex-direction: column;
        }

        .panel-section-title {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 25px;
        }
        .panel-section-title i { color: var(--orange); }

        .summary-card {
            background: rgba(255,255,255,0.08);
            border-radius: 15px;
            padding: 20px;
            margin-bottom: 30px;
        }
        .summary-item { display: flex; justify-content: space-between; font-size: 0.85rem; margin-bottom: 10px; }
        .summary-total { margin-top: 15px; padding-top: 15px; border-top: 1px solid rgba(255,255,255,0.1); }
        .total-pkr { font-size: 1.5rem; font-weight: 700; color: var(--orange); font-family: 'Space Grotesk'; }

        .method-card {
            background: rgba(255,255,255,0.05);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 15px;
            padding: 18px;
            margin-bottom: 20px;
        }
        .method-title { font-size: 0.9rem; font-weight: 700; margin-bottom: 15px; display: block; }
        .account-field { margin-bottom: 10px; }
        .account-field label { font-size: 0.65rem; color: var(--orange); text-transform: uppercase; font-weight: 700; display: block; }
        .account-value-row { display: flex; justify-content: space-between; align-items: center; }
        .account-value { font-size: 0.85rem; font-weight: 600; font-family: monospace; }
        .copy-btn { font-size: 0.9rem; cursor: pointer; opacity: 0.7; transition: 0.3s; }
        .copy-btn:hover { opacity: 1; color: var(--orange); }

        .note-box {
            background: rgba(238, 112, 43, 0.1);
            border: 1px solid rgba(238, 112, 43, 0.3);
            border-radius: 12px;
            padding: 15px;
            font-size: 0.75rem;
            line-height: 1.4;
            color: #ffbd94;
        }

        /* Enrollment Form (Right) */
        .enroll-form-panel {
            width: 62%;
            padding: 40px;
        }

        .form-step { margin-bottom: 40px; }
        .step-header {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 25px;
            padding-bottom: 10px;
            border-bottom: 2px solid var(--gray-light);
        }
        .step-num {
            width: 28px;
            height: 28px;
            background: var(--orange);
            color: var(--white);
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
            font-weight: 700;
            font-size: 0.8rem;
        }
        .step-header h4 { font-family: 'Space Grotesk'; }

        .form-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
        }
        .form-full { grid-column: span 2; }

        .input-group { position: relative; margin-bottom: 5px; }
        .input-group input, .input-group select {
            width: 100%;
            padding: 14px 16px;
            border: 2px solid #e5e7eb;
            border-radius: 12px;
            font-family: inherit;
            font-size: 0.9rem;
            transition: 0.3s;
        }
        .input-group label {
            font-size: 0.8rem;
            font-weight: 600;
            color: var(--gray-text);
            margin-bottom: 8px;
            display: block;
        }
        .input-group input:focus { border-color: var(--orange); }

        /* Payment Radio Cards */
        .radio-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-top: 10px; }
        .radio-card {
            border: 2px solid #e5e7eb;
            border-radius: 12px;
            padding: 15px;
            display: flex;
            align-items: center;
            gap: 10px;
            cursor: pointer;
            transition: 0.3s;
        }
        .radio-card.active { border-color: var(--orange); background: rgba(238,112,43,0.05); }
        .radio-card input { display: none; }

        /* Upload Area */
        .upload-area {
            border: 2px dashed var(--orange);
            border-radius: 15px;
            padding: 25px;
            text-align: center;
            cursor: pointer;
            transition: 0.3s;
            background: rgba(238, 112, 43, 0.02);
        }
        .upload-area:hover { background: rgba(238, 112, 43, 0.05); }
        .upload-area i { font-size: 2rem; color: var(--orange); margin-bottom: 10px; }
        .upload-area p { font-size: 0.8rem; color: var(--gray-text); }
        .upload-btn {
            display: inline-block;
            margin-top: 10px;
            background: var(--orange);
            color: var(--white);
            padding: 5px 15px;
            border-radius: 5px;
            font-size: 0.75rem;
            font-weight: 600;
        }

        /* Checkboxes */
        .checkbox-group { display: flex; align-items: flex-start; gap: 10px; margin-bottom: 12px; cursor: pointer; }
        label.checkbox-group { margin: 0; font-weight: inherit; }
        .custom-check {
            width: 18px;
            height: 18px;
            border: 2px solid #d1d5db;
            border-radius: 4px;
            display: flex;
            justify-content: center;
            align-items: center;
            transition: 0.3s;
            flex-shrink: 0;
            margin-top: 3px;
        }
        .checkbox-group input { display: none; }
        .checkbox-group input:checked + .custom-check { background: var(--orange); border-color: var(--orange); }
        .checkbox-group input:checked + .custom-check::after { content: '✓'; color: white; font-size: 0.7rem; }
        .checkbox-group span { font-size: 0.75rem; color: var(--gray-text); }

        .btn-submit {
            width: 100%;
            background: var(--gradient-primary);
            color: var(--white);
            padding: 18px;
            border-radius: 15px;
            font-family: 'Space Grotesk';
            font-weight: 700;
            font-size: 1.1rem;
            border: none;
            margin-top: 20px;
            cursor: pointer;
            transition: var(--transition);
        }
        .btn-submit:disabled { background: #d1d5db; cursor: not-allowed; }
        .btn-submit:not(:disabled):hover { transform: translateY(-3px); box-shadow: 0 10px 25px rgba(238, 112, 43, 0.3); }

        /* Success State */
        .success-overlay {
            position: absolute;
            inset: 0;
            background: white;
            z-index: 10;
            display: none;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            padding: 40px;
        }
        .success-icon {
            width: 100px;
            height: 100px;
            background: #22c55e;
            color: white;
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 3rem;
            margin-bottom: 25px;
            animation: bounceIn 0.8s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }
        @keyframes bounceIn {
            0% { transform: scale(0); opacity: 0; }
            60% { transform: scale(1.1); }
            100% { transform: scale(1); opacity: 1; }
        }

        /* Footer */
        footer {
            background: var(--dark);
            color: var(--white);
            padding: 80px 0 30px;
        }

        .footer-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 40px;
            margin-bottom: 50px;
        }

        .footer-logo { font-size: 2.5rem; margin-bottom: 15px; display: inline-block; }
        .footer-col h4 { font-family: 'Space Grotesk'; font-size: 1.1rem; margin-bottom: 25px; color: var(--orange); }
        .footer-col ul { list-style: none; }
        .footer-col ul li { margin-bottom: 12px; }
        .footer-col a { color: #9ca3af; text-decoration: none; font-size: 0.9rem; transition: 0.3s; }
        .footer-col a:hover { color: var(--white); padding-left: 5px; }

        .social-links { display: flex; gap: 12px; margin-top: 20px; }
        .social-btn {
            width: 38px;
            height: 38px;
            background: rgba(255,255,255,0.05);
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
            transition: 0.3s;
            color: white;
            text-decoration: none;
        }
        .social-btn:hover { background: var(--orange); transform: translateY(-5px); }

        .footer-bottom {
            border-top: 1px solid rgba(255,255,255,0.05);
            padding-top: 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 0.8rem;
            color: #6b7280;
        }

        /* Back to top */
        #back-to-top {
            position: fixed;
            bottom: 30px;
            right: 30px;
            width: 50px;
            height: 50px;
            background: var(--gradient-primary);
            color: white;
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
            cursor: pointer;
            opacity: 0;
            visibility: hidden;
            transition: 0.3s;
            z-index: 999;
            box-shadow: 0 10px 20px rgba(0,0,0,0.2);
        }
        #back-to-top.visible { opacity: 1; visibility: visible; }

        /* Mobile Menu */
        .mobile-toggle { display: none; font-size: 1.5rem; cursor: pointer; }

        /* Responsive */
        @media (max-width: 1100px) {
            .hero-title { font-size: 4.5rem; }
            .grid-container { grid-template-columns: repeat(2, 1fr); }
            .grid-container-bottom { grid-template-columns: repeat(2, 1fr); max-width: 100%; }
        }

        @media (max-width: 900px) {
            .modal-body { flex-direction: column; }
            .payment-panel, .enroll-form-panel { width: 100%; }
            .modal-container { width: 95vw; height: 95vh; }
            .hero-grid { grid-template-columns: 1fr; text-align: center; }
            .hero-badge, .hero-subtext, .stats-strip, .hero-ctas { justify-content: center; margin-left: auto; margin-right: auto; }
            .orbit-container { display: none; }
            .why-grid { grid-template-columns: repeat(2, 1fr); }
            .footer-grid { grid-template-columns: repeat(2, 1fr); }
        }

        @media (max-width: 768px) {
            .nav-links { display: none; }
            .mobile-toggle { display: block; }
            .hero-title { font-size: 3.5rem; }
            .grid-container { grid-template-columns: 1fr; }
            .grid-container-bottom { grid-template-columns: 1fr; }
            .cta-content { flex-direction: column; text-align: center; gap: 30px; }
            .form-grid { grid-template-columns: 1fr; }
            .form-full { grid-column: span 1; }
        }

        /* Animation Helpers */
        @keyframes fadeUp { to { opacity: 1; transform: translateY(0); } }
        /* Loading Screen Synchronization */
        #loader {
            position: fixed;
            inset: 0;
            background: var(--dark-bg);
            z-index: 10002;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            transition: opacity 0.8s ease;
        }

        .loader-logo {
            width: 200px;
            opacity: 0;
            transform: scale(0.8);
            animation: logo-pop 1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }

        .loader-logo img {
            width: 100%;
            height: auto;
        }

        @keyframes logo-pop {
            to { opacity: 1; transform: scale(1); }
        }

        @keyframes fadeLeft { to { opacity: 1; transform: translateX(0); } }
        @keyframes popUp { 0% { opacity: 0; transform: scale(0.8); } 100% { opacity: 1; transform: scale(1); } }
        .show-reveal { opacity: 1 !important; transform: translateY(0) !important; transition: 0.8s cubic-bezier(0.2, 0.8, 0.2, 1); }
    </style>
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>

    <div class="noise-overlay"></div>
    <div id="scroll-progress"></div>

    <!-- Loading Screen Synchronized -->
    <div id="loader">
        <div class="loader-logo">
            <img src="/images/logo-binary.png" alt="Binary Hub Logo">
        </div>
    </div>

    <div id="scroll-progress"></div>

    <!-- Navigation Synchronized with Homepage -->
    <nav id="navbar">
        <a href="/" class="logo">
            <img src="/images/logo-binary.png" alt="Binary Hub Logo">
        </a>
        <ul class="nav-links">
            <li><a href="/">Home</a></li>
            <li class="dropdown">
                <a href="/our-mission">About Us <i class="fas fa-chevron-down" style="font-size: 0.6rem; margin-left: 5px;"></i></a>
                <div class="dropdown-menu">
                    <a href="/team">Our Team</a>
                    <a href="/our-mission">Our Mission</a>
                    <a href="/impact">Our Impact</a>
                    <a href="/branches">Our Branches</a>
                </div>
            </li>
            <li><a href="/courses" class="active">Courses</a></li>
            <li class="dropdown">
                <a href="/events">Gallery <i class="fas fa-chevron-down" style="font-size: 0.6rem; margin-left: 5px;"></i></a>
                <div class="dropdown-menu">
                    <a href="/events">Events</a>
                    <a href="/visits">Visits</a>
                </div>
            </li>
            <li><a href="/services">Services</a></li>
            <li><a href="/internships">Internships</a></li>
        </ul>
        <div class="mobile-toggle" id="mobileToggle"><i class="fas fa-bars"></i></div>
    </nav>

    <main>
        <% if (typeof successMsg !== 'undefined' && successMsg.length) { %>
        <div style="position:fixed;top:100px;left:50%;transform:translateX(-50%);z-index:100000;background:#16a34a;color:#fff;padding:14px 24px;border-radius:12px;box-shadow:0 10px 40px rgba(0,0,0,0.2);"><%= successMsg[0] %></div>
        <% } %>
        <% if (typeof errorMsg !== 'undefined' && errorMsg.length) { %>
        <div style="position:fixed;top:100px;left:50%;transform:translateX(-50%);z-index:100000;background:#dc2626;color:#fff;padding:14px 24px;border-radius:12px;"><%= errorMsg[0] %></div>
        <% } %>
        <!-- Hero Section -->
        <section class="hero">
            <div class="hero-orbs">
                <div class="orb orb-orange"></div>
                <div class="orb orb-blue"></div>
            </div>
            
            <div class="container hero-grid">
                <div class="hero-content">
                    <h1 class="hero-title">
                        <span class="reveal-word">LEARN.</span>
                        <span class="reveal-word gradient-text">BUILD.</span>
                        <span class="reveal-word">SUCCEED.</span>
                    </h1>
                    <p class="hero-subtext">
                        Join Binary Hub's industry-aligned courses crafted for the next generation of tech professionals. Learn from experts, build real projects, and launch your career.
                    </p>
                    
                    <div class="stats-strip">
                        <div class="stat-item">
                            <span class="stat-num" data-target="<%= typeof enrollmentCount !== 'undefined' ? enrollmentCount : 0 %>">0</span>
                            <span class="stat-label">Enrollments</span>
                        </div>
                        <div style="width: 1px; background: rgba(255,255,255,0.1);"></div>
                        <div class="stat-item">
                            <span class="stat-num" data-target="<%= typeof courseCount !== 'undefined' ? courseCount : 0 %>">0</span>
                            <span class="stat-label">Courses</span>
                        </div>
                        <div style="width: 1px; background: rgba(255,255,255,0.1);"></div>
                        <div class="stat-item">
                            <span class="stat-num" data-target="<%= typeof trackCount !== 'undefined' ? trackCount : 0 %>">0</span>
                            <span class="stat-label">Tracks</span>
                        </div>
                    </div>

                    <div class="hero-ctas">
                        <a href="#courses" class="btn btn-primary">Browse Courses ↓</a>
                        <a href="#" class="btn btn-secondary">Talk to Advisor</a>
                    </div>
                </div>

                <div class="hero-visual">
                    <div class="orbit-container">
                        <div class="center-hub">
                            <div class="hub-ring"></div>
                            <i class="fa-solid fa-graduation-cap" style="font-size: 3rem; margin-bottom: 5px;"></i>
                            <div style="font-family: 'Space Grotesk'; font-weight: 700;"><%= typeof courseCount !== 'undefined' ? courseCount : 0 %> COURSES</div>
                            <div style="font-size: 0.6rem; opacity: 0.8;">AVAILABLE NOW</div>
                        </div>
                        <div class="orbit">
                            <div class="orbit-item" style="top: -32.5px; left: 142.5px;"><i class="fa-solid fa-globe" style="color: #3b82f6;"></i></div>
                            <div class="orbit-item" style="top: 100px; left: 310px;"><i class="fa-solid fa-robot" style="color: #a855f7;"></i></div>
                            <div class="orbit-item" style="top: 280px; left: 230px;"><i class="fa-solid fa-palette" style="color: #f97316;"></i></div>
                            <div class="orbit-item" style="top: 280px; left: 50px;"><i class="fa-solid fa-pen-nib" style="color: #ec4899;"></i></div>
                            <div class="orbit-item" style="top: 100px; left: -30px;"><i class="fa-solid fa-mobile-screen-button" style="color: #10b981;"></i></div>
                        </div>
                    </div>
                </div>
            </div>

            <svg class="wave-divider" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 320">
                <path d="M0,192L48,176C96,160,192,128,288,128C384,128,480,160,576,186.7C672,213,768,235,864,213.3C960,192,1056,128,1152,117.3C1248,107,1344,149,1392,170.7L1440,192L1440,320L1392,320C1344,320,1248,320,1152,320C1056,320,960,320,864,320C768,320,672,320,576,320C480,320,384,320,288,320C192,320,96,320,48,320L0,320Z"></path>
            </svg>
        </section>

        <!-- Why Choose Strip -->
        <section class="why-choose">
            <div class="container why-grid">
                <div class="why-item">
                    <div class="why-icon"><i class="fa-solid fa-award"></i></div>
                    <div class="why-text">
                        <h4>Industry Certified</h4>
                        <p>Global standards</p>
                    </div>
                </div>
                <div class="why-item">
                    <div class="why-icon"><i class="fa-solid fa-user-tie"></i></div>
                    <div class="why-text">
                        <h4>Expert Mentors</h4>
                        <p>Real-world pros</p>
                    </div>
                </div>
                <div class="why-item">
                    <div class="why-icon"><i class="fa-solid fa-laptop-code"></i></div>
                    <div class="why-text">
                        <h4>Hands-On Labs</h4>
                        <p>Practice daily</p>
                    </div>
                </div>
                <div class="why-item">
                    <div class="why-icon"><i class="fa-solid fa-certificate"></i></div>
                    <div class="why-text">
                        <h4>Certifications</h4>
                        <p>Boost your CV</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Sticky Filter -->
        <section class="filter-section">
            <div class="container filter-container">
                <div class="tabs">
                    <button class="tab active" data-filter="all">All Courses</button>
                    <button class="tab" data-filter="development">Web Development</button>
                    <button class="tab" data-filter="ai">AI & ML</button>
                    <button class="tab" data-filter="design">Creative Design</button>
                    <button class="tab" data-filter="marketing">Marketing</button>
                </div>
                <div class="search-box">
                    <i class="fa-solid fa-magnifying-glass"></i>
                    <input type="text" id="courseSearch" placeholder="Search courses...">
                </div>
            </div>
        </section>

        <!-- Course Grid -->
        <section class="courses-grid-section" id="courses">
            <div class="container">
                <div class="section-header">
                    <span class="eyebrow-orange">What You'll Learn</span>
                    <h2 class="section-title">Our Courses</h2>
                    <div class="gradient-line"></div>
                    <p style="color: var(--gray-text);">Industry-relevant programs built for real-world success.</p>
                </div>

                <% const courseList = (typeof courses !== 'undefined' && courses && courses.length) ? courses : []; %>
                <div class="grid-container" id="mainGrid">
                    <% courseList.forEach(function(c) { %>
                    <article class="course-card" data-category="<%= c.category || 'all' %>">
                        <div class="card-banner">
                            <% if (c.image) { %><img src="<%= c.image %>" alt=""><% } else { %><div style="min-height:200px;background:var(--gradient-primary);"></div><% } %>
                            <div class="banner-overlay"></div>
                            <span class="duration-badge">⏱ <%= c.duration || '—' %></span>
                            <span class="category-tag">Course</span>
                        </div>
                        <div class="card-body">
                            <div class="icon-row">
                                <div class="card-icon" style="background: linear-gradient(135deg, #3b82f6, #1d4ed8);"><i class="fa-solid fa-graduation-cap"></i></div>
                            </div>
                            <h3 class="card-title space-grotesk"><%= c.name %></h3>
                            <p class="card-desc"><%= c.shortDescription || '' %></p>
                            <p style="margin:8px 0 0;"><a href="/courses/<%= c.slug %>" style="color:var(--orange);font-weight:600;text-decoration:none;">View outline →</a></p>
                            <hr class="card-divider">
                            <div class="price-row">
                                <div class="price-col">
                                    <span>Course Fee</span>
                                    <div class="price-now">PKR <%= c.feeAmount != null ? c.feeAmount : 5000 %></div>
                                </div>
                            </div>
                            <button type="button" class="btn-enroll enroll-trigger" data-name="<%= c.name %>" data-id="<%= c._id %>" data-fee="<%= c.feeAmount != null ? c.feeAmount : 5000 %>">Enroll Now</button>
                        </div>
                    </article>
                    <% }); %>
                    <% if (!courseList.length) { %>
                    <p style="grid-column: 1 / -1; text-align: center; color: var(--gray-text); padding: 48px 16px;">No courses are published yet. Check back soon.</p>
                    <% } %>
                </div>
            </div>
        </section>

        <!-- CTA Banner -->
        <section class="cta-banner">
            <div class="container cta-content">
                <div class="cta-text">
                    <h2>Not Sure Where to Start?</h2>
                    <p>Talk to our career advisors and find the perfect path for your future.</p>
                </div>
                <div class="cta-btns">
                    <button class="btn btn-primary">Book Consultation</button>
                    <button class="btn btn-secondary" style="border-color: white;">Download Brochure</button>
                </div>
            </div>
        </section>
    </main>

    <!-- Modal Overlay -->
    <div class="modal-overlay" id="enrollModal">
        <div class="modal-container">
            <div class="modal-header">
                <div class="modal-header-left">
                    <span>Enrollment Application</span>
                    <h3 id="modalCourseTitle">Course Name</h3>
                </div>
                <div class="close-modal" onclick="closeModal()">
                    <i class="fa-solid fa-xmark"></i>
                </div>
            </div>
            
            <div class="modal-body">
                <!-- Payment Panel -->
                <div class="payment-panel">
                    <div class="panel-section-title">
                        <i class="fa-solid fa-credit-card"></i>
                        <h4 class="space-grotesk">Payment Details</h4>
                    </div>

                    <div class="summary-card">
                        <div class="summary-item">
                            <span>Duration</span>
                            <span>3 Months</span>
                        </div>
                        <div class="summary-item">
                            <span>Fee Structure</span>
                            <span>One-time</span>
                        </div>
                        <div class="summary-total">
                            <div class="summary-item">
                                <span style="font-weight: 700;">Total Amount</span>
                                <span class="total-pkr">PKR 5,000</span>
                            </div>
                        </div>
                    </div>

                    <% 
                      var ps = typeof paymentSettings !== 'undefined' && paymentSettings ? paymentSettings : {};
                      var epNum = String(ps.easypaisaNumber || '').trim();
                      var epTitle = String(ps.easypaisaAccountTitle || '').trim();
                      var bName = String(ps.bankName || '').trim();
                      var bNum = String(ps.bankAccountNumber || '').trim();
                      var bTitle = String(ps.bankAccountTitle || '').trim();
                      var bIban = String(ps.bankIban || '').trim();
                      var bNotes = String(ps.additionalBankNotes || '').trim();
                      var hasBank = !!(bName || bNum || bTitle || bIban || bNotes);
                      var hasEp = !!(epNum || epTitle);
                      function escAttr(s) { return String(s).replace(/&/g,'&amp;').replace(/"/g,'&quot;'); }
                    %>
                    <% if (hasBank) { %>
                    <div class="method-card">
                        <span class="method-title">🏦 Bank Transfer</span>
                        <% if (bName) { %><div class="account-field">
                            <label>Bank Name</label>
                            <span class="account-value"><%= bName %></span>
                        </div><% } %>
                        <% if (bNum) { %><div class="account-field">
                            <label>Account Number</label>
                            <div class="account-value-row">
                                <span class="account-value" id="bankAcc"><%= bNum %></span>
                                <i class="fa-regular fa-copy copy-btn" role="button" tabindex="0" data-copy="<%= escAttr(bNum) %>" onclick="copyPaymentField(this)" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();copyPaymentField(this);}"></i>
                            </div>
                        </div><% } %>
                        <% if (bTitle) { %><div class="account-field">
                            <label>Account title</label>
                            <span class="account-value"><%= bTitle %></span>
                        </div><% } %>
                        <% if (bIban) { %><div class="account-field">
                            <label>IBAN</label>
                            <div class="account-value-row">
                                <span class="account-value"><%= bIban %></span>
                                <i class="fa-regular fa-copy copy-btn" role="button" tabindex="0" data-copy="<%= escAttr(bIban) %>" onclick="copyPaymentField(this)" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();copyPaymentField(this);}"></i>
                            </div>
                        </div><% } %>
                        <% if (bNotes) { %><div class="account-field">
                            <label>Notes</label>
                            <span class="account-value" style="white-space:pre-wrap;"><%= bNotes %></span>
                        </div><% } %>
                    </div>
                    <% } %>
                    <% if (hasEp) { %>
                    <div class="method-card">
                        <span class="method-title">📱 EasyPaisa</span>
                        <% if (epNum) { %><div class="account-field">
                            <label>Mobile Number</label>
                            <div class="account-value-row">
                                <span class="account-value"><%= epNum %></span>
                                <i class="fa-regular fa-copy copy-btn" role="button" tabindex="0" data-copy="<%= escAttr(epNum) %>" onclick="copyPaymentField(this)" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();copyPaymentField(this);}"></i>
                            </div>
                        </div><% } %>
                        <% if (epTitle) { %><div class="account-field">
                            <label>Account title</label>
                            <span class="account-value"><%= epTitle %></span>
                        </div><% } %>
                    </div>
                    <% } %>
                    <% if (!hasBank && !hasEp) { %>
                    <div class="note-box" style="margin-bottom:12px;">
                        <i class="fa-solid fa-circle-info"></i>
                        Payment receiving details are not configured yet. Please contact Binary Hub for how to pay, or try again later.
                    </div>
                    <% } %>
                    <div class="note-box">
                        <i class="fa-solid fa-triangle-exclamation"></i>
                        After payment, please upload the transaction screenshot in the form to verify your enrollment. Seats are limited.
                    </div>
                </div>

                <!-- Form Panel -->
                <div class="enroll-form-panel">
                    <form id="enrollForm" action="/courses/enroll" method="POST" enctype="multipart/form-data">
                        <input type="hidden" name="courseId" id="enrollCourseId" value="">
                        <input type="hidden" name="courseName" id="enrollCourseName" value="">
                        <input type="hidden" name="amount" id="enrollAmount" value="5000">
                        <div class="success-overlay" id="successScreen">
                            <div class="success-icon"><i class="fa-solid fa-check"></i></div>
                            <h3 class="space-grotesk" style="font-size: 2rem; margin-bottom: 10px;">Application Received!</h3>
                            <p style="color: var(--gray-text); max-width: 300px; margin-bottom: 30px;">Our team will verify your payment and contact you within 24 hours via email.</p>
                            <button type="button" class="btn btn-primary" onclick="closeModal()">Close Window</button>
                        </div>

                        <!-- Step 1 -->
                        <div class="form-step">
                            <div class="step-header">
                                <div class="step-num">01</div>
                                <h4>Personal Information</h4>
                            </div>
                            <div class="form-grid">
                                <div class="input-group">
                                    <label>Full Name *</label>
                                    <input type="text" name="studentName" placeholder="John Doe" required>
                                </div>
                                <div class="input-group">
                                    <label>Phone Number *</label>
                                    <input type="tel" name="phone" placeholder="+92 300 1234567" required>
                                </div>
                                <div class="input-group form-full">
                                    <label>Email Address *</label>
                                    <input type="email" name="email" placeholder="hello@example.com" required>
                                </div>
                                <div class="input-group">
                                    <label>Education</label>
                                    <select name="education">
                                        <option>Matric / O-Level</option>
                                        <option>Intermediate / A-Level</option>
                                        <option selected>Bachelor's</option>
                                        <option>Master's</option>
                                    </select>
                                </div>
                                <div class="input-group">
                                    <label>City</label>
                                    <input type="text" name="city" placeholder="Karachi">
                                </div>
                            </div>
                        </div>

                        <!-- Step 2 -->
                        <div class="form-step">
                            <div class="step-header">
                                <div class="step-num">02</div>
                                <h4>Payment Verification</h4>
                            </div>
                            <label style="font-size: 0.8rem; font-weight: 600; color: var(--gray-text);">Payment Method *</label>
                            <div class="radio-grid">
                                <label class="radio-card active">
                                    <input type="radio" name="payType" value="bank" checked onclick="updateRadio(this)">
                                    <i class="fa-solid fa-building-columns"></i>
                                    <span>Bank</span>
                                </label>
                                <label class="radio-card">
                                    <input type="radio" name="payType" value="easypaisa" onclick="updateRadio(this)">
                                    <i class="fa-solid fa-mobile-screen"></i>
                                    <span>EasyPaisa</span>
                                </label>
                            </div>
                            <div class="form-grid" style="margin-top: 20px;">
                                <div class="input-group">
                                    <label>Transaction ID *</label>
                                    <input type="text" name="transactionId" placeholder="Ref No / TID" required>
                                </div>
                                <div class="input-group">
                                    <label>Amount Paid</label>
                                    <input type="text" id="displayAmount" value="PKR 5,000" readonly style="background: #f9fafb;">
                                </div>
                                <div class="form-full">
                                    <label style="font-size: 0.8rem; font-weight: 600; color: var(--gray-text); margin-bottom: 8px; display: block;">Upload Screenshot *</label>
                                    <div class="upload-area" id="dropZone" onclick="document.getElementById('fileInput').click()">
                                        <i class="fa-solid fa-cloud-arrow-up"></i>
                                        <p id="fileNameDisplay">Drag & Drop or click to upload receipt</p>
                                        <span class="upload-btn">Browse File</span>
                                        <input type="file" id="fileInput" name="screenshot" hidden accept="image/*" onchange="handleFile(this)" required>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Step 3 -->
                        <div class="form-step" style="margin-bottom: 0;">
                            <label class="checkbox-group">
                                <input type="checkbox" id="terms" required>
                                <div class="custom-check"></div>
                                <span>I verify that the payment details provided are accurate.</span>
                            </label>
                            <label class="checkbox-group">
                                <input type="checkbox" id="consent" required>
                                <div class="custom-check"></div>
                                <span>I agree to receive communications from Binary Hub regarding my course.</span>
                            </label>
                            <button type="submit" class="btn-submit" id="submitBtn">Submit Enrollment Application 🎓</button>
                            <p style="text-align: center; font-size: 0.7rem; color: #9ca3af; margin-top: 15px;">
                                <i class="fa-solid fa-lock"></i> Your data is encrypted and secure.
                            </p>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <footer>
        <div class="container">
            <div class="footer-grid">
                <div class="footer-col">
                    <a href="/" class="logo footer-logo">
                        <img src="/images/logo-binary.png" alt="Binary Hub Logo" style="height: 60px;">
                    </a>
                    <p style="color: #9ca3af; font-size: 0.9rem;">Empowering the next generation with digital skills and creative innovation. Join the revolution.</p>
                    <div class="social-links">
                        <a href="#" class="social-btn"><i class="fa-brands fa-linkedin-in"></i></a>
                        <a href="#" class="social-btn"><i class="fa-brands fa-instagram"></i></a>
                        <a href="#" class="social-btn"><i class="fa-brands fa-facebook-f"></i></a>
                        <a href="#" class="social-btn"><i class="fa-brands fa-youtube"></i></a>
                    </div>
                </div>
                <div class="footer-col">
                    <h4>Quick Links</h4>
                    <ul>
                        <li><a href="/">Home</a></li>
                        <li><a href="/our-mission">About Us</a></li>
                        <li><a href="/events">Events</a></li>
                        <li><a href="/visits">Visits</a></li>
                        <li><a href="/courses">Courses</a></li>
                        <li><a href="/team">Our Team</a></li>
                        <li><a href="/services">Services</a></li>
                        <li><a href="/internships">Internships</a></li>
                    </ul>
                </div>
                <div class="footer-col">
                    <h4>Our Courses</h4>
                    <ul>
                        <li><a href="#">Web Development</a></li>
                        <li><a href="#">AI & Machine Learning</a></li>
                        <li><a href="#">UI/UX Design</a></li>
                        <li><a href="#">Digital Marketing</a></li>
                    </ul>
                </div>
                <div class="footer-col">
                    <h4>Contact Us</h4>
                    <ul>
                        <li><i class="fa-solid fa-location-dot"></i> Tech Zone, Karachi, PK</li>
                        <li><i class="fa-solid fa-phone"></i> +92 300 1234567</li>
                        <li><i class="fa-solid fa-envelope"></i> info@binaryhub.pk</li>
                    </ul>
                </div>
            </div>
            <div class="footer-bottom">
                <p>&copy; 2025 Binary Hub. All Rights Reserved.</p>
                <p>Designed with ❤️ by Binary Hub Team</p>
            </div>
        </div>
    </footer>

    <div id="backToTop"><i class="fa-solid fa-arrow-up"></i></div>

    <script>
        // Loader synchronization
        window.addEventListener('load', () => {
            setTimeout(() => {
                const loader = document.getElementById('loader');
                if (loader) {
                    loader.style.opacity = '0';
                    setTimeout(() => {
                        loader.style.display = 'none';
                    }, 800);
                }
            }, 1000);
        });

        // Navbar scroll effect
        const navbar = document.getElementById('navbar');
        const scrollProgress = document.getElementById('scroll-progress');
        const btt = document.getElementById('backToTop');

        window.addEventListener('scroll', () => {
            const winScroll = document.body.scrollTop || document.documentElement.scrollTop;
            const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
            const scrolled = (winScroll / height) * 100;
            
            if (scrollProgress) scrollProgress.style.width = scrolled + "%";

            if (winScroll > 50) navbar.classList.add('scrolled');
            else navbar.classList.remove('scrolled');

            if (winScroll > 300) {
                if (btt) {
                    btt.style.opacity = '1';
                    btt.style.visibility = 'visible';
                }
            } else {
                if (btt) {
                    btt.style.opacity = '0';
                    btt.style.visibility = 'hidden';
                }
            }
        });

        if (btt) {
            btt.onclick = () => {
                window.scrollTo({top: 0, behavior: 'smooth'});
            };
        }

        // Mobile Menu Toggle logic
        const mobileToggle = document.getElementById('mobileToggle');
        const navLinks = document.querySelector('.nav-links');

        if (mobileToggle) {
            mobileToggle.addEventListener('click', (e) => {
                e.stopPropagation();
                navLinks.classList.toggle('active');
                const icon = mobileToggle.querySelector('i');
                if (navLinks.classList.contains('active')) {
                    icon.classList.replace('fa-bars', 'fa-times');
                } else {
                    icon.classList.replace('fa-times', 'fa-bars');
                }
            });
        }

        // Dropdown toggle on mobile
        document.querySelectorAll('.dropdown > a').forEach(dropdownToggle => {
            dropdownToggle.addEventListener('click', (e) => {
                if (window.innerWidth <= 768) {
                    e.preventDefault();
                    e.stopPropagation();
                    const parent = dropdownToggle.parentElement;
                    parent.classList.toggle('open');
                }
            });
        });

        // Close menu on link click
        document.querySelectorAll('.nav-links a:not(.dropdown > a)').forEach(link => {
            link.addEventListener('click', () => {
                if (navLinks) navLinks.classList.remove('active');
                if (mobileToggle) mobileToggle.querySelector('i').classList.replace('fa-times', 'fa-bars');
                document.querySelectorAll('.dropdown').forEach(d => d.classList.remove('open'));
            });
        });

        // Close on outside click
        document.addEventListener('click', (e) => {
            if (navLinks && mobileToggle) {
                if (!navLinks.contains(e.target) && !mobileToggle.contains(e.target)) {
                    navLinks.classList.remove('active');
                    mobileToggle.querySelector('i').classList.replace('fa-times', 'fa-bars');
                }
            }
        });

        // Stat Counter
        const stats = document.querySelectorAll('.stat-num');
        const observerOptions = { threshold: 1.0 };
        const statsObserver = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if(entry.isIntersecting) {
                    const target = +entry.target.getAttribute('data-target');
                    if(target) {
                        let count = 0;
                        const timer = setInterval(() => {
                            count += Math.ceil(target / 30);
                            if(count >= target) {
                                entry.target.innerText = target + "+";
                                clearInterval(timer);
                            } else {
                                entry.target.innerText = count;
                            }
                        }, 50);
                    }
                    statsObserver.unobserve(entry.target);
                }
            });
        }, observerOptions);
        stats.forEach(s => statsObserver.observe(s));

        // Course Filtering Logic
        const tabs = document.querySelectorAll('.tab');
        const cards = document.querySelectorAll('.course-card');

        tabs.forEach(tab => {
            tab.onclick = () => {
                tabs.forEach(t => t.classList.remove('active'));
                tab.classList.add('active');
                const filter = tab.getAttribute('data-filter');
                
                cards.forEach(card => {
                    card.style.opacity = '0';
                    card.style.transform = 'scale(0.95)';
                    setTimeout(() => {
                        if(filter === 'all' || card.getAttribute('data-category') === filter) {
                            card.style.display = 'flex';
                            setTimeout(() => {
                                card.style.opacity = '1';
                                card.style.transform = 'scale(1)';
                            }, 50);
                        } else {
                            card.style.display = 'none';
                        }
                    }, 300);
                });
            };
        });

        // Search Logic
        const courseSearch = document.getElementById('courseSearch');
        if (courseSearch) {
            courseSearch.oninput = (e) => {
                const query = e.target.value.toLowerCase();
                cards.forEach(card => {
                    const titleContent = card.querySelector('.card-title');
                    if (titleContent) {
                        const title = titleContent.innerText.toLowerCase();
                        if(title.includes(query)) card.style.display = 'flex';
                        else card.style.display = 'none';
                    }
                });
            };
        }

        // Scroll Entrance Animation
        const scrollObserver = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if(entry.isIntersecting) {
                    entry.target.classList.add('show-reveal');
                }
            });
        }, { threshold: 0.1 });

        cards.forEach((c, i) => {
            c.style.transitionDelay = (i % 3) * 0.1 + 's';
            scrollObserver.observe(c);
        });
        document.querySelectorAll('.why-item').forEach((it, i) => {
            it.style.transitionDelay = i * 0.1 + 's';
            scrollObserver.observe(it);
        });

        // Modal Functions
        const modal = document.getElementById('enrollModal');
        function openEnrollModal(course, courseId, fee) {
            const modalTitle = document.getElementById('modalCourseTitle');
            if (modalTitle) modalTitle.innerText = course || 'Course';
            const idEl = document.getElementById('enrollCourseId');
            const nameEl = document.getElementById('enrollCourseName');
            const amtEl = document.getElementById('enrollAmount');
            const dispEl = document.getElementById('displayAmount');
            if (idEl) idEl.value = courseId || '';
            if (nameEl) nameEl.value = course || '';
            const f = fee != null ? Number(fee) : 5000;
            if (amtEl) amtEl.value = f;
            if (dispEl) dispEl.value = 'PKR ' + f.toLocaleString();
            if (modal) modal.classList.add('active');
            document.body.style.overflow = 'hidden';
        }
        document.querySelectorAll('.enroll-trigger').forEach(function (btn) {
            btn.addEventListener('click', function () {
                openEnrollModal(btn.getAttribute('data-name'), btn.getAttribute('data-id'), btn.getAttribute('data-fee'));
            });
        });
        function closeModal() {
            if (modal) modal.classList.remove('active');
            document.body.style.overflow = 'auto';
            // Reset success screen if closed
            setTimeout(() => {
                const successScreen = document.getElementById('successScreen');
                const enrollForm = document.getElementById('enrollForm');
                if (successScreen) successScreen.style.display = 'none';
                if (enrollForm) enrollForm.reset();
            }, 400);
        }

        // Close on overlay click
        if (modal) {
            modal.onclick = (e) => { if(e.target === modal) closeModal(); };
        }
        // Close on ESC
        window.onkeydown = (e) => { if(e.key === 'Escape') closeModal(); };

        // Radio Card Update
        function updateRadio(el) {
            document.querySelectorAll('.radio-card').forEach(c => c.classList.remove('active'));
            el.parentElement.classList.add('active');
        }

        function copyPaymentField(el) {
            const t = el && el.getAttribute('data-copy');
            if (t) copyText(t, el);
        }

        // Copy Text Function
        function copyText(text, el) {
            if (!text || !el) return;
            navigator.clipboard.writeText(text);
            const originalClass = el.className;
            el.className = 'fa-solid fa-check';
            el.style.color = '#22c55e';
            setTimeout(() => {
                el.className = originalClass;
                el.style.color = '';
            }, 2000);
        }

        // File Selection Display
        function handleFile(input) {
            if(input.files.length > 0) {
                const name = input.files[0].name;
                const display = document.getElementById('fileNameDisplay');
                const dropZone = document.getElementById('dropZone');
                if (display) display.innerText = "Selected: " + name;
                if (dropZone) dropZone.style.borderColor = "#22c55e";
            }
        }

        const enrollmentForm = document.getElementById('enrollForm');
        if (enrollmentForm) {
            enrollmentForm.addEventListener('submit', function () {
                const btn = document.getElementById('submitBtn');
                if (btn) {
                    btn.innerText = 'Submitting…';
                    btn.disabled = true;
                }
            });
        }
    </script>
</body>
</html>