<%
  pageTitle = 'Courses';
  pageDescription = 'Industry-aligned courses from Binary Hub. Learn, build projects, and launch your career.';
  activeNav = 'courses';
  extraCss = '<link rel="stylesheet" href="/css/pages.css">';
%>
<%- include('partials/head') %>
<%- include('partials/nav') %>

<main>
  <header class="bh-page-hero">
    <div class="bh-container">
      <h1>Learn skills that lead to real work.</h1>
      <p class="bh-lead">Industry-aligned courses with mentors, projects, and clear outcomes. Browse tracks and enroll when you are ready.</p>
      <div class="page-card-meta" style="margin-top:1.25rem;">
        <span class="page-chip page-chip-accent"><%= typeof enrollmentCount !== 'undefined' ? enrollmentCount : 0 %> enrollments</span>
        <span class="page-chip"><%= typeof courseCount !== 'undefined' ? courseCount : 0 %> courses</span>
        <span class="page-chip"><%= typeof trackCount !== 'undefined' ? trackCount : 0 %> tracks</span>
      </div>
    </div>
  </header>

  <section class="bh-section" style="padding-top:0;" id="courses">
    <div class="bh-container">
      <% if (typeof successMsg !== 'undefined' && successMsg.length) { %>
      <div class="bh-flash bh-flash-ok"><%= successMsg[0] %></div>
      <% } %>
      <% if (typeof errorMsg !== 'undefined' && errorMsg.length) { %>
      <div class="bh-flash bh-flash-err"><%= errorMsg[0] %></div>
      <% } %>

      <div class="page-toolbar bh-reveal">
        <div class="page-filters" id="courseFilters">
          <button type="button" class="page-filter-btn is-active" data-filter="all">All</button>
          <button type="button" class="page-filter-btn" data-filter="development">Web Development</button>
          <button type="button" class="page-filter-btn" data-filter="ai">AI &amp; ML</button>
          <button type="button" class="page-filter-btn" data-filter="design">Creative Design</button>
          <button type="button" class="page-filter-btn" data-filter="marketing">Marketing</button>
        </div>
        <div style="position:relative; min-width:min(100%,220px);">
          <i class="fas fa-search" style="position:absolute;left:0.85rem;top:50%;transform:translateY(-50%);color:var(--bh-muted);font-size:0.85rem;"></i>
          <input type="text" id="courseSearch" placeholder="Search courses..." style="width:100%;padding:0.55rem 0.9rem 0.55rem 2.25rem;border:1px solid var(--bh-line-strong);border-radius:var(--bh-radius-pill);background:var(--bh-surface);">
        </div>
      </div>

      <% const courseList = (typeof courses !== 'undefined' && courses && courses.length) ? courses : []; %>
      <div class="page-grid" id="mainGrid">
        <% courseList.forEach(function(c) { %>
        <article class="page-card bh-reveal course-card" data-category="<%= c.category || 'all' %>">
          <div class="page-card-media">
            <% if (c.image) { %>
            <img src="<%= c.image %>" alt="<%= c.name %>" loading="lazy">
            <% } else { %>
            <img src="https://picsum.photos/seed/<%= encodeURIComponent(c.slug || c.name || 'course') %>/640/400" alt="<%= c.name %>" loading="lazy">
            <% } %>
          </div>
          <div class="page-card-body">
            <div class="page-card-meta">
              <span class="page-chip"><%= c.duration || 'Flexible' %></span>
              <span class="page-chip page-chip-accent">PKR <%= c.feeAmount != null ? c.feeAmount : 5000 %></span>
            </div>
            <h3 class="card-title"><%= c.name %></h3>
            <p><%= c.shortDescription || '' %></p>
            <div style="display:flex;gap:0.5rem;flex-wrap:wrap;margin-top:0.75rem;">
              <a href="/courses/<%= c.slug %>" class="bh-btn bh-btn-secondary" style="padding:0.55rem 1rem;font-size:0.85rem;">View outline</a>
              <button type="button" class="bh-btn bh-btn-primary enroll-trigger" style="padding:0.55rem 1rem;font-size:0.85rem;" data-name="<%= c.name %>" data-id="<%= c._id %>" data-fee="<%= c.feeAmount != null ? c.feeAmount : 5000 %>">Enroll</button>
            </div>
          </div>
        </article>
        <% }); %>
        <% if (!courseList.length) { %>
        <div class="page-empty">No courses are published yet. Check back soon.</div>
        <% } %>
      </div>
    </div>
  </section>

  <%- include('partials/footer') %>
</main>

<div class="bh-modal-overlay" id="enrollModal">
  <div class="bh-modal">
    <div class="bh-modal-head">
      <div>
        <div class="eyebrow">Enrollment application</div>
        <h3 id="modalCourseTitle">Course Name</h3>
      </div>
      <button type="button" class="bh-modal-close" onclick="closeModal()" aria-label="Close"><i class="fas fa-xmark"></i></button>
    </div>
    <div class="bh-modal-body">
      <aside class="bh-modal-aside">
        <h4 style="font-size:1rem;margin-bottom:1rem;"><i class="fas fa-credit-card" style="color:var(--bh-accent);margin-right:0.4rem;"></i> Payment details</h4>
        <div class="bh-pay-summary">
          <div class="bh-pay-row"><span>Duration</span><span>3 Months</span></div>
          <div class="bh-pay-row"><span>Fee structure</span><span>One-time</span></div>
          <div class="bh-pay-row bh-pay-total"><span>Total</span><span class="total-pkr">PKR 5,000</span></div>
        </div>
        <%
          var ps = typeof paymentSettings !== 'undefined' && paymentSettings ? paymentSettings : {};
          var epNum = String(ps.easypaisaNumber || '').trim();
          var epTitle = String(ps.easypaisaAccountTitle || '').trim();
          var bName = String(ps.bankName || '').trim();
          var bNum = String(ps.bankAccountNumber || '').trim();
          var bTitle = String(ps.bankAccountTitle || '').trim();
          var bIban = String(ps.bankIban || '').trim();
          var bNotes = String(ps.additionalBankNotes || '').trim();
          var hasBank = !!(bName || bNum || bTitle || bIban || bNotes);
          var hasEp = !!(epNum || epTitle);
          function escAttr(s) { return String(s).replace(/&/g,'&amp;').replace(/"/g,'&quot;'); }
        %>
        <% if (hasBank) { %>
        <div class="bh-method-card">
          <strong style="display:block;margin-bottom:0.75rem;">Bank transfer</strong>
          <% if (bName) { %><span class="lbl">Bank name</span><div class="val-row"><span><%= bName %></span></div><% } %>
          <% if (bNum) { %><span class="lbl">Account number</span><div class="val-row"><span id="bankAcc"><%= bNum %></span><i class="fa-regular fa-copy bh-copy" role="button" tabindex="0" data-copy="<%= escAttr(bNum) %>" onclick="copyPaymentField(this)" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();copyPaymentField(this);}"></i></div><% } %>
          <% if (bTitle) { %><span class="lbl">Account title</span><div class="val-row"><span><%= bTitle %></span></div><% } %>
          <% if (bIban) { %><span class="lbl">IBAN</span><div class="val-row"><span><%= bIban %></span><i class="fa-regular fa-copy bh-copy" role="button" tabindex="0" data-copy="<%= escAttr(bIban) %>" onclick="copyPaymentField(this)" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();copyPaymentField(this);}"></i></div><% } %>
          <% if (bNotes) { %><span class="lbl">Notes</span><div class="val-row" style="font-family:inherit;white-space:pre-wrap;"><%= bNotes %></div><% } %>
        </div>
        <% } %>
        <% if (hasEp) { %>
        <div class="bh-method-card">
          <strong style="display:block;margin-bottom:0.75rem;">EasyPaisa</strong>
          <% if (epNum) { %><span class="lbl">Mobile number</span><div class="val-row"><span><%= epNum %></span><i class="fa-regular fa-copy bh-copy" role="button" tabindex="0" data-copy="<%= escAttr(epNum) %>" onclick="copyPaymentField(this)" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();copyPaymentField(this);}"></i></div><% } %>
          <% if (epTitle) { %><span class="lbl">Account title</span><div class="val-row"><span><%= epTitle %></span></div><% } %>
        </div>
        <% } %>
        <% if (!hasBank && !hasEp) { %>
        <div class="bh-note" style="margin-bottom:0.75rem;">Payment receiving details are not configured yet. Please contact Binary Hub for how to pay, or try again later.</div>
        <% } %>
        <div class="bh-note">After payment, upload the transaction screenshot in the form. Seats are limited.</div>
      </aside>

      <div class="bh-modal-main">
        <form class="form-stack" id="enrollForm" action="/courses/enroll" method="POST" enctype="multipart/form-data">
          <input type="hidden" name="courseId" id="enrollCourseId" value="">
          <input type="hidden" name="courseName" id="enrollCourseName" value="">
          <input type="hidden" name="amount" id="enrollAmount" value="5000">

          <div class="bh-success-screen" id="successScreen">
            <div class="bh-success-icon"><i class="fas fa-check"></i></div>
            <h3 style="font-size:1.5rem;margin-bottom:0.5rem;">Application received</h3>
            <p style="color:var(--bh-muted);max-width:280px;margin-bottom:1.25rem;">Our team will verify your payment and contact you within 24 hours via email.</p>
            <button type="button" class="bh-btn bh-btn-primary" onclick="closeModal()">Close</button>
          </div>

          <h4 style="font-size:0.95rem;margin-bottom:0.75rem;">Personal information</h4>
          <div class="bh-form-grid">
            <div>
              <label>Full name *</label>
              <input type="text" name="studentName" placeholder="Full name" required>
            </div>
            <div>
              <label>Phone number *</label>
              <input type="tel" name="phone" placeholder="+92 300 1234567" required>
            </div>
            <div class="bh-form-full">
              <label>Email address *</label>
              <input type="email" name="email" placeholder="hello@example.com" required>
            </div>
            <div>
              <label>Education</label>
              <select name="education">
                <option>Matric / O-Level</option>
                <option>Intermediate / A-Level</option>
                <option selected>Bachelor's</option>
                <option>Master's</option>
              </select>
            </div>
            <div>
              <label>City</label>
              <input type="text" name="city" placeholder="Karachi">
            </div>
          </div>

          <h4 style="font-size:0.95rem;margin:0.5rem 0 0.75rem;">Payment verification</h4>
          <label>Payment method *</label>
          <div class="bh-radio-grid">
            <label class="bh-radio-card is-active">
              <input type="radio" name="payType" value="bank" checked onclick="updateRadio(this)">
              <i class="fas fa-building-columns"></i>
              <span>Bank</span>
            </label>
            <label class="bh-radio-card">
              <input type="radio" name="payType" value="easypaisa" onclick="updateRadio(this)">
              <i class="fas fa-mobile-screen"></i>
              <span>EasyPaisa</span>
            </label>
          </div>
          <div class="bh-form-grid">
            <div>
              <label>Transaction ID *</label>
              <input type="text" name="transactionId" placeholder="Ref No / TID" required>
            </div>
            <div>
              <label>Amount paid</label>
              <input type="text" id="displayAmount" value="PKR 5,000" readonly style="background:var(--bh-surface-2);">
            </div>
            <div class="bh-form-full">
              <label>Upload screenshot *</label>
              <div class="bh-upload" id="dropZone" onclick="document.getElementById('fileInput').click()">
                <i class="fas fa-cloud-arrow-up"></i>
                <p id="fileNameDisplay">Click to upload receipt</p>
                <input type="file" id="fileInput" name="screenshot" hidden accept="image/*" onchange="handleFile(this)" required>
              </div>
            </div>
          </div>

          <label class="bh-check">
            <input type="checkbox" id="terms" required>
            <span>I verify that the payment details provided are accurate.</span>
          </label>
          <label class="bh-check">
            <input type="checkbox" id="consent" required>
            <span>I agree to receive communications from Binary Hub regarding my course.</span>
          </label>
          <button type="submit" class="bh-btn bh-btn-primary" id="submitBtn" style="width:100%;justify-content:center;">Submit enrollment</button>
          <p style="text-align:center;font-size:0.75rem;color:var(--bh-muted);margin-top:0.75rem;"><i class="fas fa-lock"></i> Your data is handled securely.</p>
        </form>
      </div>
    </div>
  </div>
</div>

<%
  extraJs = `
<script>
(function () {
  var filters = document.querySelectorAll('#courseFilters .page-filter-btn');
  var cards = document.querySelectorAll('.course-card');
  filters.forEach(function (btn) {
    btn.addEventListener('click', function () {
      filters.forEach(function (b) { b.classList.remove('is-active'); });
      btn.classList.add('is-active');
      var filter = btn.getAttribute('data-filter');
      cards.forEach(function (card) {
        var cat = card.getAttribute('data-category');
        card.style.display = (filter === 'all' || cat === filter) ? '' : 'none';
      });
    });
  });
  var search = document.getElementById('courseSearch');
  if (search) {
    search.addEventListener('input', function (e) {
      var q = e.target.value.toLowerCase();
      cards.forEach(function (card) {
        var title = card.querySelector('.card-title');
        var t = title ? title.innerText.toLowerCase() : '';
        card.style.display = t.indexOf(q) !== -1 ? '' : 'none';
      });
    });
  }
})();

var modal = document.getElementById('enrollModal');
function openEnrollModal(course, courseId, fee) {
  var modalTitle = document.getElementById('modalCourseTitle');
  if (modalTitle) modalTitle.innerText = course || 'Course';
  var idEl = document.getElementById('enrollCourseId');
  var nameEl = document.getElementById('enrollCourseName');
  var amtEl = document.getElementById('enrollAmount');
  var dispEl = document.getElementById('displayAmount');
  if (idEl) idEl.value = courseId || '';
  if (nameEl) nameEl.value = course || '';
  var f = fee != null ? Number(fee) : 5000;
  if (amtEl) amtEl.value = f;
  if (dispEl) dispEl.value = 'PKR ' + f.toLocaleString();
  var totalEl = document.querySelector('.total-pkr');
  if (totalEl) totalEl.textContent = 'PKR ' + f.toLocaleString();
  if (modal) modal.classList.add('is-open');
  document.body.style.overflow = 'hidden';
}
document.querySelectorAll('.enroll-trigger').forEach(function (btn) {
  btn.addEventListener('click', function () {
    openEnrollModal(btn.getAttribute('data-name'), btn.getAttribute('data-id'), btn.getAttribute('data-fee'));
  });
});
function closeModal() {
  if (modal) modal.classList.remove('is-open');
  document.body.style.overflow = '';
  setTimeout(function () {
    var successScreen = document.getElementById('successScreen');
    var enrollForm = document.getElementById('enrollForm');
    if (successScreen) successScreen.style.display = 'none';
    if (enrollForm) enrollForm.reset();
  }, 300);
}
if (modal) {
  modal.addEventListener('click', function (e) { if (e.target === modal) closeModal(); });
}
window.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeModal(); });

function updateRadio(el) {
  document.querySelectorAll('.bh-radio-card').forEach(function (c) { c.classList.remove('is-active'); });
  el.parentElement.classList.add('is-active');
}
function copyPaymentField(el) {
  var t = el && el.getAttribute('data-copy');
  if (t) copyText(t, el);
}
function copyText(text, el) {
  if (!text || !el) return;
  navigator.clipboard.writeText(text);
  var originalClass = el.className;
  el.className = 'fa-solid fa-check bh-copy';
  el.style.color = '#16a34a';
  setTimeout(function () {
    el.className = originalClass;
    el.style.color = '';
  }, 2000);
}
function handleFile(input) {
  if (input.files.length > 0) {
    var display = document.getElementById('fileNameDisplay');
    var dropZone = document.getElementById('dropZone');
    if (display) display.innerText = 'Selected: ' + input.files[0].name;
    if (dropZone) dropZone.style.borderColor = '#16a34a';
  }
}
var enrollmentForm = document.getElementById('enrollForm');
if (enrollmentForm) {
  enrollmentForm.addEventListener('submit', function () {
    var btn = document.getElementById('submitBtn');
    if (btn) {
      btn.innerText = 'Submitting...';
      btn.disabled = true;
    }
  });
}
</script>
`;
%>
<%- include('partials/scripts') %>
