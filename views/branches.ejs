<%
  pageTitle = 'Branches';
  pageDescription = 'Binary Hub locations and network sites across Pakistan.';
  activeNav = '';
  extraCss = '<link rel="stylesheet" href="/css/pages.css">';
%>
<%- include('partials/head') %>
<%- include('partials/nav') %>

<main>
  <header class="bh-page-hero">
    <div class="bh-container">
      <h1>Our branches.</h1>
      <p class="bh-lead">One mission across spaces: headquarters, youth resources, incubation, and vocational training.</p>
    </div>
  </header>

  <section class="bh-section" style="padding-top:0;">
    <div class="bh-container">
      <div class="page-grid" style="grid-template-columns:1fr;">
        <article class="page-card bh-reveal" style="flex-direction:row;max-width:720px;">
          <div class="page-card-media" style="flex:0 0 42%;aspect-ratio:auto;min-height:220px;">
            <img src="https://picsum.photos/seed/binaryhub-hq/640/480" alt="Binary Hub headquarters" loading="lazy">
          </div>
          <div class="page-card-body" style="justify-content:center;">
            <span class="page-chip page-chip-accent" style="align-self:flex-start;">HQ</span>
            <h3>Binary Hub</h3>
            <p>Visit or call for campus tours, admissions, and partnerships.</p>
            <div style="display:grid;gap:0.5rem;margin-top:0.75rem;font-size:0.9rem;color:var(--bh-ink-soft);">
              <span><i class="fas fa-location-dot" style="color:var(--bh-accent);margin-right:0.4rem;"></i> Tech Zone, Karachi, Pakistan</span>
              <span><i class="fas fa-phone" style="color:var(--bh-accent);margin-right:0.4rem;"></i> +92 300 1234567</span>
            </div>
          </div>
        </article>
      </div>
      <p style="margin-top:1.5rem;color:var(--bh-muted);font-size:0.92rem;">More branches will be listed here when announced.</p>
    </div>
  </section>

  <%- include('partials/footer') %>
</main>
<%- include('partials/scripts') %>
