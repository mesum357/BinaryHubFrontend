<%
  pageTitle = 'Events';
  pageDescription = 'Binary Hub events gallery: workshops, showcases, and community gatherings.';
  activeNav = '';
  extraCss = '<link rel="stylesheet" href="/css/pages.css">';
%>
<%- include('partials/head') %>
<%- include('partials/nav') %>

<main>
  <header class="bh-page-hero">
    <div class="bh-container">
      <h1>Moments from our community.</h1>
      <p class="bh-lead">Workshops, showcases, and gatherings that bring learners and mentors together.</p>
    </div>
  </header>

  <section class="bh-section" style="padding-top:0;">
    <div class="bh-container">
      <div class="gallery-grid">
        <% if (typeof events !== 'undefined' && events && events.length) { events.forEach(function(ev, idx) { const mainImg = ev.images && ev.images[0]; %>
        <article class="gallery-item bh-reveal">
          <% if (mainImg) { %>
          <img src="<%= mainImg %>" alt="<%= ev.name %>" loading="lazy">
          <% } else { %>
          <img src="https://picsum.photos/seed/event-<%= idx %>/640/480" alt="<%= ev.name %>" loading="lazy">
          <% } %>
          <div class="cap">
            <span class="page-chip" style="margin-bottom:0.5rem;"><%= String(idx + 1).padStart(2, '0') %></span>
            <h3><%= ev.name %></h3>
            <p><%= ev.description || '' %></p>
            <% var thumbs = (ev.images || []).slice(1, 3).filter(Boolean); %>
            <% if (thumbs.length) { %>
            <div style="display:flex;gap:0.5rem;margin-top:0.75rem;">
              <% thumbs.forEach(function(img) { %>
              <img src="<%= img %>" alt="" style="width:56px;height:56px;object-fit:cover;border-radius:8px;border:1px solid var(--bh-line);" loading="lazy">
              <% }); %>
            </div>
            <% } %>
          </div>
        </article>
        <% }); } else { %>
        <div class="page-empty">No events to show yet. Check back soon.</div>
        <% } %>
      </div>
    </div>
  </section>

  <%- include('partials/footer') %>
</main>
<%- include('partials/scripts') %>
