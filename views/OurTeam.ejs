<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Our Team | Binary Hub - Empowering the Next Generation</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:ital,wght@0,300;0,400;0,600;1,400&family=Space+Grotesk:wght@500;700&display=swap" rel="stylesheet">
    
    <!-- Font Awesome for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        :root {
            --orange: #ee702b;
            --blue: #005696;
            --dark: #0a1628;
            --white: #ffffff;
            --gray-light: #f5f7fa;
            --gray-text: #6b7280;
            --radius-card: 22px;
            --shadow-card: 0 20px 60px rgba(0,0,0,0.10);
            --transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
            --gradient-1: linear-gradient(135deg, #ee702b, #005696);
            --gradient-2: linear-gradient(135deg, #005696, #ee702b);
        }

        /* --- Global Reset & Scroll --- */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            outline: none;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--white);
            color: var(--dark);
            overflow-x: hidden;
            line-height: 1.6;
        }

        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: var(--gray-light);
        }
        ::-webkit-scrollbar-thumb {
            background: var(--orange);
            border-radius: 10px;
        }

        h1, h2, h3, .bebas { font-family: 'Bebas Neue', cursive; }
        .space-grotesk { font-family: 'Space Grotesk', sans-serif; }

        /* Grain Texture */
        .noise-overlay {
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            pointer-events: none;
            z-index: 9999;
            opacity: 0.03;
            background: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
        }

        /* Loading Screen */
        #loader {
            position: fixed;
            inset: 0;
            background: #050b16;
            z-index: 100000;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            transition: opacity 0.8s ease;
        }

        .loader-logo {
            width: 200px;
            opacity: 0;
            transform: scale(0.8);
            animation: logo-pop 1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }

        .loader-logo img {
            width: 100%;
            height: auto;
        }

        @keyframes logo-pop {
            to { opacity: 1; transform: scale(1); }
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 24px;
        }

        /* --- Utilities --- */
        .gradient-text {
            background: var(--gradient-1);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .section-padding { padding: 100px 0; }
        .reveal { opacity: 0; transform: translateY(40px); transition: var(--transition); }
        .reveal.active { opacity: 1; transform: translateY(0); }

        /* --- Navbar --- */
        #scroll-progress {
            position: fixed;
            top: 0;
            left: 0;
            height: 3px;
            background: var(--gradient-1);
            z-index: 10001;
            width: 0%;
        }

        nav {
            position: fixed;
            top: 0; width: 100%;
            padding: 20px 10%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            z-index: 10000;
            transition: var(--transition);
        }

        nav.scrolled {
            background: rgba(5, 11, 22, 0.85);
            backdrop-filter: blur(20px);
            padding: 15px 10%;
            border-bottom: 1px solid rgba(255,255,255,0.05);
        }

        .logo {
            display: flex;
            align-items: center;
            height: 50px;
            transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .logo img {
            height: 100%;
            width: auto;
            object-fit: contain;
        }

        nav.scrolled .logo {
            height: 40px;
        }

        .nav-links {
            display: flex;
            gap: 30px;
            list-style: none;
        }

        .nav-links li { position: relative; }

        .nav-links a {
            text-decoration: none;
            color: white;
            font-weight: 600;
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            padding-bottom: 5px;
            transition: color 0.3s;
        }

        nav.scrolled .nav-links a {
            color: white;
            opacity: 0.8;
        }

        nav.scrolled .nav-links a:hover {
            opacity: 1;
        }

        .nav-links a::after {
            content: '';
            position: absolute;
            bottom: -2px; left: 0;
            width: 0%; height: 2px;
            background: var(--orange);
            transition: 0.3s ease;
        }

        .nav-links a:hover::after, .nav-links a.active-link::after {
            width: 100%;
        }

        .mobile-toggle {
            display: none;
            font-size: 1.5rem;
            cursor: pointer;
            color: white;
            z-index: 10001;
            transition: color 0.3s;
        }

        /* Dropdown */
        .dropdown { position: relative; }
        .dropdown-menu {
            position: absolute;
            top: 100%; left: 0;
            background: rgba(255,255,255,0.95);
            backdrop-filter: blur(10px);
            min-width: 200px;
            padding: 15px;
            border-radius: 10px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
            opacity: 0; visibility: hidden;
            transform: translateY(20px);
            transition: var(--transition);
        }

        .dropdown:hover .dropdown-menu {
            opacity: 1; visibility: visible;
            transform: translateY(0);
        }

        .dropdown-menu a {
            display: block;
            padding: 8px 0;
            color: #555 !important; /* Ensure dropdown items stay visible on white bg */
            font-size: 0.85rem;
        }

        .dropdown-menu a:hover { color: var(--orange); padding-left: 5px; }

        /* --- Hero --- */
        .hero {
            height: 100vh;
            background: var(--dark);
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            overflow: hidden;
            padding-top: 80px;
        }

        .hero-orb {
            position: absolute;
            border-radius: 50%;
            filter: blur(100px);
            z-index: 1;
        }
        .orb-1 { width: 500px; height: 500px; background: var(--orange); opacity: 0.12; top: -100px; left: -100px; animation: float 6s ease-in-out infinite; }
        .orb-2 { width: 600px; height: 600px; background: var(--blue); opacity: 0.10; bottom: -100px; right: -100px; animation: float 8s ease-in-out infinite alternate; }

        @keyframes float {
            from { transform: translateY(-30px); }
            to { transform: translateY(0px); }
        }

        .grid-overlay {
            position: absolute;
            inset: 0;
            background-image: radial-gradient(rgba(255,255,255,0.04) 2px, transparent 2px);
            background-size: 30px 30px;
            z-index: 2;
        }

        .hero-content {
            position: relative;
            z-index: 5;
            max-width: 900px;
        }

        .hero-badge {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            padding: 8px 18px;
            border-radius: 50px;
            border: 1px solid rgba(238,112,43,0.5);
            background: rgba(238,112,43,0.08);
            color: var(--white);
            font-size: 0.8rem;
            letter-spacing: 3px;
            text-transform: uppercase;
            margin-bottom: 25px;
            opacity: 0;
            animation: fadeInDown 1s forwards 0.2s;
        }

        @keyframes fadeInDown {
            from { opacity: 0; transform: translateY(-20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .pulse-dot {
            width: 8px;
            height: 8px;
            background: var(--orange);
            border-radius: 50%;
            animation: pulse 2s infinite;
        }

        @keyframes pulse {
            0% { transform: scale(1); box-shadow: 0 0 0 0 rgba(238,112,43,0.7); }
            70% { transform: scale(1.2); box-shadow: 0 0 0 10px rgba(238,112,43,0); }
            100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(238,112,43,0); }
        }

        .hero-title {
            font-size: 7rem;
            line-height: 0.9;
            color: var(--white);
            margin-bottom: 20px;
        }

        .hero-title span {
            display: inline-block;
            clip-path: inset(0 100% 0 0);
            animation: wordReveal 1.2s cubic-bezier(0.77, 0, 0.175, 1) forwards;
        }

        @keyframes wordReveal {
            to { clip-path: inset(0 0 0 0); }
        }

        .hero-subtext {
            color: rgba(255,255,255,0.65);
            font-size: 1.1rem;
            max-width: 600px;
            margin: 0 auto 40px;
            opacity: 0;
            animation: fadeInUp 1s forwards 0.8s;
        }

        @keyframes fadeInUp {
            from { opacity: 0; transform: translateY(30px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .stats-row {
            display: none;
            align-items: center;
            gap: 30px;
            padding: 15px 30px;
            background: rgba(255,255,255,0.03);
            backdrop-filter: blur(10px);
            border-radius: 50px;
            opacity: 0;
            animation: fadeInUp 1s forwards 1.2s;
        }

        .stat-item { text-align: left; }
        .stat-num { font-size: 1.5rem; color: var(--orange); font-weight: 700; display: block; }
        .stat-label { font-size: 0.75rem; color: #9ca3af; text-transform: uppercase; }

        .hero-wave {
            display: none;
            position: absolute;
            bottom: -2px;
            width: 100%;
            fill: var(--gray-light);
            z-index: 10;
        }

        /* --- Team Section Header --- */
        .section-header {
            text-align: center;
            margin-bottom: 60px;
        }
        .header-eyebrow {
            color: var(--orange);
            text-transform: uppercase;
            letter-spacing: 3px;
            font-weight: 700;
            font-size: 0.8rem;
            margin-bottom: 10px;
            display: block;
        }
        .header-title { font-size: 2.5rem; margin-bottom: 15px; position: relative; display: inline-block; }
        .header-title::after {
            content: '';
            position: absolute;
            bottom: -5px;
            left: 50%;
            transform: translateX(-50%);
            width: 0;
            height: 4px;
            background: var(--gradient-1);
            border-radius: 2px;
            transition: 1s cubic-bezier(0.25, 0.46, 0.45, 0.94);
        }
        .reveal.active .header-title::after { width: 80px; }

        /* --- Founder Section --- */
        .founder-sub {
            background: var(--dark);
            color: var(--white);
            overflow: hidden;
            position: relative;
        }

        .founder-card {
            max-width: 780px;
            margin: 0 auto;
            background: linear-gradient(145deg, #0d1f3c, #0a1628);
            border: 1px solid rgba(238,112,43,0.3);
            border-radius: 28px;
            box-shadow: 0 40px 100px rgba(0,0,0,0.4);
            padding: 56px 64px;
            display: flex;
            gap: 50px;
            position: relative;
            z-index: 5;
            transition: var(--transition);
        }

        .founder-card:hover { transform: translateY(-5px); box-shadow: 0 50px 120px rgba(238,112,43,0.15); }

        .founder-image-area { flex: 0 0 200px; text-align: center; }
        .image-ring {
            width: 210px; height: 210px;
            border-radius: 50%;
            padding: 5px;
            background: conic-gradient(var(--orange), var(--blue), var(--orange));
            animation: spin 6s linear infinite;
            margin-bottom: 20px;
        }
        @keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
        
        .image-ring img {
            width: 100%; height: 100%;
            border-radius: 50%;
            object-fit: cover;
            border: 5px solid var(--dark);
            animation: spin 6s linear infinite reverse;
        }

        .founder-info h3 { margin-bottom: 5px; }
        .founder-role { color: var(--orange); font-style: italic; font-size: 0.9rem; }

        .founder-message { flex: 1; position: relative; }
        .quote-icon {
            font-size: 8rem; color: var(--orange); opacity: 0.2;
            position: absolute; top: -50px; left: -20px; font-family: 'Bebas Neue';
        }
        .message-text { position: relative; z-index: 2; font-size: 1rem; color: rgba(255,255,255,0.8); line-height: 1.8; margin-bottom: 25px; }

        .pull-quote {
            background: linear-gradient(135deg, rgba(238,112,43,0.15), rgba(0,86,150,0.15));
            border-left: 4px solid var(--orange);
            padding: 16px 20px;
            border-radius: 0 12px 12px 0;
            font-style: italic;
            font-size: 1.05rem;
        }

        /* --- Grid Layouts --- */
        .team-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 32px;
            max-width: 1100px;
            margin: 0 auto;
        }

        /* --- CEO Cards --- */
        .ceo-card {
            background: var(--white);
            border-radius: 24px;
            box-shadow: var(--shadow-card);
            overflow: hidden;
            position: relative;
            transition: var(--transition);
            text-align: center;
        }
        .ceo-card:hover { transform: translateY(-10px); }
        
        .ceo-banner { height: 140px; position: relative; }
        .banner-badge {
            position: absolute; top: 15px; right: 15px;
            background: rgba(255,255,255,0.15);
            color: var(--white); font-size: 0.75rem;
            padding: 4px 12px; border-radius: 50px;
        }
        .ceo-img {
            width: 100px; height: 100px;
            border-radius: 50%; border: 4px solid var(--white);
            position: absolute; bottom: -50px; left: 50%;
            transform: translateX(-50%);
            box-shadow: 0 8px 30px rgba(0,0,0,0.15);
            transition: var(--transition);
            object-fit: cover;
        }
        .ceo-card:hover .ceo-img { border-color: var(--orange); }

        .ceo-body { padding: 64px 28px 28px; }
        .ceo-name { font-size: 1.25rem; color: var(--dark); margin-bottom: 5px; }
        .ceo-role { font-size: 0.9rem; color: var(--orange); font-weight: 600; display: block; margin-bottom: 10px; }
        .ceo-bio { font-size: 0.875rem; color: var(--gray-text); margin-bottom: 15px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

        .pill {
            display: inline-block; padding: 4px 12px; border-radius: 50px;
            font-size: 0.75rem; font-weight: 600; margin: 2px;
        }
        .pill-blue { border: 1px solid var(--blue); color: var(--blue); }

        .social-row {
            display: flex; justify-content: center; gap: 10px;
            margin-top: 20px; padding-top: 15px;
            border-top: 1px solid rgba(0,0,0,0.05);
        }
        .social-circle {
            width: 32px; height: 32px; border-radius: 50%;
            background: var(--gray-light); color: var(--gray-text);
            display: flex; align-items: center; justify-content: center;
            font-size: 0.9rem; transition: 0.3s; text-decoration: none;
        }
        .social-circle:hover { background: var(--orange); color: var(--white); transform: scale(1.1); }

        /* --- Developer Cards --- */
        .dev-sub { background: var(--gray-light); }
        .dev-card {
            background: var(--white);
            border-radius: 20px;
            padding: 32px 28px;
            box-shadow: var(--shadow-card);
            position: relative;
            overflow: hidden;
            transition: var(--transition);
        }
        .dev-card::before {
            content: ''; position: absolute; top: 0; left: 0; width: 100%; height: 4px;
            background: var(--gradient-1);
        }
        .dev-card:hover { transform: translateY(-8px); }
        .code-bg {
            position: absolute; top: 10px; right: 10px;
            font-size: 4rem; font-family: 'Bebas Neue';
            color: rgba(0,86,150,0.05); z-index: 1;
        }
        .dev-profile { display: flex; align-items: center; gap: 15px; margin-bottom: 25px; }
        .dev-img-wrap {
            width: 80px; height: 80px; border-radius: 50%;
            padding: 3px; background: var(--gradient-1);
        }
        .dev-img-wrap img { width: 100%; height: 100%; border-radius: 50%; border: 3px solid var(--white); }
        .dev-role-badge { background: var(--blue); color: var(--white); font-size: 0.7rem; padding: 2px 8px; border-radius: 4px; }

        .skill-list { margin: 20px 0; display: flex; flex-wrap: wrap; gap: 5px; }
        .skill-tag { background: rgba(0,86,150,0.05); color: var(--blue); font-size: 0.75rem; padding: 3px 10px; border-radius: 4px; font-weight: 600; }

        .exp-bar-wrap { margin-top: 15px; }
        .exp-label { font-size: 0.75rem; font-weight: 600; display: flex; justify-content: space-between; margin-bottom: 5px; }
        .exp-track { height: 6px; background: #eee; border-radius: 10px; overflow: hidden; }
        .exp-fill { height: 100%; background: var(--gradient-1); width: 0; transition: 1.5s cubic-bezier(0.25, 0.46, 0.45, 0.94); }
        .reveal.active .exp-fill { width: var(--w); }

        /* --- Designer Cards --- */
        .designer-card {
            background: var(--white); border-radius: 24px;
            box-shadow: var(--shadow-card); overflow: hidden;
            transition: var(--transition); text-align: center;
        }
        .designer-card:hover { transform: translateY(-10px); }
        .design-banner { height: 80px; position: relative; }
        .design-img {
            width: 90px; height: 90px; border-radius: 50%;
            border: 3px solid var(--white); position: absolute;
            bottom: -15px; left: 50%; transform: translateX(-50%);
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }
        .design-body { padding: 55px 25px 25px; }
        .portfolio-strip {
            display: flex; justify-content: center; gap: 8px; margin: 15px 0;
        }
        .thumb { width: 40px; height: 40px; border-radius: 8px; transition: 0.3s; }
        .designer-card:hover .thumb { transform: scale(1.1); }

        /* --- Marketer Cards --- */
        .marketer-grid { grid-template-columns: repeat(4, 1fr); }
        .marketer-card {
            background: var(--white); border-radius: 20px;
            padding: 28px 20px; box-shadow: 0 10px 40px rgba(0,0,0,0.07);
            position: relative; transition: var(--transition);
        }
        .marketer-card::after {
            content: ''; position: absolute; left: 0; top: 0; height: 100%; width: 4px;
            background: var(--gradient-1);
        }
        .marketer-card:hover { transform: translateY(-6px); }
        .marketer-card:hover::after { box-shadow: 5px 0 15px rgba(238,112,43,0.3); }

        .m-profile { display: flex; align-items: center; gap: 12px; margin-bottom: 15px; }
        .m-img { width: 72px; height: 72px; border-radius: 50%; padding: 2px; }
        .m-status { display: flex; align-items: center; gap: 5px; font-size: 0.7rem; color: var(--gray-text); margin-top: 5px; }
        .status-dot { width: 6px; height: 6px; background: #10b981; border-radius: 50%; animation: pulse 2s infinite; }

        .m-stats { display: flex; gap: 10px; margin-top: 15px; }
        .m-stat-box { background: var(--gray-light); padding: 5px 10px; border-radius: 8px; flex: 1; text-align: center; }
        .m-stat-box span { display: block; font-size: 0.8rem; font-weight: 700; }
        .m-stat-box label { font-size: 0.6rem; color: var(--gray-text); text-transform: uppercase; }

        /* --- CTA Banner --- */
        .join-cta {
            background: linear-gradient(135deg, #0a1628 0%, #005696 60%, #ee702b 100%);
            color: var(--white); text-align: center; overflow: hidden;
            position: relative;
        }
        .floating-icon { position: absolute; font-size: 1.5rem; opacity: 0.3; animation: floatIcon 4s infinite linear; }
        @keyframes floatIcon {
            0% { transform: translate(0,0) rotate(0deg); }
            50% { transform: translate(15px, 15px) rotate(180deg); }
            100% { transform: translate(0,0) rotate(360deg); }
        }

        .cta-btn-row { display: flex; justify-content: center; gap: 20px; margin-top: 30px; }
        .btn-cta {
            padding: 14px 32px; border-radius: 12px; font-family: 'Space Grotesk'; font-weight: 700;
            text-decoration: none; transition: 0.3s;
        }
        .btn-white { background: var(--white); color: var(--dark); }
        .btn-white:hover { background: var(--gradient-1); color: var(--white); }
        .btn-outline { border: 1px solid var(--white); color: var(--white); }
        .btn-outline:hover { background: var(--white); color: var(--dark); }

        /* --- Footer --- */
        footer { background: var(--dark); color: var(--white); padding: 80px 0 30px; }
        .footer-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 40px; margin-bottom: 50px; }
        .footer-logo { font-size: 2.2rem; margin-bottom: 10px; display: inline-block; }
        .footer-col h4 { font-family: 'Space Grotesk'; font-size: 1.1rem; margin-bottom: 25px; color: var(--white); }
        .footer-col ul { list-style: none; }
        .footer-col ul li { margin-bottom: 12px; }
        .footer-col a { color: #9ca3af; text-decoration: none; font-size: 0.9rem; transition: 0.3s; display: inline-block; }
        .footer-col a:hover { color: var(--orange); transform: translateX(4px); }
        
        .footer-social { display: flex; gap: 12px; margin-top: 20px; }
        .f-social-btn {
            width: 40px; height: 40px; border-radius: 50%; background: rgba(255,255,255,0.08);
            display: flex; align-items: center; justify-content: center; color: white;
            text-decoration: none; transition: 0.3s;
        }
        .f-social-btn:hover { background: var(--gradient-1); transform: scale(1.1); }

        .footer-bottom {
            border-top: 1px solid rgba(255,255,255,0.08); padding-top: 30px;
            display: flex; justify-content: space-between; font-size: 0.85rem; color: #6b7280;
        }

        /* --- Back To Top --- */
        #btt {
            position: fixed; bottom: 30px; right: 30px;
            width: 50px; height: 50px; border-radius: 50%;
            background: var(--gradient-1); color: white;
            display: flex; align-items: center; justify-content: center;
            text-decoration: none; opacity: 0; visibility: hidden;
            transition: 0.3s; z-index: 9999; box-shadow: 0 5px 15px rgba(0,0,0,0.3);
        }
        #btt.active { opacity: 1; visibility: visible; animation: bounceIn 0.6s cubic-bezier(0.68, -0.55, 0.265, 1.55); }
        @keyframes bounceIn { from { transform: scale(0); } to { transform: scale(1); } }

        /* --- Responsive --- */
        @media (max-width: 1024px) {
            .team-grid { grid-template-columns: repeat(2, 1fr); padding: 0 40px; }
            .marketer-grid { grid-template-columns: repeat(2, 1fr); }
            .hero-title { font-size: 5rem; }
        }

        @media (max-width: 768px) {
            .hero-title { font-size: 3.5rem; }
            
            .mobile-toggle { display: block; }
            
            .nav-links {
                position: fixed;
                top: 0; right: -100%;
                width: 70%; height: 100vh;
                background: rgba(5, 11, 22, 0.98);
                backdrop-filter: blur(20px);
                flex-direction: column;
                justify-content: center;
                align-items: center;
                gap: 20px;
                transition: 0.5s ease-in-out;
                display: flex; /* Override display:none */
                box-shadow: -10px 0 30px rgba(0,0,0,0.3);
            }

            .nav-links.active { right: 0; }
            
            .nav-links li { width: 100%; text-align: center; }
            .nav-links a { font-size: 1.2rem; display: block; width: 100%; }

            .dropdown-menu {
                position: static;
                opacity: 1;
                visibility: visible;
                display: none;
                transform: none;
                background: rgba(255,255,255,0.03);
                box-shadow: none;
                margin-top: 10px;
                width: 100%;
            }

            .dropdown.open .dropdown-menu {
                display: block;
            }
            
            .dropdown.open > a i {
                transform: rotate(180deg);
            }

            .team-grid, .marketer-grid { grid-template-columns: 1fr; }
            .founder-card { flex-direction: column; padding: 40px 30px; text-align: center; }
            .founder-image-area { flex: 1; margin: 0 auto; }
            .footer-grid { grid-template-columns: 1fr; gap: 30px; }
            .footer-bottom { flex-direction: column; text-align: center; gap: 10px; }
            .stats-row { flex-direction: column; border-radius: 20px; }
        }
    </style>
</head>
<body>

