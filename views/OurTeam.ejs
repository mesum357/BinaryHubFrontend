<%
  pageTitle = 'Our Team';
  pageDescription = 'Meet the people behind Binary Hub: leaders, developers, designers, and marketers.';
  activeNav = '';
  extraCss = '<link rel="stylesheet" href="/css/pages.css">';
%>
<%- include('partials/head') %>
<%- include('partials/nav') %>

<main>
  <header class="bh-page-hero">
    <div class="bh-container">
      <h1>The people behind Binary Hub.</h1>
      <p class="bh-lead">Developers, designers, marketers, and leaders united by one mission: empowering the next generation through technology.</p>
      <div class="page-card-meta" style="margin-top:1.25rem;">
        <span class="page-chip page-chip-accent"><%= typeof teamCount !== 'undefined' ? teamCount : 0 %> members</span>
        <span class="page-chip"><%= typeof deptCount !== 'undefined' ? deptCount : 0 %> departments</span>
        <span class="page-chip"><%= typeof ceoCount !== 'undefined' ? ceoCount : 0 %> CEOs</span>
      </div>
    </div>
  </header>

  <section class="bh-section" style="padding-top:0;">
    <div class="bh-container">
      <div class="founder-block bh-reveal" style="margin-bottom:3rem;">
        <div>
          <img src="/images/tehseensir.jpg" alt="Tahseen Abbas - Founder">
          <h3 style="margin-top:1rem;font-size:1.2rem;">Tahseen Abbas</h3>
          <p style="color:var(--bh-accent);font-size:0.9rem;font-weight:600;">Founder, Binary Hub</p>
        </div>
        <div>
          <p class="bh-eyebrow">Leadership</p>
          <h2 style="font-size:1.5rem;margin-bottom:0.75rem;">Meet our founder</h2>
          <p style="color:var(--bh-ink-soft);line-height:1.75;">Binary Hub was born from a simple belief: that every young person deserves access to world-class technology education regardless of their background. We are not just teaching skills; we are building futures, nurturing leaders, and creating a generation that will define tomorrow's digital world.</p>
          <div class="quote-callout">"Empowerment is not a program. It is a promise."</div>
          <a href="/our-mission" class="bh-btn bh-btn-secondary" style="margin-top:1.25rem;">Read our story</a>
        </div>
      </div>

      <% const tbd = typeof teamByDept !== 'undefined' ? teamByDept : { CEO: [], Developer: [], Designer: [], Marketer: [], Other: [] }; %>

      <% if (tbd.CEO.length) { %>
      <h2 class="dept-title bh-reveal">CEO</h2>
      <div class="team-grid" style="margin-bottom:2rem;">
        <% tbd.CEO.forEach(function(m) { %>
        <article class="team-card bh-reveal">
          <% if (m.image) { %>
          <img src="<%= m.image %>" alt="<%= m.name %>" loading="lazy">
          <% } else { %>
          <img src="https://picsum.photos/seed/<%= encodeURIComponent(m.name || 'ceo') %>/400/400" alt="<%= m.name %>" loading="lazy">
          <% } %>
          <div class="body">
            <h3><%= m.name %></h3>
            <p><%= m.department || 'CEO' %></p>
            <% if (m.linkedinUrl) { %>
            <a href="<%= m.linkedinUrl %>" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn profile for <%= m.name %>" style="display:inline-flex;margin-top:0.65rem;width:2rem;height:2rem;align-items:center;justify-content:center;border-radius:50%;background:#0a66c2;color:#fff;"><i class="fab fa-linkedin-in" style="font-size:0.8rem;"></i></a>
            <% } %>
          </div>
        </article>
        <% }); %>
      </div>
      <% } %>

      <% if (tbd.Developer.length) { %>
      <h2 class="dept-title bh-reveal">Developers</h2>
      <div class="team-grid" style="margin-bottom:2rem;">
        <% tbd.Developer.forEach(function(m) { %>
        <article class="team-card bh-reveal">
          <% if (m.image) { %>
          <img src="<%= m.image %>" alt="<%= m.name %>" loading="lazy">
          <% } else { %>
          <img src="https://picsum.photos/seed/<%= encodeURIComponent(m.name || 'dev') %>/400/400" alt="<%= m.name %>" loading="lazy">
          <% } %>
          <div class="body">
            <h3><%= m.name %></h3>
            <p>Developer</p>
            <% if (m.linkedinUrl) { %>
            <a href="<%= m.linkedinUrl %>" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn profile for <%= m.name %>" style="display:inline-flex;margin-top:0.65rem;width:2rem;height:2rem;align-items:center;justify-content:center;border-radius:50%;background:#0a66c2;color:#fff;"><i class="fab fa-linkedin-in" style="font-size:0.8rem;"></i></a>
            <% } %>
          </div>
        </article>
        <% }); %>
      </div>
      <% } %>

      <% if (tbd.Designer.length) { %>
      <h2 class="dept-title bh-reveal">Designers</h2>
      <div class="team-grid" style="margin-bottom:2rem;">
        <% tbd.Designer.forEach(function(m) { %>
        <article class="team-card bh-reveal">
          <% if (m.image) { %>
          <img src="<%= m.image %>" alt="<%= m.name %>" loading="lazy">
          <% } else { %>
          <img src="https://picsum.photos/seed/<%= encodeURIComponent(m.name || 'designer') %>/400/400" alt="<%= m.name %>" loading="lazy">
          <% } %>
          <div class="body">
            <h3><%= m.name %></h3>
            <p>Designer</p>
            <% if (m.linkedinUrl) { %>
            <a href="<%= m.linkedinUrl %>" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn profile for <%= m.name %>" style="display:inline-flex;margin-top:0.65rem;width:2rem;height:2rem;align-items:center;justify-content:center;border-radius:50%;background:#0a66c2;color:#fff;"><i class="fab fa-linkedin-in" style="font-size:0.8rem;"></i></a>
            <% } %>
          </div>
        </article>
        <% }); %>
      </div>
      <% } %>

      <% if (tbd.Marketer.length) { %>
      <h2 class="dept-title bh-reveal">Marketers</h2>
      <div class="team-grid" style="margin-bottom:2rem;">
        <% tbd.Marketer.forEach(function(m) { %>
        <article class="team-card bh-reveal">
          <% if (m.image) { %>
          <img src="<%= m.image %>" alt="<%= m.name %>" loading="lazy">
          <% } else { %>
          <img src="https://picsum.photos/seed/<%= encodeURIComponent(m.name || 'marketer') %>/400/400" alt="<%= m.name %>" loading="lazy">
          <% } %>
          <div class="body">
            <h3><%= m.name %></h3>
            <p>Marketer</p>
            <% if (m.linkedinUrl) { %>
            <a href="<%= m.linkedinUrl %>" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn profile for <%= m.name %>" style="display:inline-flex;margin-top:0.65rem;width:2rem;height:2rem;align-items:center;justify-content:center;border-radius:50%;background:#0a66c2;color:#fff;"><i class="fab fa-linkedin-in" style="font-size:0.8rem;"></i></a>
            <% } %>
          </div>
        </article>
        <% }); %>
      </div>
      <% } %>

      <% if (tbd.Other.length) { %>
      <h2 class="dept-title bh-reveal">Other roles</h2>
      <div class="team-grid" style="margin-bottom:2rem;">
        <% tbd.Other.forEach(function(m) { %>
        <article class="team-card bh-reveal">
          <% if (m.image) { %>
          <img src="<%= m.image %>" alt="<%= m.name %>" loading="lazy">
          <% } else { %>
          <img src="https://picsum.photos/seed/<%= encodeURIComponent(m.name || 'team') %>/400/400" alt="<%= m.name %>" loading="lazy">
          <% } %>
          <div class="body">
            <h3><%= m.name %></h3>
            <p><%= m.department || 'Team' %></p>
            <% if (m.linkedinUrl) { %>
            <a href="<%= m.linkedinUrl %>" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn profile for <%= m.name %>" style="display:inline-flex;margin-top:0.65rem;width:2rem;height:2rem;align-items:center;justify-content:center;border-radius:50%;background:#0a66c2;color:#fff;"><i class="fab fa-linkedin-in" style="font-size:0.8rem;"></i></a>
            <% } %>
          </div>
        </article>
        <% }); %>
      </div>
      <% } %>

      <div class="detail-panel bh-reveal" style="text-align:center;padding:2.5rem 1.5rem;margin-top:1rem;">
        <p class="bh-eyebrow">We're growing</p>
        <h2 style="font-size:clamp(1.5rem,3vw,2rem);margin-bottom:0.75rem;">Want to join our team?</h2>
        <p style="color:var(--bh-ink-soft);max-width:36rem;margin:0 auto 1.5rem;">We are always looking for passionate people. Check internship openings and apply.</p>
        <a href="/internships" class="bh-btn bh-btn-primary">View internships</a>
      </div>
    </div>
  </section>

  <%- include('partials/footer') %>
</main>
<%- include('partials/scripts') %>
