<%
  pageTitle = 'Internships';
  pageDescription = 'Apply for Binary Hub internship tracks with mentorship, real projects, and career pathways.';
  activeNav = 'internships';
  extraCss = '<link rel="stylesheet" href="/css/pages.css">';
%>
<%- include('partials/head') %>
<%- include('partials/nav') %>

<main>
  <header class="bh-page-hero">
    <div class="bh-container">
      <h1>Internships that build real portfolios</h1>
      <p class="bh-lead">Join a track with mentorship, structured weeks, and work you can show. Apply below and we will follow up by email.</p>
    </div>
  </header>

  <section class="bh-section" style="padding-top:0;">
    <div class="bh-container">
      <% if (typeof successMsg !== 'undefined' && successMsg.length) { %>
      <div class="bh-flash bh-flash-ok"><%= successMsg[0] %></div>
      <% } %>
      <% if (typeof errorMsg !== 'undefined' && errorMsg.length) { %>
      <div class="bh-flash bh-flash-err"><%= errorMsg[0] %></div>
      <% } %>

      <div class="page-grid">
        <% if (typeof internships !== 'undefined' && internships && internships.length) { internships.forEach(function(int) { %>
        <article class="page-card bh-reveal">
          <div class="page-card-media">
            <% if (int.image) { %>
            <img src="<%= int.image %>" alt="<%= int.name %>" loading="lazy">
            <% } else { %>
            <img src="https://picsum.photos/seed/<%= encodeURIComponent(int.name || 'intern') %>/640/400" alt="<%= int.name %>" loading="lazy">
            <% } %>
          </div>
          <div class="page-card-body">
            <% if (int.duration) { %><div class="page-card-meta"><span class="page-chip"><%= int.duration %></span></div><% } %>
            <h3><%= int.name %></h3>
            <p><%= int.description || 'Apply to join this track and work with Binary Hub mentors.' %></p>
            <button type="button" class="bh-btn bh-btn-primary apply-int-btn" style="width:100%;margin-top:0.75rem;"
              data-name="<%= int.name %>" data-id="<%= int._id %>">
              Apply now
              <span class="bh-btn-icon"><i class="fas fa-arrow-right" style="font-size:0.75rem;"></i></span>
            </button>
          </div>
        </article>
        <% }); } else { %>
        <div class="page-empty">No internship openings are listed right now. Check back soon.</div>
        <% } %>
      </div>
    </div>
  </section>

  <%- include('partials/footer') %>
</main>

<div class="bh-modal-overlay" id="applyModal" aria-hidden="true">
  <div class="bh-modal" style="max-width:560px;" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
    <div class="bh-modal-head">
      <div>
        <div class="eyebrow">Internship application</div>
        <h3 id="modalTitle">Apply</h3>
        <p id="modalDeptLine" style="margin-top:0.35rem;font-size:0.9rem;color:var(--bh-muted);"></p>
      </div>
      <button type="button" class="bh-modal-close" id="modalClose" aria-label="Close"><i class="fas fa-xmark"></i></button>
    </div>
    <div class="bh-modal-main" style="padding:1.35rem;">
      <form class="form-stack" id="internForm" action="/internships/apply" method="POST" novalidate>
        <input type="hidden" name="internshipId" id="internshipIdField" value="">
        <label for="appName">Full name</label>
        <input type="text" id="appName" name="name" required placeholder="As on CNIC" autocomplete="name">
        <label for="appEmail">Email</label>
        <input type="email" id="appEmail" name="email" required placeholder="you@email.com" autocomplete="email">
        <label for="appPhone">Phone number</label>
        <input type="tel" id="appPhone" name="phone" required placeholder="03xx xxxxxxx" autocomplete="tel">
        <label for="appCnic">CNIC number</label>
        <input type="text" id="appCnic" name="cnic" required placeholder="xxxxx-xxxxxxx-x" pattern="[0-9]{5}-[0-9]{7}-[0-9]{1}" inputmode="numeric">
        <label for="appDept">Internship department</label>
        <select id="appDept" name="department" required>
          <option value="">Select department</option>
          <option value="Web Development">Web Development</option>
          <option value="AI & Automation">AI &amp; Automation</option>
          <option value="UI / UX Design">UI / UX Design</option>
          <option value="Graphic Design">Graphic Design</option>
          <option value="Video Editing">Video Editing</option>
          <option value="Finance & Bookkeeping">Finance &amp; Bookkeeping</option>
        </select>
        <label for="appEdu">Education</label>
        <textarea id="appEdu" name="education" required placeholder="Degree / program, institution, graduation year or expected year"></textarea>
        <button type="submit" class="bh-btn bh-btn-primary" style="width:100%;" id="internSubmit">Submit application</button>
      </form>
    </div>
  </div>
</div>

<%
  extraJs = `
<script>
(function () {
  var modal = document.getElementById('applyModal');
  var closeBtn = document.getElementById('modalClose');
  var title = document.getElementById('modalTitle');
  var deptLine = document.getElementById('modalDeptLine');
  var idField = document.getElementById('internshipIdField');
  var form = document.getElementById('internForm');
  var cnic = document.getElementById('appCnic');

  function openModal(name, id) {
    if (title) title.textContent = 'Apply';
    if (deptLine) deptLine.textContent = name ? ('Applying for: ' + name) : '';
    if (idField) idField.value = id || '';
    var appDept = document.getElementById('appDept');
    if (appDept) {
      appDept.value = '';
      var norm = function (s) { return String(s || '').replace(/\\s+/g, ' ').trim(); };
      var target = norm(name);
      for (var i = 0; i < appDept.options.length; i++) {
        var o = appDept.options[i];
        if (!o.value) continue;
        if (norm(o.text) === target || norm(o.value) === target) {
          appDept.selectedIndex = i;
          break;
        }
      }
    }
    modal.classList.add('is-open');
    modal.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }
  function closeModal() {
    modal.classList.remove('is-open');
    modal.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }
  document.querySelectorAll('.apply-int-btn').forEach(function (btn) {
    btn.addEventListener('click', function () {
      openModal(btn.getAttribute('data-name'), btn.getAttribute('data-id'));
    });
  });
  if (closeBtn) closeBtn.addEventListener('click', closeModal);
  if (modal) modal.addEventListener('click', function (e) { if (e.target === modal) closeModal(); });
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && modal.classList.contains('is-open')) closeModal();
  });
  if (form) {
    form.addEventListener('submit', function (e) {
      if (cnic && cnic.value && !/^[0-9]{5}-[0-9]{7}-[0-9]$/.test(cnic.value)) {
        e.preventDefault();
        alert('Please enter CNIC in format: 12345-1234567-1');
        return;
      }
      var btn = document.getElementById('internSubmit');
      if (btn) { btn.disabled = true; btn.textContent = 'Submitting...'; }
    });
  }
})();
</script>
`;
%>
<%- include('partials/scripts') %>
