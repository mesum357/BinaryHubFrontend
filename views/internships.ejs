<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Internships | Binary Hub</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@300;400;500;600;700&family=Space+Grotesk:wght@500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --orange: #ee702b;
            --blue: #005696;
            --dark: #0a1628;
            --white: #ffffff;
            --gray-light: #f5f7fa;
            --gray-text: #6b7280;
            --gradient: linear-gradient(135deg, #ee702b, #005696);
            --transition: all 0.45s cubic-bezier(0.25, 0.46, 0.45, 0.94);
        }
        * { margin: 0; padding: 0; box-sizing: border-box; outline: none; cursor: none; }
        html { scroll-behavior: smooth; }
        body { font-family: 'Inter', sans-serif; background: var(--white); color: var(--dark); overflow-x: hidden; }
        h1, h2, h3, .bebas { font-family: 'Bebas Neue', cursive; }
        .noise-overlay {
            position: fixed; inset: 0; pointer-events: none; z-index: 9999; opacity: 0.03;
            background: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
        }
        #cursor-glow {
            position: fixed; width: 300px; height: 300px;
            background: radial-gradient(circle, rgba(238,112,43,0.12) 0%, transparent 70%);
            border-radius: 50%; pointer-events: none; z-index: 9998; transform: translate(-50%, -50%);
        }
        #cursor-dot {
            position: fixed; width: 8px; height: 8px; background: var(--orange); border-radius: 50%;
            pointer-events: none; z-index: 10005; transform: translate(-50%, -50%);
        }
        #scroll-progress { position: fixed; top: 0; left: 0; height: 3px; background: var(--gradient); z-index: 10001; width: 0%; }

        nav {
            position: fixed; top: 0; width: 100%; padding: 20px 10%; display: flex; justify-content: space-between; align-items: center;
            z-index: 10000; transition: 0.55s;
        }
        nav.scrolled { background: rgba(5, 11, 22, 0.9); backdrop-filter: blur(20px); padding: 15px 10%; border-bottom: 1px solid rgba(255,255,255,0.05); }
        .logo { display: flex; align-items: center; height: 50px; transition: 0.5s; }
        .logo img { height: 100%; width: auto; }
        nav.scrolled .logo { height: 40px; }
        .nav-links { display: flex; gap: 28px; list-style: none; }
        .nav-links li { position: relative; }
        .nav-links a {
            text-decoration: none; color: white; font-weight: 600; font-size: 0.88rem; text-transform: uppercase;
            letter-spacing: 1px; padding-bottom: 4px; transition: opacity 0.3s;
        }
        nav.scrolled .nav-links a { opacity: 0.88; }
        .nav-links a:hover { opacity: 1; }
        .nav-links a::after {
            content: ''; position: absolute; bottom: -2px; left: 0; width: 0; height: 2px; background: var(--orange); transition: 0.3s;
        }
        .nav-links a:hover::after, .nav-links a.active::after { width: 100%; }
        .dropdown { position: relative; }
        .dropdown-menu {
            position: absolute; top: 38px; left: 0; background: rgba(255,255,255,0.97); min-width: 200px; border-radius: 12px;
            padding: 12px 0; box-shadow: 0 12px 40px rgba(0,0,0,0.12); opacity: 0; visibility: hidden; transform: translateY(14px); transition: 0.35s;
        }
        .dropdown:hover .dropdown-menu { opacity: 1; visibility: visible; transform: translateY(0); }
        .dropdown-menu a { display: block; padding: 10px 20px; font-size: 0.85rem; color: #0a1628 !important; }
        .dropdown-menu a::after { display: none; }
        .dropdown-menu a:hover { background: var(--gray-light); color: var(--orange) !important; }
        .mobile-toggle { display: none; color: white; font-size: 1.5rem; z-index: 10002; }

        .intern-hero {
            min-height: 78vh; background: linear-gradient(160deg, #050b16 0%, #0f172a 50%, #0a1628 100%);
            position: relative; overflow: hidden; display: flex; align-items: center; padding: 120px 0 90px;
        }
        .intern-hero::after {
            content: ''; position: absolute; inset: 0;
            background-image: radial-gradient(rgba(255,255,255,0.04) 1.5px, transparent 1.5px);
            background-size: 28px 28px; opacity: 0.6;
        }
        .blob {
            position: absolute; border-radius: 50%; filter: blur(70px); opacity: 0.35; animation: floaty 14s ease-in-out infinite;
        }
        .b1 { width: 400px; height: 400px; background: var(--orange); top: -80px; right: -60px; }
        .b2 { width: 360px; height: 360px; background: var(--blue); bottom: -100px; left: -40px; animation-delay: -5s; }
        @keyframes floaty {
            0%, 100% { transform: translate(0,0); }
            50% { transform: translate(20px, -25px); }
        }
        .hero-wrap { position: relative; z-index: 2; max-width: 1200px; margin: 0 auto; padding: 0 25px;
            display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: center;
        }
        .hero-copy .pill {
            display: inline-block; padding: 8px 16px; border-radius: 999px; border: 1px solid rgba(238,112,43,0.45);
            color: #e2e8f0; font-size: 0.72rem; letter-spacing: 3px; text-transform: uppercase; margin-bottom: 20px;
        }
        .hero-copy h1 { font-size: clamp(3rem, 7vw, 5.5rem); line-height: 0.95; color: white; margin-bottom: 18px; }
        .hero-copy .gradient-text {
            background: var(--gradient); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
        }
        .hero-copy p { color: #94a3b8; font-size: 1.1rem; line-height: 1.7; max-width: 480px; }
        .hero-panel {
            background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08); border-radius: 28px;
            padding: 32px; backdrop-filter: blur(12px);
        }
        .hero-panel h3 { color: white; font-family: 'Space Grotesk', sans-serif; font-size: 1.1rem; margin-bottom: 20px; }
        .perk-row { display: flex; align-items: flex-start; gap: 14px; margin-bottom: 16px; color: #cbd5e1; font-size: 0.95rem; }
        .perk-row i { color: var(--orange); margin-top: 3px; }

        .intern-grid-section { padding: 100px 0 120px; background: var(--gray-light); }
        .section-intro { text-align: center; max-width: 640px; margin: 0 auto 56px; }
        .section-intro .eyebrow { color: var(--orange); letter-spacing: 4px; font-size: 0.78rem; font-weight: 700; text-transform: uppercase; margin-bottom: 12px; display: block; }
        .section-intro h2 { font-size: clamp(2.2rem, 4vw, 3.5rem); margin-bottom: 12px; }
        .section-intro p { color: var(--gray-text); }

        .cards-wrap {
            max-width: 1200px; margin: 0 auto; padding: 0 25px;
            display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 28px;
        }
        .intern-card {
            background: white; border-radius: 22px; overflow: hidden; box-shadow: 0 16px 48px rgba(0,0,0,0.07);
            border: 1px solid rgba(0,0,0,0.04); transition: var(--transition); display: flex; flex-direction: column;
        }
        .intern-card:hover { transform: translateY(-8px); box-shadow: 0 28px 60px rgba(0,86,150,0.12); }
        .intern-card-top {
            height: 140px; position: relative; display: flex; align-items: flex-end; padding: 20px;
        }
        .intern-card-top::after {
            content: ''; position: absolute; inset: 0;
            background: linear-gradient(135deg, var(--card-a), var(--card-b)); opacity: 0.95;
        }
        .intern-card-top .ico {
            position: relative; z-index: 2; width: 52px; height: 52px; border-radius: 14px;
            background: rgba(255,255,255,0.2); display: flex; align-items: center; justify-content: center;
            font-size: 1.35rem; color: white;
        }
        .intern-card-body { padding: 22px 22px 24px; flex: 1; display: flex; flex-direction: column; }
        .intern-card-body h3 { font-family: 'Space Grotesk', sans-serif; font-size: 1.25rem; margin-bottom: 10px; }
        .intern-card-body p { color: var(--gray-text); font-size: 0.92rem; line-height: 1.6; flex: 1; margin-bottom: 18px; }
        .meta-tags { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 18px; }
        .meta-tags span {
            font-size: 0.72rem; text-transform: uppercase; letter-spacing: 1px; padding: 5px 10px;
            border-radius: 8px; background: var(--gray-light); color: #64748b; font-weight: 600;
        }
        .apply-btn {
            display: inline-flex; align-items: center; justify-content: center; gap: 10px; width: 100%;
            padding: 14px 20px; border: none; border-radius: 14px; font-weight: 700; font-size: 0.9rem;
            font-family: 'Space Grotesk', sans-serif; cursor: pointer;
            background: linear-gradient(135deg, var(--orange), #c45a24); color: white;
            transition: transform 0.2s, box-shadow 0.2s;
        }
        .apply-btn:hover { transform: scale(1.02); box-shadow: 0 12px 28px rgba(238,112,43,0.35); }

        /* Modal */
        .modal-overlay {
            position: fixed; inset: 0; background: rgba(5, 11, 22, 0.72); backdrop-filter: blur(8px);
            z-index: 20000; opacity: 0; visibility: hidden; transition: opacity 0.35s, visibility 0.35s;
            display: flex; align-items: center; justify-content: center; padding: 24px;
        }
        .modal-overlay.open { opacity: 1; visibility: visible; }
        .modal-box {
            background: white; border-radius: 24px; width: 100%; max-width: 520px; max-height: 92vh; overflow-y: auto;
            box-shadow: 0 40px 100px rgba(0,0,0,0.25); transform: translateY(24px) scale(0.98); transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .modal-overlay.open .modal-box { transform: translateY(0) scale(1); }
        .modal-head {
            padding: 26px 28px 18px; border-bottom: 1px solid #f1f5f9;
            display: flex; justify-content: space-between; align-items: flex-start; gap: 16px;
        }
        .modal-head h2 { font-family: 'Space Grotesk', sans-serif; font-size: 1.35rem; }
        .modal-head span { display: block; font-size: 0.85rem; color: var(--gray-text); font-weight: 400; margin-top: 4px; }
        .modal-close {
            width: 40px; height: 40px; border: none; border-radius: 12px; background: var(--gray-light);
            cursor: pointer; font-size: 1.1rem; color: var(--dark); transition: 0.2s;
        }
        .modal-close:hover { background: #e2e8f0; }
        .modal-form { padding: 22px 28px 32px; }
        .form-group { margin-bottom: 18px; }
        .form-group label {
            display: block; font-size: 0.78rem; font-weight: 600; text-transform: uppercase; letter-spacing: 1px;
            color: #64748b; margin-bottom: 8px;
        }
        .form-group input, .form-group select, .form-group textarea {
            width: 100%; padding: 14px 16px; border-radius: 12px; border: 1px solid #e2e8f0;
            font-family: inherit; font-size: 0.95rem; transition: border-color 0.2s, box-shadow 0.2s;
            background: #fafbfc;
        }
        .form-group input:focus, .form-group select:focus, .form-group textarea:focus {
            border-color: var(--orange); box-shadow: 0 0 0 3px rgba(238,112,43,0.15); background: white;
        }
        .form-group textarea { min-height: 88px; resize: vertical; }
        .form-row-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
        @media (max-width: 520px) { .form-row-2 { grid-template-columns: 1fr; } }

        .submit-app {
            width: 100%; padding: 16px; border: none; border-radius: 14px; font-weight: 700; font-size: 1rem;
            font-family: 'Space Grotesk', sans-serif; cursor: pointer; margin-top: 8px;
            background: linear-gradient(135deg, var(--blue), #003d6b); color: white;
            transition: transform 0.2s, box-shadow 0.2s;
        }
        .submit-app:hover { transform: translateY(-2px); box-shadow: 0 14px 32px rgba(0,86,150,0.3); }
        .submit-app:disabled { opacity: 0.65; cursor: not-allowed; transform: none; }

        .toast {
            position: fixed; bottom: 28px; left: 50%; transform: translateX(-50%) translateY(100px);
            background: #0f172a; color: white; padding: 16px 28px; border-radius: 14px; font-size: 0.95rem;
            box-shadow: 0 20px 50px rgba(0,0,0,0.25); z-index: 30000; opacity: 0; transition: 0.45s cubic-bezier(0.16, 1, 0.3, 1);
            display: flex; align-items: center; gap: 12px; max-width: 90vw;
        }
        .toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }
        .toast i { color: #4ade80; font-size: 1.25rem; }

        footer {
            background: var(--dark); color: white; padding: 70px 0 28px;
        }
        .footer-grid { max-width: 1200px; margin: 0 auto; padding: 0 25px; display: grid; grid-template-columns: repeat(4, 1fr); gap: 36px; margin-bottom: 44px; }
        .footer-col h4 { color: var(--orange); font-family: 'Space Grotesk', sans-serif; margin-bottom: 16px; font-size: 1rem; }
        .footer-col ul { list-style: none; }
        .footer-col a { color: #9ca3af; text-decoration: none; font-size: 0.9rem; }
        .footer-col a:hover { color: white; }
        .footer-bottom { max-width: 1200px; margin: 0 auto; padding: 24px 25px 0; border-top: 1px solid rgba(255,255,255,0.06);
            display: flex; justify-content: space-between; flex-wrap: wrap; gap: 10px; font-size: 0.8rem; color: #6b7280;
        }
        @media (max-width: 900px) { .footer-grid { grid-template-columns: repeat(2, 1fr); } .hero-wrap { grid-template-columns: 1fr; text-align: center; } .hero-copy p { margin: 0 auto; } }
        @media (max-width: 768px) {
            .nav-links { display: none; position: fixed; top: 0; right: 0; width: 86%; max-width: 320px; height: 100vh;
                background: #050b16; flex-direction: column; padding: 96px 28px; gap: 0; }
            .nav-links.active { display: flex; }
            .nav-links li { width: 100%; padding: 14px 0; border-bottom: 1px solid rgba(255,255,255,0.06); }
            .dropdown-menu { position: static; opacity: 1; visibility: visible; transform: none; background: transparent; box-shadow: none; padding: 8px 0 0 12px; }
            .dropdown-menu a { color: #cbd5e1 !important; }
            .mobile-toggle { display: block; }
        }

        #loader {
            position: fixed; inset: 0; background: #050b16; z-index: 10002; display: flex; align-items: center; justify-content: center; transition: opacity 0.8s;
        }
        .loader-logo { width: 200px; opacity: 0; animation: lp 1s ease forwards; }
        .loader-logo img { width: 100%; }
        @keyframes lp { to { opacity: 1; } }
        #backToTop {
            position: fixed; bottom: 28px; right: 28px; width: 48px; height: 48px; border-radius: 50%;
            background: var(--gradient); color: white; display: flex; align-items: center; justify-content: center;
            cursor: pointer; opacity: 0; visibility: hidden; transition: 0.3s; z-index: 999; box-shadow: 0 10px 24px rgba(0,0,0,0.2);
        }
        #backToTop.visible { opacity: 1; visibility: visible; }
    </style>
</head>
<body>
    <div class="noise-overlay"></div>
    <div id="cursor-glow"></div>
    <div id="cursor-dot"></div>
    <div id="scroll-progress"></div>
    <div id="loader"><div class="loader-logo"><img src="/images/logo-binary.png" alt="Binary Hub"></div></div>

    <nav id="navbar">
        <a href="/" class="logo"><img src="/images/logo-binary.png" alt="Binary Hub Logo"></a>
        <ul class="nav-links">
            <li><a href="/">Home</a></li>
            <li class="dropdown">
                <a href="/our-mission">About Us <i class="fas fa-chevron-down" style="font-size:0.6rem;margin-left:5px;"></i></a>
                <div class="dropdown-menu">
                    <a href="/team">Our Team</a>
                    <a href="/our-mission">Our Mission</a>
                    <a href="/impact">Our Impact</a>
                    <a href="/branches">Our Branches</a>
                </div>
            </li>
            <li><a href="/courses">Courses</a></li>
            <li class="dropdown">
                <a href="/events">Gallery <i class="fas fa-chevron-down" style="font-size:0.6rem;margin-left:5px;"></i></a>
                <div class="dropdown-menu">
                    <a href="/events">Events</a>
                    <a href="/visits">Visits</a>
                </div>
            </li>
            <li><a href="/services">Services</a></li>
            <li><a href="/internships" class="active">Internships</a></li>
        </ul>
        <div class="mobile-toggle" id="mobileToggle"><i class="fas fa-bars"></i></div>
    </nav>

    <header class="intern-hero">
        <div class="blob b1"></div>
        <div class="blob b2"></div>
        <div class="hero-wrap">
            <div class="hero-copy">
                <span class="pill">Hands-on experience</span>
                <h1 class="bebas">GROW WITH<br><span class="gradient-text">BINARY HUB</span></h1>
                <p>Join a cohort that ships real work — mentorship from leads, structured learning weeks, and a portfolio you can show with pride.</p>
            </div>
            <div class="hero-panel">
                <h3>What interns gain</h3>
                <div class="perk-row"><i class="fas fa-check-circle"></i><span>Weekly 1:1 feedback with department leads</span></div>
                <div class="perk-row"><i class="fas fa-check-circle"></i><span>Certificate &amp; recommendation for top performers</span></div>
                <div class="perk-row"><i class="fas fa-check-circle"></i><span>Hybrid-friendly scheduling where possible</span></div>
                <div class="perk-row"><i class="fas fa-check-circle"></i><span>Pathway to freelance and full-time roles</span></div>
            </div>
        </div>
    </header>

    <section class="intern-grid-section">
        <% if (typeof successMsg !== 'undefined' && successMsg.length) { %>
        <p style="text-align:center;color:#16a34a;font-weight:600;margin-bottom:16px;"><%= successMsg[0] %></p>
        <% } %>
        <% if (typeof errorMsg !== 'undefined' && errorMsg.length) { %>
        <p style="text-align:center;color:#dc2626;font-weight:600;margin-bottom:16px;"><%= errorMsg[0] %></p>
        <% } %>
        <div class="section-intro">
            <span class="eyebrow">Open tracks</span>
            <h2 class="bebas">Choose your department</h2>
            <p>Select a track and apply — we’ll follow up by email. Fields marked below help us place you with the right mentor.</p>
        </div>
        <div class="cards-wrap">
            <% if (typeof internships !== 'undefined' && internships && internships.length) { internships.forEach(function(int) { %>
            <article class="intern-card" style="--card-a:#ee702b;--card-b:#005696;">
                <% if (int.image) { %><div class="intern-card-top" style="background-image:url('<%= int.image %>');background-size:cover;background-position:center;"><div class="ico"><i class="fas fa-briefcase"></i></div></div><% } else { %>
                <div class="intern-card-top"><div class="ico"><i class="fas fa-briefcase"></i></div></div><% } %>
                <div class="intern-card-body">
                    <h3><%= int.name %></h3>
                    <p><%= int.description || '' %></p>
                    <div class="meta-tags"><span><%= int.duration || '' %></span></div>
                    <button type="button" class="apply-btn apply-int-btn" data-name="<%= int.name %>" data-id="<%= int._id %>"><i class="fas fa-paper-plane"></i> Apply now</button>
                </div>
            </article>
            <% }); } else { %>
            <article class="intern-card" style="--card-a:#ee702b;--card-b:#c2410c;">
                <div class="intern-card-top"><div class="ico"><i class="fas fa-code"></i></div></div>
                <div class="intern-card-body">
                    <h3>Web Development</h3>
                    <p>Frontend components, APIs, and deployment basics.</p>
                    <div class="meta-tags"><span>12 weeks</span></div>
                    <button type="button" class="apply-btn apply-int-btn" data-name="Web Development" data-id=""><i class="fas fa-paper-plane"></i> Apply now</button>
                </div>
            </article>
            <% } %>
        </div>
    </section>

    <div class="modal-overlay" id="applyModal" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
        <div class="modal-box">
            <div class="modal-head">
                <div>
                    <h2 id="modalTitle">Internship application</h2>
                    <span id="modalDeptLine">Department will appear here</span>
                </div>
                <button type="button" class="modal-close" id="modalClose" aria-label="Close"><i class="fas fa-times"></i></button>
            </div>
            <form class="modal-form" id="internForm" action="/internships/apply" method="POST" novalidate>
                <input type="hidden" name="internshipId" id="internshipIdField" value="">
                <div class="form-row-2">
                    <div class="form-group">
                        <label for="appName">Full name</label>
                        <input type="text" id="appName" name="name" required placeholder="As on CNIC" autocomplete="name">
                    </div>
                    <div class="form-group">
                        <label for="appEmail">Email</label>
                        <input type="email" id="appEmail" name="email" required placeholder="you@email.com" autocomplete="email">
                    </div>
                </div>
                <div class="form-row-2">
                    <div class="form-group">
                        <label for="appPhone">Phone number</label>
                        <input type="tel" id="appPhone" name="phone" required placeholder="+92 3xx xxxxxxx" autocomplete="tel">
                    </div>
                    <div class="form-group">
                        <label for="appCnic">CNIC number</label>
                        <input type="text" id="appCnic" name="cnic" required placeholder="xxxxx-xxxxxxx-x" pattern="[0-9]{5}-[0-9]{7}-[0-9]{1}" inputmode="numeric">
                    </div>
                </div>
                <div class="form-group">
                    <label for="appDept">Internship department</label>
                    <select id="appDept" name="department" required>
                        <option value="">Select department</option>
                        <option value="Web Development">Web Development</option>
                        <option value="AI & Automation">AI &amp; Automation</option>
                        <option value="UI / UX Design">UI / UX Design</option>
                        <option value="Graphic Design">Graphic Design</option>
                        <option value="Video Editing">Video Editing</option>
                        <option value="Finance & Bookkeeping">Finance &amp; Bookkeeping</option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="appEdu">Education</label>
                    <textarea id="appEdu" name="education" required placeholder="Degree / program, institution, graduation year or expected year"></textarea>
                </div>
                <button type="submit" class="submit-app" id="internSubmit">Submit application</button>
            </form>
        </div>
    </div>

    <div class="toast" id="toast" role="status"><i class="fas fa-circle-check"></i><span id="toastMsg">Application received.</span></div>

    <footer>
        <div class="footer-grid">
            <div class="footer-col">
                <a href="/"><img src="/images/logo-binary.png" alt="" style="height:52px;margin-bottom:12px;"></a>
                <p style="color:#9ca3af;font-size:0.9rem;">Building careers through real projects and mentorship.</p>
            </div>
            <div class="footer-col">
                <h4>Quick links</h4>
                <ul>
                    <li><a href="/">Home</a></li>
                    <li><a href="/courses">Courses</a></li>
                    <li><a href="/services">Services</a></li>
