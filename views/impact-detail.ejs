<%
  pageTitle = 'Impact';
  pageDescription = 'Binary Hub impact programs and outcomes.';
  activeNav = '';
  extraCss = '<link rel="stylesheet" href="/css/pages.css">';
%>
<%- include('partials/head') %>
<%- include('partials/nav') %>

<main>
  <div id="nf" style="display:none;">
    <header class="bh-page-hero">
      <div class="bh-container" style="text-align:center;max-width:36rem;margin-inline:auto;">
        <h1 style="max-width:none;">Impact area not found</h1>
        <p class="bh-lead" style="margin-inline:auto;">Return to the impact overview and choose a card.</p>
        <a href="/impact" class="bh-btn bh-btn-primary" style="margin-top:1.5rem;">Our Impact</a>
      </div>
    </header>
  </div>

  <div id="root" style="display:none;">
    <header class="bh-page-hero">
      <div class="bh-container">
        <p class="bh-eyebrow"><a href="/impact" style="color:inherit;text-decoration:none;">Our Impact</a> / <span id="bcTitle">...</span></p>
        <h1 id="heroTitle">...</h1>
        <div class="page-card-meta" id="statsRow" style="margin-top:1.25rem;"></div>
      </div>
    </header>
    <section class="bh-section" style="padding-top:0;">
      <div class="bh-container" style="max-width:48rem;">
        <div class="page-card" style="margin-bottom:1.5rem;">
          <div class="page-card-media" style="aspect-ratio:21/9;">
            <img id="heroImg" src="https://picsum.photos/seed/impact/960/420" alt="" loading="lazy">
          </div>
        </div>
        <div class="detail-panel" id="bodyContent"></div>
        <div style="margin-top:1.5rem;">
          <a href="/impact" class="bh-btn bh-btn-secondary"><i class="fas fa-arrow-left" style="margin-right:0.4rem;"></i> All impact areas</a>
        </div>
      </div>
    </section>
  </div>

  <%- include('partials/footer') %>
</main>

<%
  extraJs = `
<script>
(function () {
  var DATA = {
    'youth-empowerment': {
      title: 'Youth Empowerment',
      heroImage: 'https://picsum.photos/seed/youth-empowerment/960/420',
      stats: [
        { n: '500+', l: 'Youth trained' },
        { n: '40%', l: 'Scholarship seats' },
        { n: '12', l: 'Partner schools' }
      ],
      html: '<h2 style="font-size:1.35rem;margin-bottom:0.85rem;">Building confidence early</h2><p style="color:var(--bh-ink-soft);line-height:1.75;margin-bottom:0.85rem;">Our youth track combines after-school clubs, intensive holiday bootcamps, and project showcases judged by industry volunteers. We prioritize first-generation learners and provide devices where needed.</p><p style="color:var(--bh-ink-soft);line-height:1.75;margin-bottom:1rem;">Alumni return as teaching assistants, creating a flywheel of peer mentorship. Metrics we track include course completion, portfolio submissions, and internship conversion within six months of graduation.</p><h3 style="font-size:1.1rem;margin:1.25rem 0 0.65rem;">Highlights</h3><ul class="module-list"><li>Open hack nights and debug cafes in community centers</li><li>Micro-grants for capstone hardware and domain costs</li><li>Parent orientation sessions on digital careers</li></ul>'
    },
    'women-empowerment': {
      title: 'Women Empowerment',
      heroImage: 'https://picsum.photos/seed/women-empowerment/960/420',
      stats: [
        { n: '60%', l: 'Women-led teams' },
        { n: '25+', l: 'Hiring partners' },
        { n: '8', l: 'Mentorship circles' }
      ],
      html: '<h2 style="font-size:1.35rem;margin-bottom:0.85rem;">Space to lead</h2><p style="color:var(--bh-ink-soft);line-height:1.75;margin-bottom:0.85rem;">Women-only cohorts remove barriers to asking questions and claiming leadership roles in group work. We pair technical training with negotiation workshops, salary benchmarking, and interview practice.</p><p style="color:var(--bh-ink-soft);line-height:1.75;margin-bottom:1rem;">Partner companies commit to blind resume reviews and structured interview panels. Graduates join an active alumnae Slack for referrals and accountability.</p><h3 style="font-size:1.1rem;margin:1.25rem 0 0.65rem;">Highlights</h3><ul class="module-list"><li>Return-to-work fast-tracks for caregivers</li><li>Design and dev tracks with flexible evening hours</li><li>Annual Build in Public demo day with press and recruiters</li></ul>'
    },
    'tourist-promotion': {
      title: 'Tourist Promotion',
      heroImage: 'https://picsum.photos/seed/tourist-promotion/960/420',
      stats: [
        { n: '30+', l: 'Campaign assets' },
        { n: '5', l: 'Regional collabs' },
        { n: '100K', l: 'Reach (est.)' }
      ],
      html: '<h2 style="font-size:1.35rem;margin-bottom:0.85rem;">Story-first destinations</h2><p style="color:var(--bh-ink-soft);line-height:1.75;margin-bottom:0.85rem;">Learners collaborate with cultural boards and small businesses to produce ethical tourism content: short films, accessible websites, and multilingual social kits that respect local narratives.</p><p style="color:var(--bh-ink-soft);line-height:1.75;margin-bottom:1rem;">Projects emphasize low-impact travel tips, seasonal crowd management, and elevating artisans through e-commerce microsites built in Binary Hub studios.</p><h3 style="font-size:1.1rem;margin:1.25rem 0 0.65rem;">Highlights</h3><ul class="module-list"><li>Photo walks with guidelines on consent and attribution</li><li>Map UX audits for visitor centers</li><li>Student-made AR explainers for heritage sites (pilot)</li></ul>'
    },
    'vocational-center': {
      title: 'Vocational Center',
      heroImage: 'https://picsum.photos/seed/vocational-center/960/420',
      stats: [
        { n: '15', l: 'Trade modules' },
        { n: '200+', l: 'Certifications' },
        { n: '90%', l: 'Placement rate' }
      ],
      html: '<h2 style="font-size:1.35rem;margin-bottom:0.85rem;">Skills that hire tomorrow</h2><p style="color:var(--bh-ink-soft);line-height:1.75;margin-bottom:0.85rem;">The vocational center bridges traditional trades and modern tools: CNC basics with CAD, electrical safety with smart-home wiring, and hospitality with POS systems. Employers co-design assessment rubrics.</p><p style="color:var(--bh-ink-soft);line-height:1.75;margin-bottom:1rem;">Trainees clock supervised hours on real job sites through insured partnerships. Tool libraries and transport stipends reduce dropout risk.</p><h3 style="font-size:1.1rem;margin:1.25rem 0 0.65rem;">Highlights</h3><ul class="module-list"><li>OSHA-aligned safety modules</li><li>Mobile repair and solar maintenance labs</li><li>Soft skills clinic: invoices, clients, and time tracking</li></ul>'
    }
  };

  var IMPACT_ID = ${JSON.stringify(typeof impactId !== 'undefined' ? impactId : '')};

  function render() {
    var id = IMPACT_ID || new URLSearchParams(location.search).get('id') || '';
    if (!id) {
      var parts = location.pathname.split('/').filter(Boolean);
      id = parts[parts.length - 1] || '';
    }
    var d = DATA[id];
    var nf = document.getElementById('nf');
    var root = document.getElementById('root');
    if (!d) {
      document.title = 'Not found | Binary Hub';
      nf.style.display = 'block';
      root.style.display = 'none';
      return;
    }
    document.title = d.title + ' | Binary Hub';
    nf.style.display = 'none';
    root.style.display = 'block';
    document.getElementById('bcTitle').textContent = d.title;
    document.getElementById('heroTitle').textContent = d.title;
    document.getElementById('heroImg').src = d.heroImage;
    document.getElementById('heroImg').alt = d.title;
    document.getElementById('statsRow').innerHTML = d.stats.map(function (s) {
      return '<span class="page-chip page-chip-accent"><strong style="margin-right:0.35rem;">' + s.n + '</strong>' + s.l + '</span>';
    }).join('');
    document.getElementById('bodyContent').innerHTML = d.html;
  }

  render();
})();
</script>
`;
%>
<%- include('partials/scripts') %>
