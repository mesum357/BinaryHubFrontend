<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Impact | Binary Hub</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@300;400;500;600;700&family=Space+Grotesk:wght@500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --orange: #ee702b;
            --blue: #005696;
            --dark: #0a1628;
            --white: #ffffff;
            --gray-light: #f5f7fa;
            --gray-text: #6b7280;
            --gradient: linear-gradient(135deg, #ee702b, #005696);
        }
        * { margin: 0; padding: 0; box-sizing: border-box; outline: none; }
        body { font-family: 'Inter', sans-serif; background: #fff; color: var(--dark); overflow-x: hidden; line-height: 1.65; }
        h1, h2, h3, .bebas { font-family: 'Bebas Neue', cursive; }
        .noise-overlay {
            position: fixed; inset: 0; pointer-events: none; z-index: 9999; opacity: 0.03;
            background: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
        }
        
        #scroll-progress { position: fixed; top: 0; left: 0; height: 3px; background: var(--gradient); z-index: 10001; width: 0%; }
        .gradient-text {
            background: var(--gradient); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
        }

        nav {
            position: fixed; top: 0; width: 100%; padding: 20px 10%; display: flex; justify-content: space-between; align-items: center;
            z-index: 10000; transition: 0.5s;
        }
        nav.scrolled { background: rgba(5, 11, 22, 0.9); backdrop-filter: blur(20px); padding: 15px 10%; border-bottom: 1px solid rgba(255,255,255,0.05); }
        .logo { display: flex; align-items: center; height: 50px; }
        .logo img { height: 100%; width: auto; }
        nav.scrolled .logo { height: 40px; }
        .nav-links { display: flex; gap: 28px; list-style: none; }
        .nav-links li { position: relative; }
        .nav-links a {
            text-decoration: none; color: white; font-weight: 600; font-size: 0.88rem; text-transform: uppercase;
            letter-spacing: 1px; padding-bottom: 4px;
        }
        .nav-links a::after {
            content: ''; position: absolute; bottom: -2px; left: 0; width: 0; height: 2px; background: var(--orange); transition: 0.3s;
        }
        .nav-links a:hover::after, .nav-links a.active::after { width: 100%; }
        .dropdown { position: relative; }
        .dropdown-menu {
            position: absolute; top: 38px; left: 0; background: rgba(255,255,255,0.97); min-width: 210px; border-radius: 12px;
            padding: 12px 0; box-shadow: 0 14px 44px rgba(0,0,0,0.12); opacity: 0; visibility: hidden; transform: translateY(12px); transition: 0.35s;
        }
        .dropdown:hover .dropdown-menu { opacity: 1; visibility: visible; transform: translateY(0); }
        .dropdown-menu a { display: block; padding: 10px 20px; font-size: 0.85rem; color: #0a1628 !important; }
        .dropdown-menu a::after { display: none; }
        .dropdown-menu a:hover { background: var(--gray-light); color: var(--orange) !important; }
        .mobile-toggle { display: none; color: white; font-size: 1.5rem; z-index: 10002; }

        .detail-hero {
            min-height: 55vh; padding: 120px 24px 60px; position: relative; display: flex; align-items: flex-end;
            background-size: cover; background-position: center;
        }
        .detail-hero::after {
            content: ''; position: absolute; inset: 0;
            background: linear-gradient(to top, rgba(5,11,22,0.92) 0%, rgba(5,11,22,0.5) 60%, transparent 100%);
        }
        .detail-hero .inner { position: relative; z-index: 2; max-width: 900px; margin: 0 auto; width: 100%; }
        .breadcrumb { font-size: 0.75rem; letter-spacing: 2px; text-transform: uppercase; color: #94a3b8; margin-bottom: 12px; }
        .breadcrumb a { color: var(--orange); text-decoration: none; }
        .detail-hero h1 { font-size: clamp(2.5rem, 6vw, 4rem); color: white; line-height: 1; margin-bottom: 12px; }

        .stats { display: flex; flex-wrap: wrap; gap: 28px; margin-top: 20px; }
        .stat { color: white; }
        .stat strong { display: block; font-family: 'Space Grotesk', sans-serif; font-size: 1.75rem; color: var(--orange); }

        .body-sec { padding: 70px 24px 100px; max-width: 720px; margin: 0 auto; }
        .body-sec h2 { font-size: 2rem; margin-bottom: 18px; }
        .body-sec p { color: var(--gray-text); margin-bottom: 18px; font-size: 1.05rem; }
        .body-sec ul { margin: 20px 0 20px 22px; color: var(--gray-text); }
        .body-sec li { margin-bottom: 10px; }

        .cta { text-align: center; padding: 40px 24px 80px; }
        .cta a {
            display: inline-flex; align-items: center; gap: 10px; padding: 14px 28px; border-radius: 999px;
            background: var(--gradient); color: white; text-decoration: none; font-weight: 700; font-size: 0.9rem;
        }

        #nf { display: none; padding: 140px 24px; text-align: center; }
        #nf.visible { display: block; }
        #root { display: none; }
        #root.visible { display: block; }

        footer {
            background: var(--dark); color: white; padding: 50px 24px 24px; font-size: 0.85rem; color: #9ca3af; text-align: center;
        }
        footer a { color: var(--orange); text-decoration: none; }

        #loader { position: fixed; inset: 0; background: #050b16; z-index: 10002; display: flex; align-items: center; justify-content: center; transition: opacity 0.7s; }
        .loader-logo { width: 180px; }
        .loader-logo img { width: 100%; }

        @media (max-width: 768px) {
            .nav-links { display: none; position: fixed; top: 0; right: 0; width: 86%; max-width: 320px; height: 100vh;
                background: #050b16; flex-direction: column; padding: 96px 26px; gap: 0; }
            .nav-links.active { display: flex; }
            .nav-links li { width: 100%; padding: 14px 0; border-bottom: 1px solid rgba(255,255,255,0.06); }
            .dropdown-menu { position: static; opacity: 1; visibility: visible; transform: none; box-shadow: none; background: transparent; padding: 8px 0 0 12px; }
            .dropdown-menu a { color: #cbd5e1 !important; }
            .mobile-toggle { display: block; }
        }
    </style>
</head>
<body>
    <div class="noise-overlay"></div>
    <div id="scroll-progress"></div>
    <div id="loader"><div class="loader-logo"><img src="/images/logo-binary.png" alt=""></div></div>

    <nav id="navbar">
        <a href="/" class="logo"><img src="/images/logo-binary.png" alt=""></a>
        <ul class="nav-links">
            <li><a href="/">Home</a></li>
            <li class="dropdown">
                <a href="/our-mission" class="active">About Us <i class="fas fa-chevron-down" style="font-size:0.6rem;margin-left:5px;"></i></a>
                <div class="dropdown-menu">
                    <a href="/team">Our Team</a>
                    <a href="/our-mission">Our Mission</a>
                    <a href="/impact">Our Impact</a>
                    <a href="/branches">Our Branches</a>
                </div>
            </li>
            <li><a href="/courses">Courses</a></li>
            <li class="dropdown">
                <a href="/events">Gallery <i class="fas fa-chevron-down" style="font-size:0.6rem;margin-left:5px;"></i></a>
                <div class="dropdown-menu">
                    <a href="/events">Events</a>
                    <a href="/visits">Visits</a>
                </div>
            </li>
            <li><a href="/services">Services</a></li>
            <li><a href="/internships">Internships</a></li>
        </ul>
        <div class="mobile-toggle" id="mobileToggle"><i class="fas fa-bars"></i></div>
    </nav>

    <div id="nf">
        <h1 class="bebas" style="font-size:2.5rem;margin-bottom:12px;">Impact area not found</h1>
        <p style="color:var(--gray-text);margin-bottom:20px;">Return to the impact overview and choose a card.</p>
        <a href="/impact" style="display:inline-block;padding:12px 24px;background:var(--orange);color:white;border-radius:999px;text-decoration:none;font-weight:600;">Our Impact</a>
    </div>

    <div id="root">
        <header class="detail-hero" id="heroBg">
            <div class="inner">
                <p class="breadcrumb"><a href="/impact">Our Impact</a> / <span id="bcTitle">—</span></p>
                <h1 class="bebas" id="heroTitle">—</h1>
                <div class="stats" id="statsRow"></div>
            </div>
        </header>
        <section class="body-sec" id="bodyContent"></section>
        <div class="cta">
            <a href="/impact"><i class="fas fa-arrow-left"></i> All impact areas</a>
        </div>
    </div>

    <footer>
        <p>&copy; 2026 Binary Hub · <a href="/our-mission">Mission</a> · <a href="/branches">Branches</a></p>
    </footer>

    <script>
        const DATA = {
            'youth-empowerment': {
                title: 'Youth Empowerment',
                heroImage: 'https://images.unsplash.com/photo-1529390079861-591de354faf5?q=80&w=2070&auto=format&fit=crop',
                stats: [
                    { n: '500+', l: 'Youth trained' },
                    { n: '40%', l: 'Scholarship seats' },
                    { n: '12', l: 'Partner schools' }
                ],
                html: `<h2 class="bebas">Building confidence early</h2>
                    <p>Our youth track combines after-school clubs, intensive holiday bootcamps, and project showcases judged by industry volunteers. We prioritize first-generation learners and provide devices where needed.</p>
                    <p>Alumni return as teaching assistants, creating a flywheel of peer mentorship. Metrics we track include course completion, portfolio submissions, and internship conversion within six months of graduation.</p>
                    <h3 class="bebas" style="font-size:1.4rem;margin-top:28px;">Highlights</h3>
                    <ul>
                        <li>Open hack nights and “debug cafés” in community centers</li>
                        <li>Micro-grants for capstone hardware and domain costs</li>
                        <li>Parent orientation sessions on digital careers</li>
                    </ul>`
            },
            'women-empowerment': {
                title: 'Women Empowerment',
                heroImage: 'https://images.unsplash.com/photo-1573497019940-1c28c88b4f3e?q=80&w=1974&auto=format&fit=crop',
                stats: [
                    { n: '60%', l: 'Women-led teams' },
                    { n: '25+', l: 'Hiring partners' },
                    { n: '8', l: 'Mentorship circles' }
                ],
                html: `<h2 class="bebas">Space to lead</h2>
                    <p>Women-only cohorts remove barriers to asking questions and claiming leadership roles in group work. We pair technical training with negotiation workshops, salary benchmarking, and interview practice.</p>
                    <p>Partner companies commit to blind résumé reviews and structured interview panels. Graduates join an active alumnae Slack for referrals and accountability.</p>
                    <h3 class="bebas" style="font-size:1.4rem;margin-top:28px;">Highlights</h3>
                    <ul>
                        <li>Return-to-work fast-tracks for caregivers</li>
                        <li>Design and dev tracks with flexible evening hours</li>
                        <li>Annual “Build in Public” demo day with press and recruiters</li>
                    </ul>`
            },
            'tourist-promotion': {
                title: 'Tourist Promotion',
                heroImage: 'https://images.unsplash.com/photo-1469854523086-cc02fe5d8800?q=80&w=2021&auto=format&fit=crop',
                stats: [
                    { n: '30+', l: 'Campaign assets' },
                    { n: '5', l: 'Regional collabs' },
                    { n: '100K', l: 'Reach (est.)' }
                ],
                html: `<h2 class="bebas">Story-first destinations</h2>
                    <p>Learners collaborate with cultural boards and small businesses to produce ethical tourism content: short films, accessible websites, and multilingual social kits that respect local narratives.</p>
                    <p>Projects emphasize low-impact travel tips, seasonal crowd management, and elevating artisans through e-commerce microsites built in Binary Hub studios.</p>
                    <h3 class="bebas" style="font-size:1.4rem;margin-top:28px;">Highlights</h3>
                    <ul>
                        <li>Photo walks with guidelines on consent and attribution</li>
                        <li>Map UX audits for visitor centers</li>
                        <li>Student-made AR explainers for heritage sites (pilot)</li>
                    </ul>`
            },
            'vocational-center': {
                title: 'Vocational Center',
                heroImage: 'https://images.unsplash.com/photo-1513258496099-48168024adb0?q=80&w=2070&auto=format&fit=crop',
                stats: [
                    { n: '15', l: 'Trade modules' },
                    { n: '200+', l: 'Certifications' },
                    { n: '90%', l: 'Placement rate' }
                ],
                html: `<h2 class="bebas">Skills that hire tomorrow</h2>
                    <p>The vocational center bridges traditional trades and modern tools: CNC basics with CAD, electrical safety with smart-home wiring, and hospitality with POS systems. Employers co-design assessment rubrics.</p>
                    <p>Trainees clock supervised hours on real job sites through insured partnerships. Tool libraries and transport stipends reduce dropout risk.</p>
                    <h3 class="bebas" style="font-size:1.4rem;margin-top:28px;">Highlights</h3>
                    <ul>
                        <li>OSHA-aligned safety modules</li>
                        <li>Mobile repair and solar maintenance labs</li>
                        <li>Soft skills clinic: invoices, clients, and time tracking</li>
                    </ul>`
            }
        };

        function render() {
            const id = new URLSearchParams(location.search).get('id') || '';
            const d = DATA[id];
            const nf = document.getElementById('nf');
            const root = document.getElementById('root');
            if (!d) {
                document.title = 'Not found | Binary Hub';
                nf.classList.add('visible');
                root.classList.remove('visible');
                return;
            }
            document.title = d.title + ' | Binary Hub Impact';
            nf.classList.remove('visible');
            root.classList.add('visible');
            document.getElementById('bcTitle').textContent = d.title;
            document.getElementById('heroTitle').textContent = d.title;
            const bg = document.getElementById('heroBg');
            bg.style.backgroundImage = `url('${d.heroImage}')`;
            document.getElementById('statsRow').innerHTML = d.stats.map(s => `<div class="stat"><strong>${s.n}</strong><span style="font-size:0.8rem;color:#94a3b8;">${s.l}</span></div>`).join('');
            document.getElementById('bodyContent').innerHTML = d.html;
        }

        window.addEventListener('load', () => {
            render();
            setTimeout(() => {
                const l = document.getElementById('loader');
                if (l) { l.style.opacity = '0'; setTimeout(() => { l.style.display = 'none'; }, 500); }
            }, 350);
        });

        
        const navbar = document.getElementById('navbar'), sp = document.getElementById('scroll-progress');
        window.addEventListener('scroll', () => {
            const ws = document.body.scrollTop || document.documentElement.scrollTop;
            const h = document.documentElement.scrollHeight - document.documentElement.clientHeight;
            sp.style.width = (ws / h) * 100 + '%';
            if (ws > 40) navbar.classList.add('scrolled'); else navbar.classList.remove('scrolled');
        });
        const mt = document.getElementById('mobileToggle'), nl = document.querySelector('.nav-links');
        if (mt) mt.addEventListener('click', (e) => {
            e.stopPropagation();
            nl.classList.toggle('active');
            const i = mt.querySelector('i');
            if (nl.classList.contains('active')) i.classList.replace('fa-bars', 'fa-times');
            else i.classList.replace('fa-times', 'fa-bars');
        });
    </script>
</body>
</html>
