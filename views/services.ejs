<%
  pageTitle = 'Services';
  pageDescription = 'Creative and technical services from Binary Hub: web, AI, design, video, and more.';
  activeNav = 'services';
  extraCss = '<link rel="stylesheet" href="/css/pages.css">';
%>
<%- include('partials/head') %>
<%- include('partials/nav') %>

<main>
  <header class="bh-page-hero">
    <div class="bh-container">
      <h1>Digital services that move work forward.</h1>
      <p class="bh-lead">From production-ready products to creative delivery and training partnerships. Explore each program outline below.</p>
      <div class="page-card-meta" style="margin-top:1.25rem;">
        <span class="page-chip page-chip-accent"><%= (typeof services !== 'undefined' && services && services.length) ? services.length : 0 %> services</span>
      </div>
    </div>
  </header>

  <section class="bh-section" style="padding-top:0;" id="catalog">
    <div class="bh-container">
      <div class="page-grid">
        <% if (typeof services !== 'undefined' && services && services.length) { services.forEach(function(s) { %>
        <a href="/services/<%= s.slug %>" class="page-card bh-reveal">
          <div class="page-card-media">
            <% if (s.image) { %>
            <img src="<%= s.image %>" alt="<%= s.name %>" loading="lazy">
            <% } else { %>
            <img src="https://picsum.photos/seed/<%= encodeURIComponent(s.slug || s.name || 'service') %>/640/400" alt="<%= s.name %>" loading="lazy">
            <% } %>
          </div>
          <div class="page-card-body">
            <h3><%= s.name %></h3>
            <p><%= s.shortDescription || '' %></p>
            <span class="page-chip page-chip-accent" style="margin-top:0.5rem;align-self:flex-start;">View outline <i class="fas fa-arrow-right" style="font-size:0.65rem;margin-left:0.35rem;"></i></span>
          </div>
        </a>
        <% }); } else { %>
        <div class="page-empty">No services are available yet. Please check back soon.</div>
        <% } %>
      </div>
    </div>
  </section>

  <%- include('partials/footer') %>
</main>
<%- include('partials/scripts') %>
