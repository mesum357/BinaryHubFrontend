<%- include('partials/auth-layout-start') %>
<div class="auth-shell">
    <div class="auth-card">
        <h1>Sign in</h1>
        <p class="auth-lead">Welcome back. Use the email and password for your Binary Hub account.</p>
        <% if (typeof errorMsg !== 'undefined' && errorMsg && errorMsg.length) { %>
        <div class="auth-flash err"><%= errorMsg[0] %></div>
        <% } %>
        <% if (typeof successMsg !== 'undefined' && successMsg && successMsg.length) { %>
        <div class="auth-flash ok"><%= successMsg[0] %></div>
        <% } %>
        <form class="auth-form" method="post" action="/auth/login">
            <input type="hidden" name="next" value="<%= typeof nextUrl !== 'undefined' ? nextUrl : '' %>">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" required autocomplete="email" placeholder="you@example.com">
            <label for="password">Password</label>
            <input type="password" id="password" name="password" required autocomplete="current-password" placeholder="••••••••">
            <button type="submit" class="btn-primary">Sign in</button>
        </form>
        <p class="auth-footer"><a href="/auth/forgot-password">Forgot password?</a></p>
        <p class="auth-footer">No account? <a href="/auth/signup">Create one</a></p>
    </div>
</div>
<%- include('partials/auth-layout-end') %>
