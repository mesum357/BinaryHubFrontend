<%
  pageTitle = 'Not found';
  pageDescription = 'The page you requested could not be found.';
  activeNav = '';
  extraCss = '<link rel="stylesheet" href="/css/pages.css">';
%>
<%- include('partials/head') %>
<%- include('partials/nav') %>

<main>
  <header class="bh-page-hero">
    <div class="bh-container" style="text-align:center;max-width:36rem;margin-inline:auto;">
      <p class="bh-eyebrow">Error 404</p>
      <h1 style="max-width:none;">Page not found</h1>
      <p class="bh-lead" style="margin-inline:auto;"><%= typeof message !== 'undefined' && message ? message : 'Page not found' %></p>
      <div style="margin-top:1.75rem;display:flex;gap:0.75rem;justify-content:center;flex-wrap:wrap;">
        <a href="/" class="bh-btn bh-btn-primary">Back to home</a>
        <a href="/courses" class="bh-btn bh-btn-secondary">Browse courses</a>
      </div>
    </div>
  </header>

  <%- include('partials/footer') %>
</main>
<%- include('partials/scripts') %>
