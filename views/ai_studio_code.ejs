<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Binary Hub | Empowering the Next Generation</title>
    
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@300;400;600&family=Space+Grotesk:wght@500;700&display=swap" rel="stylesheet">
    
    <!-- Font Awesome for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/site-nav-user.css">

    <style>
        :root {
            --primary-orange: #ee702b;
            --primary-blue: #005696;
            --white: #ffffff;
            --dark-bg: #050b16;
            --deep-bg: #03070d;
            --light-gray: #1a1f2e;
            --text-main: #e0e6ed;
            --text-dim: #a0aec0;
            --glass: rgba(255, 255, 255, 0.05);
            --glass-dark: rgba(0, 0, 0, 0.4);
            --header-font: 'Space Grotesk', sans-serif;
            --body-font: 'Inter', sans-serif;
            --display-font: 'Bebas Neue', sans-serif;
            --transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
        }

        /* Global Reset */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: var(--body-font);
            background: linear-gradient(135deg, var(--deep-bg), var(--dark-bg));
            color: var(--text-main);
            overflow-x: hidden;
            line-height: 1.6;
            min-height: 100vh;
        }

        /* Grain Texture */
        .noise-overlay {
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            pointer-events: none;
            z-index: 9999;
            opacity: 0.03;
            background: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
        }

        /* Scroll Progress Bar */
        .scroll-progress {
            position: fixed;
            top: 0; left: 0; width: 0%; height: 4px;
            background: var(--primary-orange);
            z-index: 10001;
        }

        /* Loading Screen */
        #loader {
            position: fixed;
            inset: 0;
            background: var(--dark-bg);
            z-index: 10002;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            transition: opacity 0.8s ease;
        }

        .loader-logo {
            width: 200px;
            opacity: 0;
            transform: scale(0.8);
            animation: logo-pop 1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }

        .loader-logo img {
            width: 100%;
            height: auto;
        }

        @keyframes logo-pop {
            to { opacity: 1; transform: scale(1); }
        }

        /* Typography Helpers */
        h1, h2, h3 { font-family: var(--header-font); }
        .gradient-text {
            background: linear-gradient(90deg, var(--primary-orange), var(--primary-blue));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .section-padding { padding: 100px 10%; }

        /* Animation Reveal */
        .reveal {
            opacity: 0;
            transform: translateY(40px);
            transition: 1s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .reveal.active {
            opacity: 1;
            transform: translateY(0);
        }

        /* Navigation */
        nav {
            position: fixed;
            top: 0; width: 100%;
            padding: 20px 10%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            z-index: 1000;
            transition: var(--transition);
        }

        nav.scrolled {
            background: rgba(5, 11, 22, 0.85);
            backdrop-filter: blur(20px);
            padding: 15px 10%;
            border-bottom: 1px solid rgba(255,255,255,0.05);
        }

        .logo {
            display: flex;
            align-items: center;
            height: 50px;
            transition: var(--transition);
        }

        .logo img {
            height: 100%;
            width: auto;
            object-fit: contain;
        }

        nav.scrolled .logo {
            height: 40px;
        }

        .nav-links {
            display: flex;
            gap: 30px;
            list-style: none;
        }

        .nav-links li { position: relative; }

        .nav-links a {
            text-decoration: none;
            color: white; /* Default state */
            font-weight: 600;
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            padding-bottom: 5px;
            transition: color 0.3s;
        }

        nav.scrolled .nav-links a {
            color: white; /* Keep white even when scrolled on dark theme */
            opacity: 0.8;
        }

        nav.scrolled .nav-links a:hover {
            opacity: 1;
        }

        .nav-links a::after {
            content: '';
            position: absolute;
            bottom: -2px; left: 0;
            width: 0%; height: 2px;
            background: var(--primary-orange);
            transition: 0.3s ease;
        }

        .nav-links a:hover::after, .nav-links a.active-link::after {
            width: 100%;
        }

        .mobile-toggle {
            display: none;
            font-size: 1.5rem;
            cursor: pointer;
            color: white; /* Default state */
            z-index: 1001;
            transition: color 0.3s;
        }

        nav.scrolled .mobile-toggle {
            color: white; /* Keep white even when scrolled */
        }

        /* Dropdown */
        .dropdown { position: relative; }
        .dropdown-menu {
            position: absolute;
            top: 100%; left: 0;
            background: rgba(255,255,255,0.95);
            backdrop-filter: blur(10px);
            min-width: 200px;
            padding: 15px;
            border-radius: 10px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
            opacity: 0; visibility: hidden;
            transform: translateY(20px);
            transition: var(--transition);
        }

        .dropdown:hover .dropdown-menu {
            opacity: 1; visibility: visible;
            transform: translateY(0);
        }

        .dropdown-menu a {
            display: block;
            padding: 8px 0;
            color: #555 !important; /* Ensure dropdown items stay visible on white bg */
            font-size: 0.85rem;
        }

        .dropdown-menu a:hover { color: var(--primary-orange); padding-left: 5px; }

        /* Hero Slider */
        .hero {
            height: 100vh;
            position: relative;
            overflow: hidden;
        }

        .slide {
            position: absolute;
            inset: 0;
            opacity: 0;
            transition: opacity 1s ease-in-out;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            color: white;
        }

        .slide.active { opacity: 1; }

        .slide-bg {
            position: absolute;
            inset: 0;
            background-size: cover;
            background-position: center;
            transform: scale(1.1);
            transition: transform 6s ease;
            z-index: -1;
        }

        .slide.active .slide-bg { transform: scale(1); }

        .slide-overlay {
            position: absolute;
            inset: 0;
            background: linear-gradient(to right, rgba(0,86,150,0.7), rgba(238,112,43,0.5));
            z-index: 0;
        }

        .hero-content {
            position: relative;
            z-index: 1;
            max-width: 900px;
            padding: 0 20px;
        }

        .hero-eyebrow { font-size: 1.2rem; text-transform: uppercase; letter-spacing: 4px; margin-bottom: 20px; opacity: 0; }
        .hero-title { font-family: var(--display-font); font-size: 8vw; line-height: 0.9; margin-bottom: 20px; }
        .hero-subtext { font-size: 1.2rem; margin-bottom: 30px; opacity: 0; }

        .active .hero-eyebrow { animation: fadeUp 0.8s forwards 0.3s; }
        .active .hero-subtext { animation: fadeUp 0.8s forwards 0.7s; }

        @keyframes fadeUp {
            from { opacity: 0; transform: translateY(30px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .btn {
            padding: 15px 40px;
            border-radius: 50px;
            text-decoration: none;
            font-weight: bold;
            display: inline-block;
            transition: 0.3s;
            border: none;
            font-family: var(--header-font);
        }

        .btn-primary {
            background: var(--primary-orange);
            color: white;
            box-shadow: 0 10px 20px rgba(238,112,43,0.3);
        }

        .btn-primary:hover {
            transform: scale(1.05);
            background: var(--primary-blue);
        }

        /* Founder Section */
        .founder-section {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 50px;
            position: relative;
        }

        .founder-card {
            flex: 1;
            min-width: 300px;
            position: relative;
        }

        .founder-img-wrapper {
            width: 400px; height: 400px;
            border-radius: 50%;
            margin: 0 auto;
            position: relative;
            padding: 10px;
            border: 2px dashed #eee;
        }

        .founder-img-wrapper::before {
            content: '';
            position: absolute;
            inset: -5px;
            border-radius: 50%;
            border: 5px solid transparent;
            border-top-color: var(--primary-orange);
            border-bottom-color: var(--primary-blue);
            animation: spin 10s linear infinite;
        }

        @keyframes spin { to { transform: rotate(360deg); } }

        .founder-img {
            width: 100%; height: 100%;
            border-radius: 50%;
            object-fit: cover;
        }

        .founder-info {
            flex: 1;
            min-width: 300px;
        }

        .quote-bg {
            position: absolute;
            font-size: 15rem;
            color: rgba(238,112,43,0.1);
            top: -50px; left: -20px;
            z-index: -1;
            font-family: serif;
        }

        .pull-quote {
            background: linear-gradient(135deg, var(--primary-blue), var(--primary-orange));
            padding: 30px;
            color: white;
            border-radius: 20px;
            margin-top: 30px;
            font-style: italic;
            font-size: 1.2rem;
        }

        /* Impact Section (Orbital Layout) */
        .impact-section {
            background: radial-gradient(circle at center, #0f172a, #050b16);
            text-align: center;
            overflow: hidden;
            position: relative;
        }

        .impact-container {
            height: 800px;
            position: relative;
            margin-top: 50px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .impact-center {
            width: 250px; height: 250px;
            background: radial-gradient(circle, var(--primary-blue), var(--primary-orange));
            border-radius: 50%;
            position: absolute;
            top: 50%; left: 50%;
            transform: translate(-50%, -50%);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: bold;
            box-shadow: 0 0 70px rgba(0,86,150,0.4);
            z-index: 10;
            font-size: 1.2rem;
            transition: var(--transition);
        }

        .impact-center:hover { transform: translate(-50%, -50%) scale(1.05); }

        .orbit-item {
            width: 180px; height: 180px;
            background: var(--light-gray);
            border: 2px solid rgba(255,255,255,0.1);
            border-radius: 50%;
            position: absolute;
            top: 50%; left: 50%;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            transition: 0.5s cubic-bezier(0.16, 1, 0.3, 1);
            box-shadow: 0 15px 30px rgba(0,0,0,0.3);
            z-index: 5;
            overflow: hidden;
            color: white;
            text-shadow: 0 2px 10px rgba(0,0,0,0.5);
        }

        .orbit-item img {
            position: absolute;
            inset: 0;
            width: 100%; height: 100%;
            object-fit: cover;
            z-index: -1;
            transition: transform 0.5s ease;
        }

        .orbit-item::after {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(to bottom, rgba(0,0,0,0.1), rgba(0,86,150,0.6));
            z-index: -1;
        }

        .orbit-item:hover img {
            transform: scale(1.1);
        }

        .orbit-item i { font-size: 2rem; margin-bottom: 10px; color: white; filter: drop-shadow(0 2px 5px rgba(0,0,0,0.3)); }
        .orbit-item span { font-size: 0.85rem; font-weight: bold; text-transform: uppercase; letter-spacing: 1px; }

        /* Services Grid */
        .services-section {
            background: var(--dark-bg);
            color: white;
        }

        .service-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 30px;
            margin-top: 50px;
        }

        .service-card {
            height: 320px;
            perspective: 1000px;
        }

        .card-inner {
            position: relative;
            width: 100%; height: 100%;
            transition: transform 0.8s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            transform-style: preserve-3d;
        }

        .service-card:hover .card-inner { transform: rotateY(180deg); }

        .card-face {
            position: absolute;
            width: 100%; height: 100%;
            backface-visibility: hidden;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 30px;
            border-radius: 20px;
            border: 1px solid rgba(255,255,255,0.1);
            background: #111;
        }

        .card-back {
            background: linear-gradient(135deg, var(--primary-orange), var(--primary-blue));
            transform: rotateY(180deg);
            text-align: center;
        }

        .service-icon {
            font-size: 3rem;
            margin-bottom: 20px;
            color: var(--primary-orange);
        }

        /* Blog Section */
        .blog-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 30px;
            margin-top: 50px;
        }

        .blog-card {
            background: var(--light-gray);
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 15px 40px rgba(0,0,0,0.2);
            transition: 0.4s;
            border: 1px solid rgba(255,255,255,0.05);
        }

        .blog-card:hover { transform: translateY(-10px); }

        .blog-img {
            width: 100%; height: 200px;
            background: #eee;
            background-size: cover;
            background-position: center;
        }

        .blog-content { padding: 25px; }

        /* Footer */
        footer {
            background: #050b16;
            color: white;
            padding: 80px 10% 30px;
        }

        .footer-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 50px;
            margin-bottom: 50px;
        }

        .footer-col h4 {
            margin-bottom: 25px;
            font-size: 1.2rem;
            color: var(--primary-orange);
        }

        .footer-col ul { list-style: none; }
        .footer-col ul li { margin-bottom: 12px; }
        .footer-col a { color: #aaa; text-decoration: none; transition: 0.3s; }
        .footer-col a:hover { color: white; padding-left: 5px; }

        .social-icons { display: flex; gap: 15px; margin-top: 20px; }
        .social-icons a:hover { background: var(--primary-orange); transform: translateY(-5px); }

        .linkedin-btn {
            background: #0077b5 !important;
            color: white !important;
            width: auto !important;
            padding: 10px 25px !important;
            border-radius: 50px !important;
            display: flex !important;
            align-items: center;
            gap: 10px;
            font-size: 0.9rem;
            font-weight: 600;
            text-decoration: none;
            transition: 0.3s;
            box-shadow: 0 10px 20px rgba(0,119,181,0.2);
        }

        .linkedin-btn:hover {
            transform: translateY(-5px) scale(1.05);
            box-shadow: 0 15px 30px rgba(0,119,181,0.3);
            background: #005a8a !important;
        }

        /* Scroll to Top */
        #backToTop {
            position: fixed;
            bottom: 30px; right: 30px;
            width: 50px; height: 50px;
            background: var(--primary-orange);
            color: white;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            opacity: 0;
            visibility: hidden;
            transition: 0.3s;
            z-index: 999;
            box-shadow: 0 5px 15px rgba(238,112,43,0.4);
        }

        #backToTop.show { opacity: 1; visibility: visible; }

        /* Responsive */
        @media (max-width: 768px) {
            .hero-title { font-size: 3rem; }
            
            .mobile-toggle { display: block; }
            
            .nav-links {
                position: fixed;
                top: 0; right: -100%;
                width: 70%; height: 100vh;
                background: rgba(5, 11, 22, 0.98);
                backdrop-filter: blur(20px);
                flex-direction: column;
                justify-content: center;
                align-items: center;
                gap: 20px;
                transition: 0.5s ease-in-out;
                display: flex; /* Override display:none */
                box-shadow: -10px 0 30px rgba(0,0,0,0.3);
            }

            .nav-links.active { right: 0; }
            
            .nav-links li { width: 100%; text-align: center; }
            .nav-links a { font-size: 1.2rem; display: block; width: 100%; }

            .dropdown-menu {
                position: static;
                opacity: 1;
                visibility: visible;
                display: none;
                transform: none;
                background: rgba(255,255,255,0.03);
                box-shadow: none;
                margin-top: 10px;
                width: 100%;
            }

            .dropdown.open .dropdown-menu {
                display: block;
            }
            
            .dropdown.open > a i {
                transform: rotate(180deg);
            }

            .impact-container { 
                height: auto; 
                display: grid;
                grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
                gap: 20px;
                padding: 40px 0;
            }

            .impact-center { 
                position: relative; 
                top: 0; left: 0; 
                transform: none; 
                margin: 0 auto 30px;
                width: 150px; height: 150px;
            }

            .orbit-item { 
                position: relative !important; 
                top: 0 !important; left: 0 !important; 
                transform: none !important; 
                width: 100%; 
                height: auto; 
                padding: 30px 15px; 
                border-radius: 20px;
            }

            .orbit-item:hover { transform: translateY(-10px) !important; }
            
            .founder-img-wrapper { width: 280px; height: 280px; }
            .section-padding { padding: 60px 5%; }
        }

        @media (min-width: 769px) and (max-width: 1024px) {
            .impact-container { height: 750px; }
            .impact-center { width: 220px; height: 220px; font-size: 1.1rem; }
            .orbit-item { width: 150px; height: 150px; }
        }
    </style>
</head>
<body>

    <!-- Loading Screen -->
    <div id="loader">
        <div class="loader-logo">
            <img src="/images/logo-binary.png" alt="Binary Hub Logo">
        </div>
    </div>

    <div class="noise-overlay"></div>
    <div class="scroll-progress" id="progressBar"></div>

    <!-- Navigation -->
    <nav id="navbar">
        <a href="/" class="logo">
            <img src="/images/logo-binary.png" alt="Binary Hub Logo">
        </a>
        <ul class="nav-links">
            <li><a href="/" class="active-link">Home</a></li>
            <li class="dropdown">
                <a href="/our-mission">About Us <i class="fas fa-chevron-down" style="font-size: 0.6rem;"></i></a>
                <div class="dropdown-menu">
                    <a href="/team">Our Team</a>
                    <a href="/our-mission">Our Mission</a>
                    <a href="/impact">Our Impact</a>
                    <a href="/branches">Our Branches</a>
                </div>
            </li>
            <li><a href="/courses">Our Courses</a></li>
            <li class="dropdown">
                <a href="/events">Gallery <i class="fas fa-chevron-down" style="font-size: 0.6rem;"></i></a>
                <div class="dropdown-menu">
                    <a href="/events">Events</a>
                    <a href="/visits">Visits</a>
                </div>
            </li>
            <li><a href="/services">Services</a></li>
            <li><a href="/internships">Internships</a></li>
            <%- include('partials/nav-user-slot') %>
        </ul>
        <div class="mobile-toggle" id="mobileToggle"><i class="fas fa-bars"></i></div>
    </nav>
    <%- include('partials/nav-user-modals') %>

    <!-- Hero Section -->
    <section class="hero" id="home">
        <!-- Slide 1 -->
        <div class="slide active">
            <div class="slide-bg" style="background-image: linear-gradient(135deg, #03070d 0%, #0a1628 40%, #005696 100%);"></div>
            <div class="slide-overlay"></div>
            <div class="hero-content">
                <p class="hero-eyebrow">Welcome to Binary Hub</p>
                <h1 class="hero-title">SHAPING DIGITAL FUTURES</h1>
                <p class="hero-subtext">Empowering youth through technology, creativity, and innovation.</p>
                <a href="/courses" class="btn btn-primary">Explore Programs</a>
            </div>
        </div>
        <!-- Slide 2 -->
        <div class="slide">
            <div class="slide-bg" style="background-image: linear-gradient(135deg, #050b16 0%, #005696 50%, #ee702b 100%);"></div>
            <div class="slide-overlay"></div>
            <div class="hero-content">
                <p class="hero-eyebrow">Learn & Grow</p>
                <h1 class="hero-title">WORLD-CLASS COURSES</h1>
                <p class="hero-subtext">From Web Development to AI — master the skills of tomorrow.</p>
                <a href="#courses" class="btn btn-primary">View Courses</a>
            </div>
        </div>
        <!-- Slide 3 -->
        <div class="slide">
            <div class="slide-bg" style="background-image: linear-gradient(135deg, #1a1f2e 0%, #ee702b 45%, #005696 100%);"></div>
            <div class="slide-overlay"></div>
            <div class="hero-content">
                <p class="hero-eyebrow">Our Impact</p>
                <h1 class="hero-title">TRANSFORMING LIVES</h1>
                <p class="hero-subtext">Scholarships, vocational training, and community empowerment.</p>
                <a href="/our-mission" class="btn btn-primary">Our Mission</a>
            </div>
        </div>

        <div class="slider-controls" style="position:absolute; bottom:30px; left:50%; transform:translateX(-50%); z-index:10; display:flex; gap:15px;">
            <div class="dot active" onclick="setSlide(0)" style="width:12px; height:12px; background:var(--primary-orange); border-radius:50%;"></div>
            <div class="dot" onclick="setSlide(1)" style="width:12px; height:12px; background:white; border-radius:50%;"></div>
            <div class="dot" onclick="setSlide(2)" style="width:12px; height:12px; background:white; border-radius:50%;"></div>
        </div>
    </section>

    <!-- Founder Section -->
    <section class="section-padding reveal">
        <div class="founder-section">
            <div class="founder-card">
                <div class="founder-img-wrapper">
                    <img src="/images/tehseensir.jpg" alt="Tahseen Abbas" class="founder-img">
                </div>
                <div style="text-align: center; margin-top: 20px;">
                    <h3>Tahseen Abbas</h3>
                    <p style="color: var(--primary-orange);">Founder Binary Hub</p>
                    <div class="social-icons" style="justify-content: center; margin-top: 15px;">
                        <a href="#" class="linkedin-btn"><i class="fab fa-linkedin-in"></i> Follow on LinkedIn</a>
