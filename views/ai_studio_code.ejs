<%
  pageTitle = 'Home';
  pageDescription = 'Binary Hub empowers youth through technology education, professional courses, and community impact across Pakistan.';
  activeNav = 'home';
  extraCss = '<link rel="stylesheet" href="/css/home.css">';
%>
<%- include('partials/head') %>
<%- include('partials/nav') %>

<main>
  <section class="home-hero">
    <div class="bh-container home-hero-grid">
      <div>
        <p class="bh-eyebrow">For learners and builders</p>
        <h1>Put your future on a faster track.</h1>
        <p class="bh-lead">Courses, internships, and community programs under one roof so you can learn skills that lead to real work.</p>
        <div class="home-hero-actions">
          <a href="/courses" class="bh-btn bh-btn-primary">
            Explore courses
            <span class="bh-btn-icon"><i class="fas fa-arrow-right" style="font-size:0.75rem;"></i></span>
          </a>
          <a href="/our-mission" class="bh-btn bh-btn-secondary">Our mission</a>
        </div>
        <div class="home-hero-meta">
          <span class="stars" aria-hidden="true">★★★★★</span>
          <span>Trusted by students and teams across Karachi</span>
        </div>
      </div>

      <div class="home-preview bh-reveal">
        <div class="bh-bezel">
          <div class="bh-bezel-inner" style="padding:1rem; background:var(--bh-surface-2);">
            <div class="home-preview-stack">
              <div class="home-preview-card primary">
                <div class="home-preview-top">
                  <span class="home-preview-label">Enrollment overview</span>
                  <span class="home-preview-status"><i class="fas fa-circle"></i> Live</span>
                </div>
                <div class="home-preview-amount"><%= typeof enrollmentCount !== 'undefined' ? enrollmentCount : 0 %>+</div>
                <p class="home-preview-sub">Learners enrolled across Binary Hub programs</p>
                <div class="home-preview-row">
                  <span>Active courses</span>
                  <span><%= typeof courseCount !== 'undefined' ? courseCount : 0 %></span>
                </div>
                <div class="home-preview-row">
                  <span>Team mentors</span>
                  <span><%= typeof teamMemberCount !== 'undefined' ? teamMemberCount : 0 %></span>
                </div>
              </div>
              <div class="home-preview-metrics">
                <div class="home-metric">
                  <div class="val">Tech</div>
                  <div class="lbl">Web, AI, design tracks</div>
                  <span class="delta">Open now</span>
                </div>
                <div class="home-metric">
                  <div class="val">Career</div>
                  <div class="lbl">Internships &amp; placement</div>
                  <span class="delta">Apply today</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="bh-container">
    <div class="home-stats bh-reveal">
      <div class="home-stat">
        <div class="num"><%= typeof enrollmentCount !== 'undefined' ? enrollmentCount : 0 %></div>
        <div class="lbl">Enrollments</div>
      </div>
      <div class="home-stat">
        <div class="num"><%= typeof courseCount !== 'undefined' ? courseCount : 0 %></div>
        <div class="lbl">Courses live</div>
      </div>
      <div class="home-stat">
        <div class="num"><%= typeof teamMemberCount !== 'undefined' ? teamMemberCount : 0 %></div>
        <div class="lbl">Team members</div>
      </div>
    </div>
  </div>

  <section class="bh-section">
    <div class="bh-container home-split">
      <div class="home-split-visual bh-reveal">
        <img src="/images/home-skills-section.jpg" alt="Learners collaborating on a project at Binary Hub" width="960" height="720" loading="lazy">
        <div class="home-split-chip">
          <strong>Hands-on learning</strong>
          <span>Projects, mentors, and real briefs</span>
        </div>
      </div>
      <div class="bh-reveal">
        <h2 style="font-size:clamp(1.85rem,3.5vw,2.6rem); max-width:14ch;">Less busywork. More skills that stick.</h2>
        <p class="bh-lead" style="margin-top:1rem;">Binary Hub brings education, services, and opportunity into one place so learners spend less time hunting tools and more time building.</p>
        <div class="home-feature-list">
          <div class="home-feature-item">
            <div class="home-feature-icon"><i class="fas fa-graduation-cap"></i></div>
            <div>
              <h3>Career-ready courses</h3>
              <p>Structured tracks from fundamentals to advanced practice with clear outcomes.</p>
            </div>
          </div>
          <div class="home-feature-item">
            <div class="home-feature-icon"><i class="fas fa-briefcase"></i></div>
            <div>
              <h3>Internship pathways</h3>
              <p>Apply to openings that connect classroom learning to real delivery work.</p>
            </div>
          </div>
          <div class="home-feature-item">
            <div class="home-feature-icon"><i class="fas fa-users"></i></div>
            <div>
              <h3>Community impact</h3>
              <p>Scholarships, outreach, and programs that widen access to tech education.</p>
            </div>
          </div>
        </div>
        <div style="margin-top:1.75rem;">
          <a href="/courses" class="bh-btn bh-btn-primary">
            See programs
            <span class="bh-btn-icon"><i class="fas fa-arrow-right" style="font-size:0.75rem;"></i></span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="bh-section" style="background:var(--bh-surface); border-block:1px solid var(--bh-line);">
    <div class="bh-container">
      <div class="bh-reveal" style="margin-bottom:2rem; max-width:40rem;">
        <h2 style="font-size:clamp(1.85rem,3.5vw,2.6rem);">What we offer</h2>
        <p class="bh-lead" style="margin-top:0.75rem;">Services and programs built for learners, teams, and communities who need practical digital capability.</p>
      </div>

      <% const homeSvc = typeof homeServices !== 'undefined' && homeServices ? homeServices : []; %>
      <div class="home-bento">
        <a href="/services" class="home-bento-card wide bh-reveal">
          <div class="home-bento-icon"><i class="fas fa-bolt"></i></div>
          <h3>Digital services that move work forward</h3>
          <p>From product builds to training partnerships, Binary Hub helps organizations ship with clarity.</p>
          <span class="link">View all services <i class="fas fa-arrow-right" style="font-size:0.7rem;"></i></span>
        </a>

        <% if (homeSvc.length) {
          homeSvc.slice(0, 4).forEach(function(s, i) { %>
        <a href="/services/<%= s.slug %>" class="home-bento-card <%= i === 0 ? 'tint' : '' %> bh-reveal">
          <div class="home-bento-icon"><i class="fas fa-layer-group"></i></div>
          <h3><%= s.name %></h3>
          <p><%= (s.shortDescription || 'Explore this service and how we deliver it.').slice(0, 110) %><%= (s.shortDescription || '').length > 110 ? '…' : '' %></p>
          <span class="link">Details <i class="fas fa-arrow-right" style="font-size:0.7rem;"></i></span>
        </a>
        <% });
        } else { %>
        <a href="/courses" class="home-bento-card tint bh-reveal">
          <div class="home-bento-icon"><i class="fas fa-code"></i></div>
          <h3>Courses</h3>
          <p>Browse live programs across development, design, and digital skills.</p>
          <span class="link">Browse <i class="fas fa-arrow-right" style="font-size:0.7rem;"></i></span>
        </a>
        <a href="/internships" class="home-bento-card bh-reveal">
          <div class="home-bento-icon"><i class="fas fa-user-check"></i></div>
          <h3>Internships</h3>
          <p>Find openings and apply with a clear, guided process.</p>
          <span class="link">Apply <i class="fas fa-arrow-right" style="font-size:0.7rem;"></i></span>
        </a>
        <a href="/impact" class="home-bento-card bh-reveal">
          <div class="home-bento-icon"><i class="fas fa-heart"></i></div>
          <h3>Impact</h3>
          <p>See how Binary Hub expands access to opportunity across communities.</p>
          <span class="link">Learn more <i class="fas fa-arrow-right" style="font-size:0.7rem;"></i></span>
        </a>
        <a href="/events" class="home-bento-card bh-reveal">
          <div class="home-bento-icon"><i class="fas fa-calendar"></i></div>
          <h3>Events</h3>
          <p>Workshops, meetups, and moments from the Binary Hub community.</p>
          <span class="link">Gallery <i class="fas fa-arrow-right" style="font-size:0.7rem;"></i></span>
        </a>
        <% } %>
      </div>
    </div>
  </section>

  <section class="bh-section">
    <div class="bh-container home-founder">
      <div class="bh-bezel bh-reveal">
        <div class="bh-bezel-inner">
          <div class="home-founder-photo">
            <img src="/images/tehseensir.jpg" alt="Tahseen Abbas, Founder of Binary Hub" width="640" height="800" loading="lazy">
          </div>
        </div>
      </div>
      <div class="bh-reveal">
        <h2 style="font-size:clamp(1.85rem,3.5vw,2.6rem); max-width:14ch;">A message from our founder</h2>
        <p class="bh-lead" style="margin-top:1rem;">At Binary Hub, technology is the equalizer. We bridge the digital divide with education that is rigorous, practical, and open to more people.</p>
        <blockquote>“The future is not something we enter. It is something we create through code, craft, and community.”</blockquote>
        <div class="home-founder-meta">
          <div>
            <strong>Tahseen Abbas</strong>
            <span>Founder, Binary Hub</span>
          </div>
          <a href="/our-mission" class="bh-btn bh-btn-secondary" style="min-height:42px; padding:0.45rem 1.1rem;">Read our mission</a>
        </div>
      </div>
    </div>
  </section>

  <section class="bh-section" style="padding-top:0;">
    <div class="bh-container">
      <div class="bh-reveal" style="margin-bottom:1.75rem;">
        <h2 style="font-size:clamp(1.85rem,3.5vw,2.4rem);">Learners feel the difference</h2>
      </div>
      <div class="home-quotes">
        <article class="home-quote bh-reveal">
          <p>“I used to chase updates across WhatsApp groups. Binary Hub made the path clear: course, project, internship.”</p>
          <footer>
            <strong>Ayesha R.</strong>
            <span>Web development graduate</span>
          </footer>
        </article>
        <article class="home-quote bh-reveal">
          <p>“The mentors treat you like a teammate. You leave with work you can show, not just notes you forget.”</p>
          <footer>
            <strong>Hamza K.</strong>
            <span>Internship alumni</span>
          </footer>
        </article>
        <article class="home-quote bh-reveal">
          <p>“Within weeks I could see progress. Tasks were clearer, deadlines held, and I finally had a portfolio.”</p>
          <footer>
            <strong>Sana M.</strong>
            <span>Design track student</span>
          </footer>
        </article>
      </div>
    </div>
  </section>

  <%- include('partials/footer') %>
</main>

<%- include('partials/scripts') %>
