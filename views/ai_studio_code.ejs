    <a href="#" id="backToTop"><i class="fas fa-arrow-up"></i></a>

    <script>
        // Loader
        window.addEventListener('load', () => {
            setTimeout(() => {
                document.getElementById('loader').style.opacity = '0';
                setTimeout(() => {
                    document.getElementById('loader').style.display = 'none';
                }, 800);
            }, 1500); // Reduced delay for better UX
        });

        // Sticky Navbar & Scroll Progress
        const navbar = document.getElementById('navbar');
        const progressBar = document.getElementById('progressBar');
        const btt = document.getElementById('backToTop');

        window.addEventListener('scroll', () => {
            const winScroll = document.body.scrollTop || document.documentElement.scrollTop;
            const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
            const scrolled = (winScroll / height) * 100;
            progressBar.style.width = scrolled + "%";

            if (winScroll > 50) {
                navbar.classList.add('scrolled');
            } else {
                navbar.classList.remove('scrolled');
            }

            if (winScroll > 300) {
                btt.classList.add('show');
            } else {
                btt.classList.remove('show');
            }
        });

        // Hero Slider Logic
        let currentSlide = 0;
        const slides = document.querySelectorAll('.slide');
        const dots = document.querySelectorAll('.dot');

        function setSlide(n) {
            slides[currentSlide].classList.remove('active');
            dots[currentSlide].classList.remove('active');
            dots[currentSlide].style.background = 'white';
            
            currentSlide = n;
            
            slides[currentSlide].classList.add('active');
            dots[currentSlide].classList.add('active');
            dots[currentSlide].style.background = 'var(--primary-orange)';
        }

        setInterval(() => {
            let next = (currentSlide + 1) % slides.length;
            setSlide(next);
        }, 5000);

        // Orbital Layout Positioning with Rotation
        let orbitRotation = 0;
        const orbitLinesContainer = document.getElementById('orbit-lines');
        
        // Initialize SVG lines
        function initOrbitLines() {
            const orbitItems = document.querySelectorAll('.orbit-item');
            orbitLinesContainer.innerHTML = '';
            orbitItems.forEach(() => {
                const line = document.createElementNS("http://www.w3.org/2000/svg", "line");
                line.setAttribute("stroke", "rgba(238, 112, 43, 0.3)");
                line.setAttribute("stroke-width", "1");
                line.setAttribute("stroke-dasharray", "4,4");
                orbitLinesContainer.appendChild(line);
            });
        }

        function positionOrbits() {
            const orbitItems = document.querySelectorAll('.orbit-item');
            const lines = orbitLinesContainer.querySelectorAll('line');
            const width = window.innerWidth;
            const centerX = orbitLinesContainer.clientWidth / 2;
            const centerY = orbitLinesContainer.clientHeight / 2;
            let radius = 0;

            if (width > 768) {
                radius = width > 1024 ? 350 : 280;
                orbitItems.forEach((item, i) => {
                    const angle = (i * 60 + orbitRotation) * (Math.PI / 180);
                    const x = Math.cos(angle) * radius;
                    const y = Math.sin(angle) * radius;
                    
                    // Position item
                    item.style.transform = `translate(calc(-50% + ${x}px), calc(-50% + ${y}px))`;
                    item.style.display = 'flex';

                    // Position line
                    if (lines[i]) {
                        lines[i].setAttribute("x1", centerX);
                        lines[i].setAttribute("y1", centerY);
                        lines[i].setAttribute("x2", centerX + x);
                        lines[i].setAttribute("y2", centerY + y);
                        lines[i].style.opacity = "1";
                    }
                });
            } else {
                orbitItems.forEach((item, i) => {
                    item.style.transform = 'none';
                    if (lines[i]) lines[i].style.opacity = "0";
                });
            }
        }

        initOrbitLines();
        
        function animateOrbit() {
            orbitRotation += 0.15;
            positionOrbits();
            requestAnimationFrame(animateOrbit);
        }

        animateOrbit();
        window.addEventListener('resize', () => {
            initOrbitLines();
            positionOrbits();
        });

        // Mobile Menu Toggle
        const mobileToggle = document.getElementById('mobileToggle');
        const navLinks = document.querySelector('.nav-links');

        mobileToggle.addEventListener('click', (e) => {
            e.stopPropagation();
            navLinks.classList.toggle('active');
            const icon = mobileToggle.querySelector('i');
            if (navLinks.classList.contains('active')) {
                icon.classList.replace('fa-bars', 'fa-times');
            } else {
                icon.classList.replace('fa-times', 'fa-bars');
            }
        });

        // Dropdown toggle on mobile
        document.querySelectorAll('.dropdown > a').forEach(dropdownToggle => {
            dropdownToggle.addEventListener('click', (e) => {
                if (window.innerWidth <= 768) {
                    e.preventDefault();
                    e.stopPropagation();
                    const parent = dropdownToggle.parentElement;
                    parent.classList.toggle('open');
                }
            });
        });

        // Close menu on link click
        document.querySelectorAll('.nav-links a:not(.dropdown > a)').forEach(link => {
            link.addEventListener('click', () => {
                navLinks.classList.remove('active');
                mobileToggle.querySelector('i').classList.replace('fa-times', 'fa-bars');
                document.querySelectorAll('.dropdown').forEach(d => d.classList.remove('open'));
            });
        });

        // Close on outside click
        document.addEventListener('click', (e) => {
            if (!navLinks.contains(e.target) && !mobileToggle.contains(e.target)) {
                navLinks.classList.remove('active');
                mobileToggle.querySelector('i').classList.replace('fa-times', 'fa-bars');
            }
        });

        // Intersection Observer for Reveal
        const observerOptions = { threshold: 0.15 };
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('active');
                }
            });
        }, observerOptions);

        document.querySelectorAll('.reveal').forEach(el => observer.observe(el));


    </script>
</body>
</html>